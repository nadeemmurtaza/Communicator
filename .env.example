# ============================================================
# Communicator — Environment Configuration Template
# ============================================================
# Copy to .env and fill in the real values.
# ============================================================

# ------------------------------------------------------------------
# 1. Communicator Database (PostgreSQL)
# ------------------------------------------------------------------
# The Rust backend reads RUST_DATABASE_URL first, then falls back to DATABASE_URL.
# Both databases (Communicator + nID) run on the same PostgreSQL server but use
# separate databases: 'communicator' and 'nid'.
RUST_DATABASE_URL=postgresql://communicator_app:C0mm@nicat0r!2026#Secure@localhost:5432/communicator
DATABASE_URL=postgresql://communicator_app:C0mm@nicat0r!2026#Secure@localhost:5432/communicator

# ------------------------------------------------------------------
# 2. nID Identity Provider (Sign In + Sign Up)
# ------------------------------------------------------------------
# nID is the single identity provider for the NEWAX ecosystem.
# It handles: login, sign-up (phone + OTP), OAuth sessions, and secrets vault.
#
# nID runs on port 4000 by default. After running `npx prisma db seed` in the
# nID repo (C:\Users\nommi\Downloads\scraper\nID), the seed script prints the
# Communicator OAuth client credentials — paste them below.
#
# Sign In flow:  GET  /api/v1/auth/nid/start  →  GET /api/v1/auth/nid/callback
# Sign Up flow:  POST /api/v1/auth/sign-up/start  →  POST /api/v1/auth/sign-up/verify
# Profile:       GET  /api/v1/auth/me  (requires Bearer token)
#
NID_BASE_URL=http://localhost:4000
NID_CLIENT_ID=
NID_CLIENT_SECRET=
NID_REDIRECT_URI=http://localhost:8000/api/v1/auth/nid/callback

# nID Vault (secrets management — optional for Phase 0)
NID_VAULT_ADDR=http://localhost:4000
NID_VAULT_TOKEN=
NID_VAULT_ROLE_ID=
NID_VAULT_SECRET_ID=

# Set to "true" ONLY for local development without a running nID instance.
# In production this MUST be absent or "false" so real auth is enforced.
# NID_ALLOW_MOCK_AUTH=false

# ------------------------------------------------------------------
# 3. Server
# ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
APP_ENV=development
FRONTEND_DIST=frontend/dist
DEFAULT_TENANT_KEY=newax
PUBLIC_URL=

# ------------------------------------------------------------------
# 4. Meta WhatsApp Cloud API (Production Channel)
# ------------------------------------------------------------------
# Get these from Meta for Business Dashboard:
#   https://business.facebook.com/settings/
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_REDIRECT_URI=

# ------------------------------------------------------------------
# 5. Twilio (SMS + WhatsApp alternative)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ------------------------------------------------------------------
