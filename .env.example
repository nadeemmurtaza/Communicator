# Core database (Communicator owns its own DB -- separate from Harvester's)
DATABASE_URL=postgresql+asyncpg://postgres:development-only@localhost:5432/communicator
TEST_DATABASE_URL=postgresql+asyncpg://communicator_test:TEST_PASSWORD@127.0.0.1:5432/communicator_test

# Harvester integration (Communicator talks to Harvester only over this API --
# see docs/ARCHITECTURE.md and harvester/docs/communicator-integration.md)
HARVESTER_API_BASE_URL=http://localhost:8000/api/v1
HARVESTER_API_TOKEN=

# Reply drafting (Claude)
ANTHROPIC_API_KEY=

# SMS + WhatsApp (Twilio, per the architecture doc's default channel choice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# WhatsApp provider: "twilio" (default, above) or "meta" (direct Cloud API,
# ported from the standalone reply/ bot -- set these if you switch to it)
WHATSAPP_PROVIDER=twilio
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Email (Postmark, per the architecture doc's default channel choice)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Development
DEV_AUTH_ENABLED=true
