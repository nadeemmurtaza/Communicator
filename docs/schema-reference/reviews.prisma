// Phase 7 WO-7.5 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// A review is moderated by default (PENDING) — an unmoderated review form is
// a spam target within days. `orderItemId` is set only when the reviewer
// actually bought this exact line, which is what lets the storefront show
// "Verified purchase" instead of trusting a self-reported claim.
//
// `fitFeedback` is the apparel-pack hook: cheap to collect now, and it is
// what makes Phase 9's size recommendation possible later — collected here,
// in core (every sector's products can be reviewed), read only by the
// apparel pack's own future size-recommendation code, never the other way
// round.

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  userId    String?

  /// Set when the reviewer actually bought it — display "Verified purchase".
  /// Unique: one review per purchased line, not one review per product per
  /// order (a multi-line order could otherwise review the same product
  /// twice by picking a different line each time).
  orderItemId String? @unique

  rating Int // 1-5
  title  String?
  body   String?

  photoUrls String[]     @default([])
  status    ReviewStatus @default(PENDING)

  /// "too_small" | "true_to_size" | "too_large" — free text, not an enum, so
  /// a future sector's own vocabulary never needs a migration to add a value.
  fitFeedback String?

  helpfulCount Int     @default(0)
  staffReply   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([userId])
}

/// WO-9.9 (09-ai-layer.md). One row per product, regenerated by
/// ReviewSummaryService when PUBLISHED review count crosses the next
/// multiple of a threshold Setting — a `VariantSalesStat`-style cache, never
/// computed at read time. `fitSignal` feeds WO-9.2's size recommendation as
/// a corroborating input alongside the raw fitFeedback aggregation.
model ProductReviewSummary {
  productId               String   @id
  summaryText             String
  /// House Rule 1 — this line is shown on the storefront to any visitor,
  /// same as every other customer-facing string, so it is generated in both
  /// languages in the one AI call rather than shipped English-only. Null
  /// only if that generation failed while `summaryText` itself succeeded;
  /// the storefront falls back to English rather than showing nothing.
  summaryTextUr           String?
  fitSignal               String?
  qualitySignal           String?
  commonComplaints        Json?
  reviewCountAtGeneration Int
  generatedAt             DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
