// The `accounting` module (RETAIL-ERP.md R15, Part 5, WO-19.1) — a
// double-entry general ledger that posts from domain events. Off by default
// (modules.registry.ts): nothing here runs, and nothing else in the app
// imports it — R15's own "accounting couples to nothing", verified by the
// module boundary checker the same way every other pack is.
//
// "Without double entry, profit is an opinion." Expenses, salaries, losses,
// revenue and COGS become a query over JournalLine, the same way
// StockMovement already makes "why is stock 4" answerable — money gets the
// identical discipline. Three invariants are enforced by the database
// itself, not merely intended by the application: a posted entry balances
// (checked by a deferred constraint trigger — see the migration), a posted
// entry is immutable (checked by a trigger that permits exactly one
// transition, POSTED -> REVERSED, and nothing else), and nothing posts into
// a LOCKED (or CLOSED) period — AccountingService.resolveOpenPeriod() only
// ever considers `status: 'OPEN'` periods, so a late fact reroutes to
// whatever period is open today instead (R15) rather than failing or
// reaching a closed one (WO-19.5).

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// The chart of accounts. Policy — replicates down (R2), never posted to
/// directly by a branch. `isControl` marks an account a human never posts
/// to by hand (AR, AP) — only posting rules (posting-rules.subscriber.ts,
/// WO-19.2) write it. The six accounts posting rules actually use today are
/// seeded in prisma/seed.ts from chart-of-accounts.ts's ACCOUNT_CODE map.
model Account {
  id             String      @id @default(cuid())
  /// "1000", "4000" — the chart-of-accounts code a bookkeeper already knows.
  code           String      @unique
  name           String
  type           AccountType
  parentId       String?
  isIntercompany Boolean     @default(false)
  isBank         Boolean     @default(false)
  isControl      Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  parent   Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[]     @relation("AccountHierarchy")
  lines    JournalLine[]

  @@index([type])
  @@index([parentId])
}

/// A trading year. Exists mostly to own `FiscalPeriod` rows — nothing posts
/// to a `FiscalYear` directly.
model FiscalYear {
  id       String   @id @default(cuid())
  /// "FY2026" — the journal number's own year segment (R18), not
  /// necessarily calendar-aligned.
  name     String   @unique
  startsOn DateTime
  endsOn   DateTime

  /// Set once by `FiscalPeriodsService.closeFiscalYear()` (WO-19.5) — the
  /// year-end closing entry that zeros INCOME/EXPENSE into Retained Earnings
  /// has posted, and the year can never be closed a second time. Every
  /// period within it must already be CLOSED or LOCKED before this is set;
  /// this field itself is never cleared — a mistaken close is fixed with a
  /// reversing entry, the same as any other POSTED journal entry (R2), not
  /// by un-closing the year.
  closedAt DateTime?

  periods       FiscalPeriod[]
  numberCounter JournalEntryNumberCounter?

  @@index([startsOn])
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

/// What a `JournalEntry` posts into. `status` governs what may still happen
/// to it: OPEN takes new postings, CLOSED is a soft boundary (WO-19.5 —
/// reopenable), LOCKED refuses everything, including a late fact (R15) —
/// which posts to whatever period is *currently* open instead, keeping its
/// own `occurredAt` on `JournalEntry.date` regardless.
model FiscalPeriod {
  id           String             @id @default(cuid())
  fiscalYearId String
  /// "2026-01" — sorts and reads correctly without joining FiscalYear.
  name         String
  startsOn     DateTime
  endsOn       DateTime
  status       FiscalPeriodStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entries    JournalEntry[]

  @@unique([fiscalYearId, name])
  @@index([status])
  @@index([startsOn, endsOn])
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

/// One fact, posted as a balanced set of `JournalLine` rows. Immutable once
/// created except for the single `POSTED -> REVERSED` transition (enforced
/// by a database trigger, not application discipline alone — see the
/// migration). A correction is a new entry with `reversalOfId` set, mirrored
/// debit/credit, never an edit to this one.
model JournalEntry {
  id           String             @id @default(cuid())
  /// A legal sequence, not an id — gapless per fiscal year (R18). Never
  /// node-prefixed the way Order.number is (R6): unlike an offline sale, a
  /// journal is never posted at branch tier, so there is nothing to
  /// disambiguate between nodes yet. See accounting.service.ts.
  number       String             @unique
  /// The fact's own original time — retained even when a late arrival lands
  /// in a later period than the date itself would suggest (R15).
  date         DateTime
  periodId     String
  /// The domain event name that caused this posting — "order.placed",
  /// "payment.succeeded" — set by the posting rules in
  /// posting-rules.subscriber.ts (WO-19.2). Free text, not an enum: a new
  /// posting rule is a new subscriber method, never a migration here.
  source       String
  sourceRef    String?
  status       JournalEntryStatus @default(POSTED)
  reversalOfId String?            @unique
  memo         String?
  createdAt    DateTime           @default(now())

  period     FiscalPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  @@index([periodId])
  @@index([source, sourceRef])
  @@index([status])
}

/// One debit or credit. `SUM(debitMinor) = SUM(creditMinor)` across every
/// line of one `entryId` is enforced by a deferred constraint trigger — see
/// the migration — not merely checked in application code before the
/// insert (that check exists too, in accounting.service.ts, but it is the
/// friendlier error message, not the guarantee).
///
/// Dimensions are plain scalars, no `@relation` — R15's own decoupling
/// principle applied at the schema level: `accounting` names a contact or a
/// supplier without importing `crm` or `purchasing`'s models, the same way
/// its service imports neither module.
model JournalLine {
  id          String @id @default(cuid())
  entryId     String
  accountId   String
  debitMinor  Int    @default(0)
  creditMinor Int    @default(0)

  /// ISO 4217. `debitMinor`/`creditMinor` themselves are ALWAYS posted in
  /// the deployment's own base currency (`BRAND.locale.currency`) — that is
  /// what the balance trigger sums, raw, per entry. `currency` here is the
  /// ORIGINATING document's currency when one exists (a foreign-currency
  /// supplier bill, say); informational/audit, never something a reader
  /// re-derives the base amount from. See posting-rules.subscriber.ts (R16,
  /// WO-19.3) and `convertToBase` (@newax/shared).
  currency        String
  /// rate * 1_000_000, an integer (House Rule 5 / R16) — 1_000_000 is "no
  /// conversion", the rate used to produce this line's base-currency amount
  /// from the originating document's own currency.
  fxRateScaled    Int    @default(1000000)
  /// Always equal to whichever of debitMinor/creditMinor is non-zero — kept
  /// as its own column so a report never needs a CASE WHEN to pick one.
  baseAmountMinor Int

  organizationId      String?
  retailBrandId       String?
  branchNodeId        String?
  costCentreId        String?
  contactId           String?
  supplierId          String?
  /// R17: set only on an intercompany line (its account is also flagged
  /// `isIntercompany`) — the OTHER brand in the trade, so consolidation at
  /// the org tier (WO-20.6) can find this line's matching opposite number
  /// and eliminate the pair before producing the group P&L/balance sheet.
  /// A bare scalar, not a `@relation`, the same decoupling this model's own
  /// header already explains for `contactId`/`supplierId`.
  counterpartyBrandId String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@index([retailBrandId])
  @@index([branchNodeId])
  @@index([counterpartyBrandId])
}

/// Backing store for gapless per-fiscal-year journal numbers (R18) — same
/// atomic-counter shape as `OrderNumberCounter` and its siblings
/// (orders.prisma), keyed by `fiscalYearId` instead of a calendar year
/// because a journal number's "year" is the fiscal year, not the calendar
/// one. Genuinely gapless, not merely usually so (R6's order numbers accept
/// a gap from a failed checkout): the increment happens inside the exact
/// same transaction as the entry it numbers, so a rolled-back posting rolls
/// the counter back with it.
model JournalEntryNumberCounter {
  fiscalYearId String     @id
  counter      Int        @default(0)
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
}

/// Book depreciation for an `Asset` (hr.prisma, doc 79) — the "separately-
/// scoped fixed-asset accounting capability" doc 79's own status note
/// deferred. `Asset` never posts to the GL at acquisition (doc 79's own
/// scope lens); this schedule is the first thing that does, monthly, once
/// created. `accountingModule` reads `Asset` by its bare Prisma model, the
/// same "core data, no module import" shape `PostingRulesSubscriber`
/// already uses for `Order`/`Payment` — `accounting` still imports no other
/// module (accounting.module.ts's own header comment, unchanged).
enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model AssetDepreciationSchedule {
  id      String             @id @default(cuid())
  /// hr.prisma's Asset.id — one active schedule per asset at a time.
  assetId String             @unique
  method  DepreciationMethod

  /// Snapshotted from Asset.purchaseCostMinor at schedule creation — never
  /// re-read live, so a later correction to the asset's own record does not
  /// silently reshape an in-progress schedule (the version-stamp discipline
  /// this document's own scope lenses require).
  acquisitionCostMinor Int
  salvageValueMinor    Int      @default(0)
  usefulLifeMonths     Int
  /// DECLINING_BALANCE only; null for STRAIGHT_LINE.
  decliningRateBps     Int?
  startDate            DateTime

  createdById String
  createdAt   DateTime  @default(now())
  /// Set when disposeAsset() closes this schedule out. A closed schedule's
  /// own postings are never deleted — the reversal document lens.
  closedAt    DateTime?

  asset     Asset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User                       @relation(fields: [createdById], references: [id])
  postings  AssetDepreciationPosting[]

  @@index([closedAt])
}

/// One row per period posted — the same "snapshot at write time, never
/// re-derived" discipline PayRunLine/OrderEconomics already establish.
/// Never updated or deleted once created; `postMonthlyDepreciation()`'s own
/// idempotency (`@@unique([scheduleId, periodStart])` here, plus
/// `findPostedEntry()`'s own key on the journal entry itself) makes a
/// second run for an already-posted period a guaranteed no-op.
model AssetDepreciationPosting {
  id          String   @id @default(cuid())
  scheduleId  String
  periodStart DateTime
  periodEnd   DateTime
  amountMinor Int
  postedAt    DateTime @default(now())

  schedule AssetDepreciationSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, periodStart])
  @@index([scheduleId])
}

// The `accounts` capability module — 149-b2b-accounts-approvals-sector-packs.md
// (b2b-wholesale-multientity/149-b2b-accounts-approvals-sector-packs.md). A
// thin layer over mechanisms this repository already has in full: placing an
// order against a B2BAccount is not a new payment mechanism, it is the
// ABSENCE of one at order time — doc 145's own CreditTermsService.
// checkCreditAvailable() gates it (AccountProvider, payments/providers/
// account.provider.ts), and the order posts as an outstanding receivable
// through the identical OrderPlaced posting rule every order already uses
// (accounting/posting-rules.subscriber.ts's own "always posts to AR rather
// than branching on payment method"). Settlement later runs through the
// identical PaymentsService.approve() every COD/bank-transfer payment
// already uses — no new settlement code exists here on purpose.
//
// No `organizationId` column, deviating from this doc's own sketch — same
// reasoning pricing.prisma's own header note already gives: this codebase is
// one Organization per deployment, so a CRM-adjacent config table (not a
// money-posting ledger line) needs no per-row tenant column.
//
// `customerId`/`requestedByContactId`/approver ids are all `Contact.id`
// (crm.prisma), matching the already-built `CustomerCreditTerm.customerId`
// convention (receivables.prisma) — never `Party` (parties.prisma), despite
// this doc's own loose "Party/Contact" phrasing, because this is the exact
// model `checkCreditAvailable()` already keys its credit check against.

model B2BAccount {
  id                    String   @id @default(cuid())
  /// Contact.id — the buyer this standing account belongs to. @unique: "the
  /// second copy of the write" lens — never two accounts for one buyer.
  customerId            String   @unique
  isActive              Boolean  @default(true)
  /// The buyer's own PO number becomes a required reference on every order
  /// placed against this account (PaymentContext.purchaseOrderReference).
  requiresPurchaseOrder Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  approvalPolicy B2BPurchaseApprovalPolicy?
  orderRequests  B2BOrderRequest[]

  @@index([isActive])
}

/// The buyer's own internal purchasing control, not this organization's —
/// the seller merely holds and enforces the buyer's stated policy, the way a
/// corporate card program enforces a cardholder's own spend limit without
/// deciding it. Registers B2BAccount's own order-submission path against the
/// existing generic ApprovalChain/ApprovalStep mechanism
/// (ApprovalSubjectType.B2B_ORDER) — never a second approval-chain
/// implementation.
model B2BPurchaseApprovalPolicy {
  id             String   @id @default(cuid())
  b2bAccountId   String   @unique
  /// Orders at or above this amount require approval before they place.
  thresholdMinor Int
  /// Which of the buyer's OWN Contacts may approve — never one of this
  /// org's own staff. Any ONE of these may decide (a set, not a sequence);
  /// doc 149's own Out of Scope: multi-tier chains are doc 63's existing
  /// generic tier-count mechanism, not built here until a real buyer needs
  /// it.
  approverContactIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  b2bAccount B2BAccount @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
}

enum B2BOrderRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Converted into a real Order via the identical order-placement path
  /// every other order already uses (OrdersService.place()).
  CONVERTED
}

/// "Request or record" — an order placed against a B2BAccount under an
/// active B2BPurchaseApprovalPolicy, at or above its thresholdMinor, is a
/// REQUEST until approved (refusable by the buyer's own approver): no Order,
/// no stock deduction, no ledger posting exists until this request is
/// APPROVED and converted, mirroring PurchaseRequisition ->
/// convertToPurchaseOrder() exactly — never a bespoke second flow. A
/// rejected request is a terminal chain state (doc 63's own existing
/// answer); re-submission starts a new request and a new chain, never
/// resets the rejected one.
model B2BOrderRequest {
  id           String @id @default(cuid())
  b2bAccountId String
  /// Contact.id of the buyer who submitted this — never automatically
  /// accepted as this request's own approver, even if listed in
  /// approverContactIds ("the toxic pair" lens), enforced by the caller
  /// (AccountsService), not ApprovalService itself.
  requestedByContactId String
  /// The signed-in User behind that Contact, if any — OrdersService.place()
  /// takes a userId, not a contactId, so this is what CONVERTED replays
  /// against.
  requestedByUserId    String?
  cartToken            String
  locale               String
  /// The full PlaceOrderDto as submitted, replayed verbatim at conversion —
  /// never re-derived from a second, parallel input.
  paymentDto Json
  /// The cart's own resolved total at submission time — an approximation
  /// used only for the threshold decision and for display; the REAL,
  /// binding amount is whatever OrdersService.place() computes fresh at
  /// conversion time, the same re-price-from-the-database discipline every
  /// other order already follows.
  amountMinor   Int
  status        B2BOrderRequestStatus @default(PENDING)
  /// Set once APPROVED and converted — @unique so a request can never
  /// convert twice ("the second copy of the write" lens).
  orderId       String?               @unique
  rejectionNote String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  b2bAccount B2BAccount @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)

  @@index([b2bAccountId, status])
}

// Approvals: one generic, subject-agnostic approval chain, referenced by a
// (subjectType, subjectId) pair rather than a bespoke chain per feature —
// doc 63's own shape (docs/implementation/hr-people-org/63-multi-tier-approval-hierarchies.md).
// Built here scoped to what WO-152 (purchase requisitions) actually needs;
// ApprovalSubjectType is deliberately a plain enum, extended by adding a
// value, not a plugin registry — WALLET_ADJUSTMENT (doc 155, WO-155.2) is
// its second consumer, added the same way: a new enum value, never a
// bespoke chain (no speculative functionality, CLAUDE.md).

enum ApprovalSubjectType {
  PURCHASE_REQUISITION
  /// doc 155 (WO-155.2) — an above-threshold WalletAdjustmentRequest.
  WALLET_ADJUSTMENT
  /// doc 149 (WO-149.1) — a B2BOrderRequest at or above its account's own
  /// B2BPurchaseApprovalPolicy.thresholdMinor.
  B2B_ORDER
  /// doc 24 (WO-24.5) — a BroadcastMessage above ANNOUNCE_QUORUM_RANK or
  /// addressed to more than the configured recipient count.
  BROADCAST_MESSAGE
}

enum ApprovalChainStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalChain {
  id          String              @id @default(cuid())
  subjectType ApprovalSubjectType
  subjectId   String
  currentStep Int                 @default(1)
  status      ApprovalChainStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  steps ApprovalStep[]

  @@unique([subjectType, subjectId])
  @@index([subjectType, status])
}

model ApprovalStep {
  id             String             @id @default(cuid())
  chainId        String
  stepOrder      Int
  /// Never all empty — resolved to a specific approver at decide() time,
  /// either directly (approverUserId), by whoever holds the role
  /// (approverRoleId), or by any ONE of a named set of the buyer's OWN
  /// Contacts (approverContactIds, doc 149) — a set, not a sequence: this
  /// document's own single-tier case, never a User of this deployment.
  approverRoleId     String?
  approverUserId     String?
  approverContactIds String[]           @default([])
  status             ApprovalStepStatus @default(PENDING)
  decidedAt          DateTime?
  decidedById        String?
  /// Set instead of decidedById when a buyer's own Contact decides (a
  /// B2B_ORDER step, doc 149) — decidedById's own @relation is typed to
  /// User, so a Contact's id cannot be written there. A bare scalar, not a
  /// `@relation`, same decoupling as JournalLine.contactId
  /// (accounting.prisma).
  decidedByContactId String?
  comment            String?

  chain     ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation("ApprovalStepDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([chainId, stepOrder])
  @@index([approverUserId, status])
}

// Attendance, shifts and leave —
// docs/implementation/attendance-workforce/22-attendance-shifts-leave.md.
//
// A RECORD, not a request (RETAIL-ERP.md R5 applied to people): a punch is
// never refused. AttendanceEvent is written unconditionally; anything that
// does not fit becomes an AttendanceException, queued for a human — never
// dropped, never silently coerced onto the nearest shift.
//
// DEVIATIONS from this doc's own schema, recorded in full in DECISIONS.md
// ADR-046 before most of this file was written:
//   - `employeeId` is `userId -> User`, not `Employee` — the identical call
//     ADR-044 already made for every other hr-people-org table (Posting,
//     EmployeeProfile, AssetAssignment). This document predates that
//     decision; it is not re-litigated here.
//   - `AttendanceDevice` is a NEW model this file adds. The doc's own text
//     says a device "authenticates by key hash exactly as
//     PosTerminal.deviceKeyHash does" but its own schema block never
//     declares the table — WO-22.4 ("device enrolment, key hash, rotation")
//     is that missing model, built here mirroring `PosTerminal` exactly.
//   - Lives in its own file (`attendance.prisma`), not appended to
//     `hr.prisma` as the doc's own text says — this document's own home is
//     a new module (`attendance`), a genuinely distinct capability from
//     `hr`'s assets/positions/postings, matching the one-schema-file-per-
//     module convention `org-structure.prisma` already set for the
//     `orgstructure` module.
//
// Partitioning (WO-22.1, "the one table in this set that must be designed
// for the volume on day one"): `AttendanceEvent` is `PARTITION BY RANGE
// (occurredAt)` in the hand-written migration. Postgres requires every
// unique constraint and the primary key on a partitioned table to include
// the partition key column, so this model's primary key is the composite
// `(id, occurredAt)`, not `id` alone, and its idempotency unique constraint
// includes `occurredAt` too — harmless for that purpose, since a genuine
// replay of the same punch carries the identical `occurredAt` the device
// sent the first time. A DEFAULT partition (migration) is the safety net
// that keeps "a punch is never refused" true even if the monthly-partition
// maintenance cron (`AttendancePartitionCron`) ever falls behind.
//
// A plain foreign key to `id` alone is impossible on a partitioned table —
// Postgres requires a FK into a partitioned parent to reference an actual
// unique/primary-key constraint on it, and this parent's real key is the
// composite `(id, occurredAt)`. `AttendanceException` therefore denormalises
// `eventOccurredAt` alongside `eventId` and its `event` relation is a real,
// DB-enforced two-column foreign key against that composite key (supported
// since Postgres 12) — not a bare scalar. `AttendanceEvent.correctsId`
// (self-referencing the same partitioned table) stays a bare scalar with no
// relation, the one place this file follows the documented
// `PosTerminal.locationId` pattern instead ("a bare scalar... checks it
// exists itself rather than leaning on a DB-level FK") — a second
// denormalised timestamp column for the rarer correction path was not
// worth the schema weight the core reconciliation path already justifies.

enum AttendanceKind {
  IN
  OUT
  BREAK_START
  BREAK_END
  ADJUSTMENT
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/attendance's
/// MealComplianceEngine): which statutory bucket a BREAK_START punch counts
/// toward. Null (unset) is honest, not a default — the pure engine only
/// classifies breaks it is told about, and this file's own doctrine is
/// "never silently coerced."
enum AttendanceBreakType {
  MEAL
  REST
}

enum AttendanceSource {
  DEVICE
  SELF
  MANAGER
  IMPORT
}

enum AttendanceDeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// A biometric terminal or kiosk that punches on behalf of employees at one
/// unit. Not a `User` and holds no permission key — see this document's own
/// "principal with no permission key" scope lens. Same shape as
/// `PosTerminal`: a credential issued once, verified by its hash.
model AttendanceDevice {
  id            String                 @id @default(cuid())
  /// Short, human-chosen — printed on the device or its enrolment sheet.
  code          String                 @unique
  label         String
  orgUnitId     String
  /// SHA-256 of the device credential — issued once via `rotateDeviceKey()`,
  /// shown raw exactly that once, never persisted or echoed back.
  deviceKeyHash String?                @unique
  status        AttendanceDeviceStatus @default(PENDING)
  lastSeenAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  orgUnit OrgUnit           @relation(fields: [orgUnitId], references: [id])
  events  AttendanceEvent[]

  @@index([orgUnitId])
  @@index([status])
}

/// Raw, immutable. One row per punch. Never updated, never deleted — a
/// correction is a second row of kind ADJUSTMENT referencing the first via
/// `correctsId`.
model AttendanceEvent {
  id         String         @default(cuid())
  userId     String
  kind       AttendanceKind
  /// The instant, in UTC, always. Never a local wall-clock string — see
  /// `attendance-time.ts`'s own header for why every duration is computed
  /// from this, never from a parsed local time.
  occurredAt DateTime
  /// The IANA zone of the place it happened, copied at write time. A group
  /// spanning zones cannot compute a working day without it, and the zone
  /// of a unit can change (policy, DST rules) after the fact.
  timezone   String
  /// Where. Copied, not joined: the unit may be re-parented later
  /// (hr-people-org/19) and this row must keep the unit it was written
  /// against.
  orgUnitId  String

  /// What produced it — a device, a self-service punch, a manager's screen,
  /// or an import. Needed to judge trust when two sources disagree.
  source   AttendanceSource
  deviceId String?

  /// Set when this row corrects an earlier one. The earlier row stays.
  /// Bare scalar, no relation — see this file's own header for why.
  correctsId  String?
  /// Idempotency key from the device or import, so a replayed punch is a
  /// no-op rather than a second day's pay.
  externalRef String?

  /// Ecosystem audit 2026-10-29 (merged from @newaxhq/attendance's
  /// GeofenceValidator): GPS reading at punch time, null for a source that
  /// never carries one (MANAGER, IMPORT, most DEVICE kiosks — a fixed
  /// terminal has no meaningful coordinates of its own). Null never blocks
  /// `classify()` — the geofence check runs only when a reading is present.
  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  isMockLocation    Boolean @default(false)

  /// Set only on a BREAK_START punch, at the puncher's own choice — which
  /// statutory bucket this break counts toward. Null on every other kind,
  /// and on a BREAK_START whose type was never specified.
  breakType AttendanceBreakType?

  createdAt DateTime @default(now())

  user       User                  @relation(fields: [userId], references: [id])
  orgUnit    OrgUnit               @relation(fields: [orgUnitId], references: [id])
  device     AttendanceDevice?     @relation(fields: [deviceId], references: [id])
  exceptions AttendanceException[]

  @@id([id, occurredAt])
  @@unique([userId, source, externalRef, occurredAt])
  @@index([userId, occurredAt])
  @@index([orgUnitId, occurredAt])
  @@index([id])
}

/// A planned shift. Rostering is deliberately thin here: a shift is a
/// window and a unit, and the client's own rota rules live in policy, not
/// in code.
model Shift {
  id        String   @id @default(cuid())
  userId    String
  orgUnitId String
  startsAt  DateTime
  endsAt    DateTime
  timezone  String

  user    User    @relation(fields: [userId], references: [id])
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id])

  @@index([userId, startsAt])
  @@index([orgUnitId, startsAt])
}

enum AttendanceExceptionReason {
  NO_MATCHING_SHIFT
  OUTSIDE_ROSTER
  WRONG_UNIT
  WHILE_ON_LEAVE
  DUPLICATE_SUSPECTED
  MISSING_COUNTERPART
  /// Ecosystem audit 2026-10-29: a GPS reading present but outside every
  /// active AttendanceGeofenceZone for the matched shift's unit.
  OUTSIDE_GEOFENCE
  /// A mock-location provider, or a travel speed between consecutive
  /// readings that is not physically possible — never a hard refusal (this
  /// file's own "a punch is never refused"), always queued for a human.
  GPS_SPOOFING_SUSPECTED
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/attendance's
/// GeofenceValidator): zero or more per unit — a site with two entrances
/// gets two zones, either one satisfies the check. No zone configured for a
/// unit means no geofence requirement at all (`classify()`'s own gate),
/// the same opt-in-by-presence idiom `PayrollTaxBracket` already uses.
model AttendanceGeofenceZone {
  id              String   @id @default(cuid())
  orgUnitId       String
  name            String
  centerLat       Float
  centerLng       Float
  radiusMeters    Int
  /// [{lat,lng}, ...] — when present and `enforcePolygon` is set, containment
  /// is tested against the polygon, not just the radius.
  polygonVertices Json?
  enforcePolygon  Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id])

  @@index([orgUnitId, isActive])
}

/// A punch that did not fit. The queue that makes "never refuse" safe.
/// `userId`/`orgUnitId` are denormalised from the source event at write
/// time — the same "click the number, sums back to the source" idiom this
/// codebase already applies elsewhere — so the reconcile screen's own list
/// query never has to reach back into the (much larger, partitioned)
/// `AttendanceEvent` table just to filter by the caller's subtree.
model AttendanceException {
  id               String                    @id @default(cuid())
  eventId          String
  eventOccurredAt  DateTime
  userId           String
  orgUnitId        String
  reason           AttendanceExceptionReason
  resolvedAt       DateTime?
  resolvedByUserId String?
  note             String?
  createdAt        DateTime                  @default(now())

  event      AttendanceEvent @relation(fields: [eventId, eventOccurredAt], references: [id, occurredAt])
  user       User            @relation("AttendanceExceptionUser", fields: [userId], references: [id])
  resolvedBy User?           @relation("AttendanceExceptionResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([resolvedAt])
  @@index([userId])
  @@index([orgUnitId])
}

// Auction app (launchpad-apps/234-auction-app.md, WO-234.1 to WO-234.5).
// Sell — or, later, buy — by competitive bidding. This file holds what the
// work orders so far read and write: the auction, its lots, the bidders, the
// hash-chained bids, the encrypted proxy maxima and the result of a closed lot.
// Deposits and adjustments (doc 234 §4) arrive in the work orders that first
// use them, each as its own additive migration, so no table or column here
// sits unused.

enum AuctionType {
  ENGLISH
  SEALED_BID
  REVERSE
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSING
  CLOSED
  SETTLED
  CANCELLED
}

enum AuctionLotStatus {
  PENDING
  OPEN
  CLOSED
  WITHDRAWN
}

/// Who a bid came from. Only MANUAL is written today; PROXY_AUTO (WO-234.3)
/// and SEALED (WO-234.7) exist so the column never needs altering.
enum BidKind {
  MANUAL
  PROXY_AUTO
  SEALED
}

/// Where a bidder stands in one auction (WO-234.5). PENDING is a registration
/// waiting for staff; APPROVED may bid; DECLINED is a registration staff
/// refused; SUSPENDED is a bidder staff stopped, with a reason either way. A
/// declined registration is not a suspension: the person reads one sentence and
/// staff read another history.
enum BidderStatus {
  PENDING
  APPROVED
  SUSPENDED
  DECLINED
}

/// How an auction vets who may bid (WO-234.5). OPEN: any signed-in customer who
/// does not run it, registered by their first bid. VERIFIED: a customer whose
/// identity is verified is approved on registering, anyone else waits for
/// staff. APPROVAL: everyone waits for staff. Chosen while the auction is a
/// draft; frozen from `schedule()` like the bidding rules.
enum AuctionRegistration {
  OPEN
  VERIFIED
  APPROVAL
}

/// One auction event. The three scope columns exist from the first migration
/// (doc 234 §4, "three silhouettes") and are written as soon as a deployment
/// has them: `organizationId` is unset outside the Organization tier,
/// `outletLocationId` names the selling location when the auction is run
/// from one branch. Plain strings, not relations, matching how `Order` and
/// `WalletAccount` already hold the same two ids.
model Auction {
  id               String              @id @default(cuid())
  /// "AUC-2026-0001" — documentNumber(), node-prefixed on a replica so two
  /// nodes never mint the same number (doc 234 §15, adoption test).
  number           String              @unique
  organizationId   String?
  outletLocationId String?
  /// Only ENGLISH can be created today; the other two values exist so the
  /// column never needs altering when sealed-bid (WO-234.7) and reverse
  /// (WO-234.8) arrive. AuctionService.create() refuses them until then.
  type             AuctionType         @default(ENGLISH)
  title            String
  status           AuctionStatus       @default(DRAFT)
  startsAt         DateTime
  endsAt           DateTime
  currency         String
  terms            String?
  /// The bidding rules this auction runs under, copied from Settings when it
  /// is scheduled (`{ incrementBps, minStepMinor }` today) so a later change
  /// to a Setting can never alter an auction bidders have already seen
  /// (doc 234 §15, "rules are versioned per auction"). Null while a draft;
  /// WO-234.3 adds the anti-snipe window here without a new column.
  bidRules         Json?
  /// Who may bid (WO-234.5). The column defaults to OPEN, the rule every
  /// auction ran under before it existed; AuctionService.create() writes the
  /// Setting `auction.registration_default` (APPROVAL) for a new one.
  registration     AuctionRegistration @default(OPEN)
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lots    AuctionLot[]
  bidders Bidder[]

  @@index([status, startsAt])
  @@index([organizationId])
  @@index([outletLocationId])
}

/// One thing being sold within an auction. Prices are integer minor units
/// like every other money column here, held as BIGINT (WO-234.2) so a plot or
/// a vehicle fits and no later bid column needs a type change. The service
/// hands them out as plain numbers and caps them at MAX_PRICE_MINOR, the
/// largest value whose arithmetic stays exact in a JavaScript number.
model AuctionLot {
  id                String           @id @default(cuid())
  auctionId         String
  /// Position within the auction, shown to bidders as "Lot 7".
  lotNo             Int
  title             String
  description       String?
  /// What backs the lot — a catalogue item, a stock lot, a housing-society
  /// plot — as the provider names it. Filled through `AuctionLotSource`
  /// (WO-234.11); null for a lot typed in by hand.
  sourceType        String?
  sourceId          String?
  quantity          Int              @default(1)
  startPriceMinor   BigInt
  /// Hidden from bidders always (doc 234 §5.5, §15). Never part of any
  /// public response.
  reservePriceMinor BigInt?
  /// The highest accepted bid, null until the first one. Changed only by
  /// AuctionService.placeBid(), in the same statement that bumps `bidSeq`
  /// (doc 234 §6, predicate-on-write).
  currentBidMinor   BigInt?
  leaderBidderId    String?
  /// How many bids this lot has accepted; also the version the predicate
  /// compares, so two writers who read the same value cannot both win.
  bidSeq            Int              @default(0)
  /// When bidding on this lot ends, once it has been moved: by anti-snipe
  /// (WO-234.3) or by recovery after an outage. Null means "when the auction
  /// ends", so a lot nobody has bid late on has one end, the auction's.
  endsAt            DateTime?
  /// Milliseconds of anti-snipe extension used so far, counted on its own so
  /// that moving a lot's end after an outage never spends the cap that bounds
  /// a bidding war.
  extendedMs        Int              @default(0)
  status            AuctionLotStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  auction     Auction             @relation(fields: [auctionId], references: [id])
  bids        Bid[]
  proxies     ProxyBid[]
  result      AuctionResult?
  settlements AuctionSettlement[]
  images      AuctionLotImage[]

  @@unique([auctionId, lotNo])
  @@index([auctionId, status])
}

/// A photograph of a lot (WO-234.12). Changed only while the auction is a draft,
/// like the rest of what bidders are told about the lot, and removed by its row,
/// never by deleting a lot (lots are withdrawn). `order` is 0 for the cover and
/// stays contiguous (the service renumbers on removal); it is deliberately not
/// unique so a reorder can write its rows in any sequence. `storageKey` is the
/// driver's key, kept so removing the photo can remove the object.
model AuctionLotImage {
  id         String   @id @default(cuid())
  lotId      String
  url        String
  storageKey String
  order      Int
  createdAt  DateTime @default(now())

  lot AuctionLot @relation(fields: [lotId], references: [id])

  @@index([lotId, order])
}

/// A person bidding in one auction. Registered by themselves (WO-234.5) or by
/// their first bid under an OPEN auction, and shown to everyone else only by
/// `alias` ("Bidder 7"), never by name (doc 234 §15, "whose rows"). `userId` is
/// the portal account that acts as this bidder, a plain string like the other
/// cross-module ids in this file. The decision columns say who last decided and
/// why (the reason is written for the bidder to read); the appeal is the
/// bidder's one open question, cleared by the next decision, and the history of
/// both is the audit trail. Strikes are about the person, so they live apart.
model Bidder {
  id             String       @id @default(cuid())
  auctionId      String
  userId         String
  alias          String
  status         BidderStatus @default(APPROVED)
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  appealText     String?
  appealedAt     DateTime?
  createdAt      DateTime     @default(now())

  auction     Auction             @relation(fields: [auctionId], references: [id])
  bids        Bid[]
  proxies     ProxyBid[]
  results     AuctionResult[]
  strikes     BidderStrike[]
  settlements AuctionSettlement[]

  @@unique([auctionId, userId])
  @@unique([auctionId, alias])
  // The staff queue: one auction's bidders by status, oldest first.
  @@index([auctionId, status, createdAt])
}

/// A mark against a person (WO-234.5), recorded by staff with a reason and,
/// when there is one, the lot it concerns. Counted over a rolling window per
/// `userId`, never stored as a number, so voiding one cannot leave a stale
/// count. Never deleted: a mistaken strike is voided with a reason.
model BidderStrike {
  id           String    @id @default(cuid())
  userId       String
  bidderId     String
  lotId        String?
  reason       String
  /// The staff member who recorded it. Null for a strike the system recorded
  /// itself when a payment window passed (WO-234.6): then `settlementId` names
  /// the settlement, and is unique so a retried sweep cannot strike twice.
  recordedById String?
  settlementId String?   @unique
  recordedAt   DateTime  @default(now())
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?

  bidder Bidder @relation(fields: [bidderId], references: [id])

  @@index([userId, recordedAt])
  @@index([bidderId])
}

/// One accepted bid: a record, never edited and never deleted (doc 234 §5.2).
/// A mistaken bid is answered by an adjustment document (WO-234.9), not an
/// UPDATE. `seq` is assigned under the lot's lock, so it is strictly
/// increasing per lot; `hash = SHA-256(prevHash ‖ canonical row)` makes an
/// insert, an edit or a removal visible to anyone who re-walks the chain
/// (doc 234 §6). Bid ids are random UUIDs, safe for two nodes to mint offline.
model Bid {
  id             String   @id @default(uuid())
  lotId          String
  bidderId       String
  amountMinor    BigInt
  kind           BidKind  @default(MANUAL)
  seq            Int
  /// The server's clock when the bid was accepted. The client's is never
  /// consulted (doc 234 §5.1).
  acceptedAt     DateTime
  /// Chosen by the caller, one per intended bid, resent unchanged on a retry.
  idempotencyKey String
  /// The previous bid's `hash`; null only for `seq` 1.
  prevHash       String?
  hash           String

  lot    AuctionLot @relation(fields: [lotId], references: [id])
  bidder Bidder     @relation(fields: [bidderId], references: [id])

  @@unique([lotId, seq])
  @@unique([lotId, bidderId, idempotencyKey])
  @@index([bidderId, acceptedAt])
}

/// A bidder's standing maximum on one lot (doc 234 §5.3): the system bids the
/// least that keeps them ahead, up to this. Stored encrypted (AES-256-GCM,
/// `APP_ENCRYPTION_KEY`) and never returned to anyone but its owner, because the
/// number is the whole of the bidder's strategy; the database holds no readable
/// copy. It can be raised and never lowered or withdrawn (doc 234 §5.6).
model ProxyBid {
  id             String   @id @default(cuid())
  lotId          String
  bidderId       String
  /// `iv:authTag:ciphertext`, from `encryptSecret`.
  maxCipher      String
  /// The lot's `bidSeq` when this maximum was first placed. Of two equal
  /// maxima the one placed after fewer bids is the earlier and wins (doc 234
  /// §5.3); it is compared as `placedAfterSeq + 0.5`, so it sorts after the bid
  /// with that `seq` and before the next.
  placedAfterSeq Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lot    AuctionLot @relation(fields: [lotId], references: [id])
  bidder Bidder     @relation(fields: [bidderId], references: [id])

  @@unique([lotId, bidderId])
}

/// How a lot ended (doc 234 §5.5). One row per lot, written once by the close
/// job in the same transaction that closes the lot, so a second run cannot make
/// a second result. The winner is `topBidderId` when `reserveMet`, nobody
/// otherwise; a lot whose reserve was not met keeps its highest bidder here so
/// staff can decide whether to make that bidder an offer, which is never
/// automatic. The order and settlement columns arrive with WO-234.6.
model AuctionResult {
  id          String   @id @default(cuid())
  lotId       String   @unique
  topBidderId String?
  topBidMinor BigInt?
  reserveMet  Boolean
  bidCount    Int
  closedAt    DateTime

  lot    AuctionLot @relation(fields: [lotId], references: [id])
  bidder Bidder?    @relation(fields: [topBidderId], references: [id])
}

/// Where a settlement stands (WO-234.6, doc 234 §9). INVOICING: claimed, the
/// order not yet made (a sweep retries one stuck here). INVOICE_FAILED: the
/// order could not be made and `failureReason` says why; staff Replay it once
/// that is fixed. AWAITING_PAYMENT: the order exists and the window is running.
/// PAID: what was received reached what is owed. EXPIRED: the window passed
/// unpaid; the order was cancelled and a strike recorded. CANCELLED: staff
/// ended it, or its order was cancelled elsewhere; no strike.
enum AuctionSettlementStatus {
  INVOICING
  INVOICE_FAILED
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

/// What a winning lot owes: one row per lot per offer (WO-234.6). `attempt` 1 is
/// the winner; a staff-made offer to the next highest bidder is attempt 2, and
/// so on, so `(lotId, attempt)` is the "second copy of the write" guard (doc 234
/// §15). Money is BIGINT minor units like every other auction column; the order
/// it becomes is limited to 32 bits, which the sink reports as INVOICE_FAILED.
model AuctionSettlement {
  id             String                  @id @default(cuid())
  lotId          String
  auctionId      String
  bidderId       String
  /// The portal account that owes it, copied from the bidder at the moment of
  /// the win: a Bidder is per auction, and the order and the strike follow the person.
  userId         String
  attempt        Int                     @default(1)
  status         AuctionSettlementStatus @default(INVOICING)
  currency       String
  hammerMinor    BigInt
  /// The buyer's premium rate this auction was scheduled with, in basis points,
  /// and what it came to on this win (rounded half up, never negative).
  premiumBps     Int                     @default(0)
  premiumMinor   BigInt                  @default(0)
  totalMinor     BigInt
  /// Sum of the payments received against the order (AuctionSettlementPayment).
  paidMinor      BigInt                  @default(0)
  dueAt          DateTime
  orderId        String?
  orderNumber    String?
  failureReason  String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  lot      AuctionLot                 @relation(fields: [lotId], references: [id])
  bidder   Bidder                     @relation(fields: [bidderId], references: [id])
  payments AuctionSettlementPayment[]

  @@unique([lotId, attempt])
  // The staff list: one auction's settlements by status, newest first.
  @@index([auctionId, status, createdAt])
  // The sweep: what is due, and what is stuck invoicing.
  @@index([status, dueAt])
  @@index([orderId])
}

/// One payment counted against a settlement (WO-234.6). `payment.succeeded`
/// fires once per payment row and is delivered at least once, so the payment's
/// own id is the key: the second delivery finds the row and adds nothing.
model AuctionSettlementPayment {
  paymentId    String   @id
  settlementId String
  amountMinor  BigInt
  receivedAt   DateTime @default(now())

  settlement AuctionSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
}

// Bank facility management
// (finance-accounting/167-bank-facility-management.md).
// The mirror concern to receivables.prisma: not what the business is owed,
// but what the business itself owes a bank against a facility limit — a
// term loan, running finance, an overdraft, or a letter-of-credit/bank-
// guarantee facility limit. Additive only.

enum BankFacilityType {
  TERM_LOAN
  RUNNING_FINANCE
  OVERDRAFT
  LETTER_OF_CREDIT
  BANK_GUARANTEE
}

enum BankFacilityStatus {
  ACTIVE
  CLOSED
}

/// The lending institution itself — deliberately its own actor, never
/// `Contact`/`Party`: a bank is not a customer or a supplier
/// (167-bank-facility-management.md's own "actor with three tables" lens).
model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  facilities     BankFacility[]
  statementLines BankStatementLine[]
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/bankfacilities): one
/// line from a bank statement, matched (or not yet matched) against a
/// recorded drawdown/repayment — reconciliation's own ledger, scoped to
/// the bank it came from (a statement is the bank's, not any one
/// facility's — a bank with several facilities gets one statement).
enum BankStatementLineType {
  CREDIT
  DEBIT
}

model BankStatementLine {
  id                   String                @id @default(cuid())
  bankId               String
  date                 DateTime
  description          String
  reference            String?
  amountMinor          Int
  type                 BankStatementLineType
  matchedTransactionId String?
  reconciled           Boolean               @default(false)
  createdAt            DateTime              @default(now())

  bank Bank @relation(fields: [bankId], references: [id])

  @@index([bankId, date])
}

/// One facility limit a bank has extended — its own markup rate, tenor and
/// maturity, independent of any drawdown against it. Utilization is never
/// stored here: it is computed at read time from `drawdowns`/`repayments`
/// (BankFacilitiesService.utilizationOf()), the same "never a maintained
/// counter that could drift" discipline doc 150's bundleAvailableStock()
/// already applies.
model BankFacility {
  id                String             @id @default(cuid())
  bankId            String
  /// "hbl-running-finance-01" — stable, human-chosen, never reused.
  key               String             @unique
  label             String
  facilityType      BankFacilityType
  limitMinor        Int
  /// Annual markup rate in basis points (2200 = 22.00%), current as of
  /// today for a floating-rate facility — `isFloatingRate` names it as a
  /// value an admin re-enters when the bank revises it, never something
  /// this schema tracks a history of on its own.
  markupRateBps     Int
  isFloatingRate    Boolean            @default(false)
  securityReference String?
  startDate         DateTime
  maturityDate      DateTime
  status            BankFacilityStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())

  bank       Bank                        @relation(fields: [bankId], references: [id])
  drawdowns  BankFacilityDrawdown[]
  repayments BankFacilityRepayment[]
  accruals   BankFacilityMarkupAccrual[]
  covenants  BankFacilityCovenant[]

  @@index([status])
  @@index([maturityDate])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/bankfacilities): a
/// loan covenant the bank imposed on this facility — never a stored
/// pass/fail, always evaluated at read time against the facility's own
/// live utilization or caller-supplied metrics, same "never a maintained
/// counter that could drift" discipline the facility's own utilizedMinor
/// already applies.
enum BankFacilityCovenantType {
  MAX_UTILIZATION_BPS
  MAX_LEVERAGE
  MIN_DSCR
}

model BankFacilityCovenant {
  id              String                   @id @default(cuid())
  facilityId      String
  covenantType    BankFacilityCovenantType
  targetThreshold Float
  description     String?
  createdAt       DateTime                 @default(now())

  facility BankFacility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
}

/// A REQUEST/RECORD pair like every other money-moving mechanism in this
/// codebase: below the configured threshold, posts straight through;
/// above it, needs a second approver (finance.facilities.approve_drawdown)
/// before `post()` — the identical shape CreditNotesService's own
/// create()/approve()/issue() already establishes. Refused outright if it
/// would push utilization past the facility's own limit — surfaced before
/// an over-limit drawdown is allowed to post, never discovered after.
model BankFacilityDrawdown {
  id            String    @id @default(cuid())
  facilityId    String
  amountMinor   Int
  drawdownDate  DateTime
  note          String?
  createdById   String
  approvedById  String?
  postedAt      DateTime?
  createdAt     DateTime  @default(now())

  facility BankFacility @relation(fields: [facilityId], references: [id])
}

/// A repayment against principal, accrued markup, or both — either
/// component may be zero but not both. Posts through the same
/// findPostedEntry idempotency key every other posting rule in this
/// repository already uses.
model BankFacilityRepayment {
  id             String   @id @default(cuid())
  facilityId     String
  principalMinor Int      @default(0)
  markupMinor    Int      @default(0)
  repaymentDate  DateTime
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  facility BankFacility @relation(fields: [facilityId], references: [id])
}

/// One row per calendar month the markup-accrual cron posts for a facility
/// — mirrors AssetDepreciationPosting exactly: a schedule-free periodic
/// posting log giving findPostedEntry-style idempotency without re-deriving
/// totals from the general ledger on every read.
model BankFacilityMarkupAccrual {
  id          String   @id @default(cuid())
  facilityId  String
  periodStart DateTime
  periodEnd   DateTime
  amountMinor Int
  createdAt   DateTime @default(now())

  facility BankFacility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, periodStart])
}

// BOM: which raw materials go into a finished product, how much of each, and
// what that makes the product cost to produce (RETAIL-ERP.md Tranche 6,
// WO-23.2 — "build 10-admin-dashboard.md §C as written"). WO-C.1 added
// RawMaterial, WO-C.2 added BomRecipe/BomComponent, WO-C.3 (this revision)
// adds BomProductionRun/BomProductionLine — the step that actually consumes
// raw stock and produces finished stock, closing the loop the earlier two
// work orders only estimated.
//
// A raw material is NOT a new kind of thing. It is an ordinary ProductVariant
// with a RawMaterial marker row pointing at it, so purchase orders, goods
// receipts, the stock ledger, stock counts, reorder points and weighted-average
// costing all work on fabric exactly as they work on a kurta (D5) — this file
// adds no coupling to inventory/purchasing at all; every one of those already
// works on any ProductVariant.
//
// QUANTITIES ARE INTEGER BASE UNITS, the same discipline money uses. unitScale
// says how many base units make one display unit: fabric is GAZ with unitScale
// 1000, so stock 12500 is 12.5 gaz and costPrice is paisa per milli-gaz.
// Convert only at the UI boundary, through @newax/shared's toBaseUnits /
// fromBaseUnits / formatQuantity. A bare scale multiplication in a component
// is a bug.

enum RawMaterialUnit {
  GAZ
  METRE
  PIECE
  SPOOL
  GRAM
  MILLILITRE
}

model RawMaterial {
  id String @id @default(cuid())

  /// The ProductVariant that carries stock, costPrice, supplier links and the
  /// movement ledger. One variant is at most one raw material.
  variantId String @unique

  /// Staff-only. Not a translation row (Rule 6, D10): nobody shopping sees this.
  name String
  /// "fabric" | "trim" | "packaging" | "consumable". Groups the raw-usage report.
  kind String @default("fabric")

  unit      RawMaterialUnit
  /// Base units per display unit. 1000 for continuous goods, 1 for countable.
  /// Effectively immutable once stock or a StockMovement exists for the
  /// variant — see raw-material.service.ts's own note on why.
  unitScale Int             @default(1)

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant         ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Recipes that consume this material. Restrict delete (BomComponent's own
  /// FK): a raw material a live recipe depends on cannot vanish out from
  /// under it.
  components      BomComponent[]
  /// Every production-run line that ever consumed this material — ledger
  /// history, kept even after the material is deactivated.
  productionLines BomProductionLine[]

  @@index([isActive, kind])
  @@index([name])
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The recipe for one finished ProductVariant: which raw materials, how much
/// of each, and the resulting cost estimate. WO-C.2 (10-admin-dashboard.md
/// §C). No nesting in v1 — recipe.service.ts refuses a BomComponent whose
/// raw material's own variant carries a BomRecipe, and a component pointing
/// at the recipe's own output variant. Sub-assemblies are explicitly
/// deferred (they turn a two-day work order into a two-week one).
model BomRecipe {
  id String @id @default(cuid())

  /// The finished ProductVariant this recipe produces. One live recipe per variant.
  variantId String @unique

  status  BomStatus @default(DRAFT)
  version Int       @default(1)

  /// How many finished units one run yields. Lets a recipe be written
  /// per-dozen where that is how the workshop actually thinks.
  outputQuantity Int @default(1)

  /// Expected scrap, basis points (Rule 5). 500 = 5%. Per-component override wins.
  wastageBps Int @default(0)

  /// Paisa per finished unit. Not materials — stitching labour and overhead.
  labourCost   Int @default(0)
  overheadCost Int @default(0)

  /// CACHE. Paisa per finished unit at CURRENT raw costs (cost-rollup.ts).
  /// Recomputed on every recipe edit and every goods receipt touching a
  /// component (bom.listener.ts). An ESTIMATE for the editor — it is NEVER
  /// the COGS of a sale, which is OrderItem.unitCost (Rule 7).
  rolledUpUnitCost Int       @default(0)
  /// False when any non-optional component's variant.costPrice is 0
  /// (UNKNOWN, not free) — surfaced, never silently treated as free.
  costComplete     Boolean   @default(false)
  costComputedAt   DateTime?

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("BomRecipeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  components BomComponent[]
  runs       BomProductionRun[]
  stages     BomRecipeStage[]

  @@index([status])
  @@index([costComplete])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/production): a named
/// machine group a routing step runs at — "Cutting Table 1", "Overlock
/// Line". Capacity (machineCount * shiftsPerDay * hoursPerShift *
/// efficiencyFactor) feeds capacity-scheduling-engine.ts; this table has no
/// opinion on scheduling itself, only on how much a work center can do per
/// day.
model WorkCenter {
  id               String   @id @default(cuid())
  name             String
  /// Ecosystem audit 2026-10-30: which site this machine group's capacity
  /// belongs to. Null means ungrouped — the single-site deployment shape
  /// this table shipped with (ADR-044's "optional even when its own module
  /// is on" reasoning, the same `OrgUnit.nodeId`/`retailBrandId` already
  /// apply) — never backfilled to a guessed unit on an existing deployment.
  orgUnitId        String?
  machineCount     Int      @default(1)
  shiftsPerDay     Int      @default(1)
  hoursPerShift    Int      @default(8)
  /// 0–1, e.g. 0.85 = 85% efficiency. Never 0 — capacity-scheduling-engine.ts
  /// falls back to 1.0 for a work center with none, but this column itself
  /// defaults to a realistic 1.0, not 0.
  efficiencyFactor Float    @default(1.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  stages  BomRecipeStage[]
  orgUnit OrgUnit?         @relation(fields: [orgUnitId], references: [id])

  @@index([isActive])
  @@index([orgUnitId])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/production's
/// capacity-scheduling and bom-yield engines): one sequential production
/// step for a recipe — unifies "routing step" (capacity scheduling needs a
/// work center, setup/run time) and "yield stage" (yield calc needs a
/// scrap rate) into one row per step, rather than two parallel "stage"
/// concepts for the same recipe.
model BomRecipeStage {
  id                   String  @id @default(cuid())
  recipeId             String
  stepNumber           Int
  operationName        String
  workCenterId         String?
  setupTimeMinutes     Int     @default(0)
  runTimeMinutesPerUnit Int    @default(0)
  /// Basis points scrapped AT this stage, independent of the recipe-level
  /// `wastageBps` used for the single-level cost rollup — this is the
  /// multi-stage, compounding scrap rate `calculateMultiStageYield` needs.
  scrapBps             Int     @default(0)

  recipe     BomRecipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  workCenter WorkCenter? @relation(fields: [workCenterId], references: [id])

  @@unique([recipeId, stepNumber])
  @@index([workCenterId])
}

model BomComponent {
  id            String @id @default(cuid())
  recipeId      String
  rawMaterialId String

  /// BASE units of the raw material consumed per outputQuantity finished units.
  quantityBase Int
  /// Overrides BomRecipe.wastageBps for this line. Null = inherit.
  wastageBps   Int?
  isOptional   Boolean @default(false)
  note         String?
  order        Int     @default(0)

  recipe      BomRecipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([recipeId, rawMaterialId])
  @@index([rawMaterialId])
}

/// One production run: the recipe was run N times, consuming raw stock and
/// crediting finished stock, both through InventoryService.move()/moveMany()
/// in the SAME transaction as this row (production.service.ts, WO-C.3). A
/// run is ledger history — SNAPSHOTS its costs (Rule 7) so a later recipe
/// edit or raw-material cost change never rewrites what this batch actually
/// cost. Deletion is not supported; a correction is a reversing adjustment
/// through the normal inventory screen.
model BomProductionRun {
  id     String @id @default(cuid())
  number String @unique

  recipeId  String
  variantId String

  /// How many times the recipe was run.
  runs             Int @default(1)
  /// runs * recipe.outputQuantity at the time of this run.
  quantityProduced Int

  /// SNAPSHOTS. A later recipe edit or raw-material cost change must not
  /// rewrite what this batch cost to make.
  materialCost     Int
  labourCost       Int
  overheadCost     Int
  /// round((materialCost + labourCost + overheadCost) / quantityProduced).
  producedUnitCost Int

  notes      String?
  operatorId String?
  producedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// WO-23.3 (RETAIL-ERP.md R13/R8, ADR-021). Which tier this run belongs
  /// to. Defaults to BRAND, same reasoning as PurchaseOrder.scopeLevel.
  scopeLevel   ScopeLevel @default(BRAND)
  /// This node's own identifier (AppConfigService.nodeId) at run time — a
  /// bare string, never a Node row FK. Null for a run recorded before this
  /// column existed.
  originNodeId String?
  /// Where this run actually happened — a WAREHOUSE/PRODUCTION Location
  /// (R13). Bare scalar, no `@relation`, matching GoodsReceipt.locationId's
  /// own decoupling reasoning. Resolves to
  /// InventoryService.defaultLocationId() when the caller does not name
  /// one, matching every run before this column existed.
  locationId   String

  /// 71-recipe-batch-traceability.md, DECISIONS.md ADR-068. The lot the
  /// FINISHED output of this run belongs to — created at the moment of
  /// production, a production run being the other legitimate origin of a
  /// new lot besides a purchase (doc 32's own `Lot.sourceReceiptId`). Null
  /// when the output variant isn't lot-tracked (`ProductVariant.lotTracked`).
  outputLotId String?

  recipe    BomRecipe           @relation(fields: [recipeId], references: [id])
  variant   ProductVariant      @relation("BomProducedVariant", fields: [variantId], references: [id])
  operator  User?               @relation("BomProductionOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  lines     BomProductionLine[]
  outputLot Lot?                @relation("BomOutputLot", fields: [outputLotId], references: [id])

  @@index([producedAt])
  @@index([scopeLevel])
  @@index([locationId])
  @@index([recipeId])
  @@index([variantId])
  @@index([outputLotId])
}

/// One raw-material line consumed by a production run — the same SNAPSHOT
/// discipline as the run itself.
model BomProductionLine {
  id    String @id @default(cuid())
  runId String

  rawMaterialId String
  /// The raw material's own variant, denormalised so the ledger join is
  /// direct — not a Prisma relation, deliberately: this is a read
  /// convenience copied from RawMaterial.variantId at write time, never
  /// itself the source of truth.
  variantId     String

  /// Base units actually consumed, wastage included.
  quantityBase Int
  /// Snapshot of the raw material's costPrice at run time, paisa per base unit.
  unitCost     Int
  lineCost     Int

  run            BomProductionRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial            @relation(fields: [rawMaterialId], references: [id])
  lotAllocations BomProductionLineLot[]

  @@index([runId])
  @@index([rawMaterialId])
}

/// 71-recipe-batch-traceability.md, DECISIONS.md ADR-068. One row per input
/// lot actually drawn on by one production line — the same "join a recall
/// query walks" role doc 32's own LotAllocation already plays for an
/// ordinary stock movement, extended to a production consumption. Nullable
/// on the BomProductionLine side: a raw material with no Lot rows at all
/// (never received through a lot-tracked goods receipt) legitimately has
/// none.
model BomProductionLineLot {
  id               String @id @default(cuid())
  productionLineId String
  lotId            String
  quantityBase     Int

  productionLine BomProductionLine @relation(fields: [productionLineId], references: [id], onDelete: Cascade)
  lot            Lot               @relation(fields: [lotId], references: [id])

  @@index([productionLineId])
  @@index([lotId])
}

// A BPMN visual workflow engine, built by explicit owner override (ADR-026)
// — architecture-patterns/142-bpmn-visual-workflow-engine.md (WO-142.3). A
// view over ApprovalChain/ApprovalStep (approvals.prisma), never a second
// execution runtime: compiledSteps is compiled at save time by
// compileBpmnToApprovalSteps() and is the ONLY thing ApprovalService ever
// reads; diagramXml is a display/authoring artifact, replayed back into the
// editor on reopen, never interpreted at runtime. No organizationId
// (ADR-044/ADR-040): this deployment IS the tenant.

model BpmnWorkflowDefinition {
  id            String              @id @default(cuid())
  /// One authored diagram per subject type — reuses doc 63's own enum,
  /// never a parallel one.
  subjectType   ApprovalSubjectType @unique
  diagramXml    String
  /// CompiledApprovalStep[]: { stepOrder, approverRoleId?, approverUserId? }
  compiledSteps Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// Cart. Guest carts are keyed by an opaque token held in a cookie and merged
// into the account on login — a COD store cannot afford to force signup before
// checkout.

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  /// MarketingAutomationCron's dedup flags (marketing.abandoned_cart_reminder,
  /// then marketing.abandoned_cart_incentive) — logged-in carts only, since a
  /// guest cart has no email captured until checkout to send either to.
  /// Placing an order empties CartItem but leaves this row, so these persist
  /// past a converted cart; the cron's own `items: { some: {} }` filter is
  /// what actually excludes a converted cart, not these fields.
  reminderSentAt       DateTime?
  incentiveSentAt      DateTime?

  stockHolds CartStockHold[]
  /// WO-8.5 — the 1-hour first touch the doc's 3-step sequence (1h/24h/72h)
  /// was missing. A soft nudge, never an incentive (doc: "sending one
  /// immediately trains customers to abandon").
  firstTouchSentAt     DateTime?
  /// The single-use code minted for this cart's incentiveSentAt send —
  /// nullable because most carts convert before ever reaching that stage.
  /// PromoCode lives in promotions.prisma; the relation crosses that module
  /// boundary the same sanctioned way orders -> promotions already does
  /// (KNOWN_MODULE_COUPLINGS), via PromotionsService.createPromoCode(), not
  /// a raw write into a table `marketing` does not own.
  incentivePromoCodeId String?

  /// WO-8.5 — a guest checkout has no account to hold a phone or a consent
  /// flag, so both are captured onto the cart itself the moment the
  /// customer types a phone number at checkout (CartController's own
  /// guest-contact endpoint), before the cart can be abandoned. Normalised
  /// E.164 (packages/shared/normalizePhone), same as Contact.phoneE164 and
  /// Order.guestPhone.
  guestPhone              String?
  /// Null = no consent given (or not yet asked). Set = the customer
  /// explicitly opted in to a marketing SMS/WhatsApp touch on this cart —
  /// checked again at send time against PhoneOptOut (marketing.prisma),
  /// since consent can be withdrawn after it was given.
  guestMarketingConsentAt DateTime?

  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incentivePromoCode PromoCode? @relation(fields: [incentivePromoCodeId], references: [id], onDelete: SetNull)
  items              CartItem[]
  /// orders.prisma (WO-8.5) — revenue-attribution: which order (if any) this
  /// cart converted into, for the recovered-revenue report.
  convertedOrders    Order[]

  @@index([userId])
  @@index([expiresAt])
  @@index([guestPhone])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int    @default(1)

  /// Set when the customer ticked "get it stitched" on unstitched fabric.
  /// garmentTypeId is what is being made, and what the stitching is priced from;
  /// stitchingServiceId points at a STITCHING_SERVICE product, an optional
  /// premium make-up that overrides the garment's own price.
  garmentTypeId        String?
  stitchingServiceId   String?
  measurementProfileId String?
  stitchingNotes       String?
  /// field key -> value, typed straight into the panel. Guests have no profile
  /// to pick, so this carries the measurements when measurementProfileId is null.
  measurementValues    Json?
  /// Option group key -> the customer's own words for that design area.
  customDesignText     Json?
  /// Which standard size (XS-XXL) the customer picked, when they used the RTW size chart instead of typing measurements. Kept for tailor/support reference; measurementValues still carries the actual numbers used.
  sizeToken            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart             Cart                      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stitchingService Product?                  @relation("CartItemStitchingService", fields: [stitchingServiceId], references: [id], onDelete: SetNull)
  stitchingOptions CartItemStitchingOption[]

  @@index([cartId])
}

model CartItemStitchingOption {
  cartItemId String
  optionId   String

  cartItem CartItem        @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   StitchingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([cartItemId, optionId])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/cart): a short-lived
/// reservation against a variant's stock, held by a cart while the shopper
/// is between add-to-cart and checkout — a real gap this module never had
/// (`CartLineView.exceedsStock` is only a display warning today; nothing
/// actually reserves the stock a cart line claims). Persisted, unlike the
/// in-memory map core-newax's own extraction used — this server restarts
/// and runs more than one instance, so an in-memory hold would silently
/// vanish or disagree between instances; this table is the one source of
/// truth either way. **Not yet wired into addItem()'s stock check** — that
/// is a real product decision (does a SOFT hold reduce what other
/// shoppers see as available? how does it interact with
/// orders.allowBackorder?) this merge does not make unilaterally. Built
/// and tested as its own capability; wiring it into the live add-to-cart
/// path is the next, separate step.
enum CartStockHoldTier {
  SOFT
  HARD
}

enum CartStockHoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONSUMED
}

model CartStockHold {
  id           String              @id @default(cuid())
  cartId       String
  variantId    String
  quantity     Int
  tier         CartStockHoldTier   @default(SOFT)
  status       CartStockHoldStatus @default(ACTIVE)
  heartbeatAt  DateTime            @default(now())
  expiresAt    DateTime
  renewCount   Int                 @default(0)
  maxRenewals  Int                 @default(5)
  createdAt    DateTime            @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([status, expiresAt])
}

// Catalog: categories, products, variants, images.
//
// Two things to know before changing anything here:
//   1. Money is integer paisa (Rs 3,499 -> 349900). Never a float.
//   2. Customer-facing text is never a column — it lives in *Translation rows,
//      one per locale, so adding a language needs no migration.

enum ProductKind {
  GOODS // physical goods (electronics, grocery, etc)
  SERVICE // non-physical services
  DIGITAL // software, licenses, digital downloads
  STITCHED // legacy: ready to wear
  UNSTITCHED // legacy: fabric, optionally stitched to measure
  STITCHING_SERVICE // legacy: the tailoring itself, sold as a product
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// Short SKU-template code, e.g. "LWN". Uppercase, slug-derived by default,
  /// editable. WO-3.3, 03-variants-sku-seo.md.
  code      String?
  parentId  String?
  imageUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([isActive])
}

/// 47-preconfigured-sector-taxonomy.md — a named, versioned starter
/// category tree for one vertical, seeded (never user-created through the
/// admin UI). Applying one creates ordinary Category rows; this row itself
/// is never referenced by the categories it produces, per this document's
/// own "undoing a preset is deleting the categories it created, like any
/// other category deletion" position.
model CategoryPreset {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  /// { name, nameUr?, children: [...] } recursively — never compiled into
  /// application code, so a tenth vertical's preset is a seed-data change.
  treeJson    Json
  description String?
}

/// A label a product is sold under. Managed from /admin/brands rather than
/// typed per product: `Product.brand` used to be free text, so "Gul Ahmed",
/// "gul ahmed" and "Gul  Ahmed" were three different brands as far as any
/// filter or report was concerned.
model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// Brand mark, shown on the storefront's brand listing.
  logoUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BrandTranslation[]
  products     Product[]

  @@index([isActive])
}

/// House Rule 6: a customer-facing name is a translation row, not a column.
/// Most brand names are proper nouns that read the same in both languages,
/// but a shop writing them in Urdu script has somewhere to put that.
model BrandTranslation {
  id          String  @id @default(cuid())
  brandId     String
  locale      String // "en" | "ur"
  name        String
  description String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
}

model CategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      String // "en" | "ur"
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id         String        @id @default(cuid())
  slug       String        @unique
  kind       ProductKind
  status     ProductStatus @default(DRAFT)
  categoryId String?

  /// Price in paisa. For a STITCHING_SERVICE this is the base stitching fee.
  basePrice      Int
  /// Optional "was" price for showing a discount, in paisa.
  compareAtPrice Int?

  brandId String?
  fabric  String? // lawn, chiffon, khaddar, linen…
  season  String? // summer, winter, festive
  tags    String[] @default([])

  /// Per-product SKU-template code, e.g. "3PC-EMB". Defaults from the slug,
  /// editable. WO-3.3, 03-variants-sku-seo.md.
  code String?

  /// SEO section, WO-3.7. `false` (default) means indexable — most products
  /// never need to touch this.
  noindex           Boolean @default(false)
  /// Rare override for a canonical URL other than this product's own page
  /// (e.g. a duplicate listing that should point elsewhere). Null (the
  /// common case) means "canonical to self", computed at render time.
  canonicalOverride String?

  /// UNSTITCHED only: how many pieces the fabric contains (1/2/3-piece) and
  /// how many metres, both shown on the product page.
  pieceCount   Int?
  fabricMeters Float?

  /// UNSTITCHED only: whether "get it stitched" is offered on this product.
  stitchingAvailable Boolean @default(false)

  /// A repeat-buy item worth nudging customers to reorder — set by staff.
  /// Read by MarketingAutomationCron (marketing.replenishment_reminder) on a
  /// single global cadence (Setting marketing.replenishment_reminder_days),
  /// not a per-product one.
  isConsumable Boolean @default(false)

  /// STITCHING_SERVICE only: which garment this service stitches.
  garmentTypeId String?

  /// WO-6.1's own closing line — a per-product handling fee added at
  /// checkout on top of the zone/method rate. Null (the default) costs
  /// nothing extra to pack.
  shippingClassId String?

  /// Sort weight for merchandising; higher floats to the top of listings.
  featuredRank Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category              Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                 Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// fulfilment.prisma (WO-6.1) — both core, same idiom as category/brand above.
  shippingClass         ShippingClass?        @relation(fields: [shippingClassId], references: [id], onDelete: SetNull)
  translations          ProductTranslation[]
  variants              ProductVariant[]
  options               ProductOption[]
  images                ProductImage[]
  /// UNSTITCHED only: the garments this fabric may be stitched into.
  garmentTypes          ProductGarmentType[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  /// Carts/orders where this product was chosen as the stitching service.
  cartItemsAsService    CartItem[]            @relation("CartItemStitchingService")
  orderItemsAsService   OrderItem[]           @relation("OrderItemStitchingService")
  /// collections.prisma section below (WO-8.2).
  collectionMemberships CollectionProduct[]
  /// Phase 7 WO-7.5 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
  reviews               Review[]
  wishlistItems         WishlistItem[]
  /// Phase 9 (09-ai-layer.md) — this product's own pending AI-generated copy.
  aiSuggestions         ProductAiSuggestion[]
  sizeBias              ProductSizeBias?
  reviewSummary         ProductReviewSummary?
  /// The "also/complete the look" side of a cross-sell pair — see
  /// ProductCrossSell's own doc comment for why this is two relations.
  crossSellsFrom        ProductCrossSell[]    @relation("CrossSellSource")
  crossSellsTo          ProductCrossSell[]    @relation("CrossSellTarget")

  @@index([status, kind])
  @@index([categoryId])
  @@index([featuredRank])
  @@index([createdAt])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String
  name             String
  description      String?
  careInstructions String?
  metaTitle        String?
  metaDescription  String?
  /// The term the SEO checklist scores this locale's copy against — never
  /// shown to a customer. WO-3.7, 03-variants-sku-seo.md.
  focusKeyword     String?

  /// 166-unified-product-reference-registry.md, WO-166.4. Set only when this
  /// row's name/description/careInstructions track a
  /// `GlobalProductReference` (the platform app's shared registry) — never
  /// set by an ordinary hand-typed edit. `ProductAdminService.update()`
  /// clears both fields back to null the moment a staff member edits this
  /// row directly through the normal product form, which is what makes a
  /// later local edit "a deliberate override... never silently clobbered"
  /// (doc 166 §2): once null, no future sync delivery for this locale is
  /// applied until the tenant re-adopts a reference explicitly.
  sourcedFromGlobalReferenceId  String?
  /// The reference's own `updatedAt` as of the last applied sync — compared
  /// against an incoming delivery's `updatedAt` so a redelivered (at-least-
  /// once) sync is a no-op rather than a redundant rewrite.
  sourcedFromReferenceUpdatedAt DateTime?

  /// WO-8.3 (08-content-marketing-search.md). Precomputed by
  /// SearchService.reindexProduct() on every write to this row or to the
  /// product/category/brand/tags it's derived from — a `VariantSalesStat`-
  /// style cache, not a live-computed column. `Unsupported`: Prisma has no
  /// tsvector type, so every read and write of it goes through raw SQL in
  /// SearchService, never the generated client. Locale-aware: 'english' text
  /// search config for `en`, 'simple' for `ur` — Postgres ships no Urdu
  /// stemmer, and 'simple' (token match, no stemming) is the honest choice
  /// over silently running Urdu text through the English one.
  searchVector Unsupported("tsvector")?

  /// WO-9.5 (09-ai-layer.md). OpenAI text-embedding-3-small's own dimension
  /// (1536) — re-embedded by SearchReindexListener alongside searchVector, on
  /// the SAME DomainEvent.ProductChanged, so the two never drift out of sync.
  /// Null whenever no embedding-capable AiProvider is configured; hybrid
  /// search falls back to ts_rank/trigram alone in that case (builds on
  /// Phase 8, never replaces it).
  embedding Unsupported("vector(1536)")?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([name])
}

model ProductVariant {
  id                String  @id @default(cuid())
  productId         String
  sku               String  @unique
  size              String? // S/M/L or "Free size"
  color             String?
  colorHex          String?
  /// Cached display string, "Medium / Ferozi", joining ProductVariantOptionValue
  /// labels in option order. Denormalised deliberately — lists, cart lines and
  /// order snapshots must not need three joins. WO-3.1, 03-variants-sku-seo.md.
  label             String?
  /// Overrides Product.basePrice when set, in paisa.
  priceOverride     Int?
  stock             Int     @default(0)
  lowStockThreshold Int     @default(3)
  isActive          Boolean @default(true)

  /// Weighted average cost in paisa. 0 means "never received against a PO" (UNKNOWN), not free.
  costPrice           Int       @default(0)
  reorderPoint        Int?
  reorderQuantity     Int?
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  lastReceivedAt      DateTime?
  barcode             String?   @unique
  /// True once a human has hand-edited this SKU — the generator then never
  /// silently rewrites it again. WO-3.3, 03-variants-sku-seo.md.
  skuIsManual         Boolean   @default(false)

  /// True when this variant is made in-house from a BillOfMaterial (production
  /// module) rather than bought in from preferredSupplier. A variant is one or
  /// the other, never both — enforced in service code, not the schema, since
  /// the BillOfMaterial relation itself lives in the production module's own
  /// schema file (production.prisma) and must not be typed here.
  producedInHouse Boolean @default(false)

  /// 32-lots-batch-expiry-fefo.md, DECISIONS.md ADR-068. Off by default,
  /// and off means byte-identical to today's behavior — only a variant a
  /// merchant explicitly flags (perishables, pharma, anything with a real
  /// expiry) gains the extra receiving/FEFO step. A category-level default
  /// is a deliberately deferred refinement (see the ADR); this flag is the
  /// per-SKU override every deployment can use today.
  lotTracked Boolean @default(false)

  /// 158-serialized-unit-tracking.md, DECISIONS.md ADR-068. Off by default;
  /// the same "absent collaborator" discipline as lotTracked above — a
  /// t-shirt or a bag of rice never asks for a serial number, only a
  /// variant a merchant explicitly flags (phones, laptops, appliances,
  /// anything IMEI-regulated or individually warrantied).
  tracksSerials  Boolean @default(false)
  /// Null = no warranty tracked for this variant. Used only to compute
  /// `getUnitHistory()`'s own read-only warrantyEndsOn (soldOn + this) —
  /// never a claims workflow of its own (out of scope, doc 158).
  warrantyMonths Int?

  /// Null = the store's default tax class (Setting `tax.default_class`).
  /// Most products never set this. Tax is core (MULTI-SECTOR.md), so this
  /// relation is a normal core-to-core reference, not a pack boundary.
  taxClassId String?
  taxClass   TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  salesStat VariantSalesStat?

  /// bom.prisma's RawMaterial (WO-C.1) — set only when this variant IS a raw
  /// material, not one built from them.
  rawMaterial  RawMaterial?
  /// bom.prisma's BomRecipe (WO-C.2) — set only when this variant IS BUILT
  /// FROM raw materials. A variant is at most one of rawMaterial/bomRecipe,
  /// enforced in recipe.service.ts (no nesting in v1).
  bomRecipe    BomRecipe?
  /// Every BomProductionRun that has credited this variant's stock (WO-C.3).
  producedRuns BomProductionRun[] @relation("BomProducedVariant")

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product             Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  images              ProductImage[]
  cartItems           CartItem[]
  optionValues        ProductVariantOptionValue[]
  orderItems          OrderItem[]
  supplierProducts    SupplierProduct[]
  stockAdjustments    StockAdjustment[]
  stockMovements      StockMovement[]
  locationStocks      VariantLocationStock[]
  stockVariances      StockVariance[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  stockCountLines     StockCountLine[]
  requisitionLines    RequisitionLine[]
  spotCheckLines      SpotCheckLine[]
  billOfMaterial      BillOfMaterial?
  bomComponentOf      BillOfMaterialLine[]        @relation("BomComponent")
  workOrders          WorkOrder[]
  /// Phase 7 WO-7.6 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
  wishlistItems       WishlistItem[]
  backInStockRequests BackInStockRequest[]
  /// Ecosystem audit 2026-10-29 (merged from @newaxhq/cart).
  stockHolds          CartStockHold[]
  /// Phase 9 (09-ai-layer.md) — inventory.prisma's own cache/advisory rows.
  forecast            VariantForecast?
  markdownSuggestions MarkdownSuggestion[]
  /// 32-lots-batch-expiry-fefo.md / 158-serialized-unit-tracking.md.
  lots                Lot[]
  serializedUnits     SerializedUnit[]

  @@index([productId])
  @@index([stock])
}

/// One entry per change to ProductVariant.stock, so "why is stock 4" has an
/// answer without an audit table bolted on after the fact.
model StockAdjustment {
  id             String   @id @default(cuid())
  variantId      String
  /// Positive = stock added, negative = stock removed. Never zero.
  delta          Int
  /// Stock level AFTER this adjustment, so history reads without replaying deltas.
  resultingStock Int
  reason         String // "restock" | "correction" | "damaged" | "sold_offline" | "other"
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  /// Deprecated by `translations` (WO-3.6, 03-variants-sku-seo.md) — alt text
  /// is customer-facing (House Rule 6) so it needs one row per locale.
  /// Additive only: kept, unwritten, so nothing that still reads it breaks.
  alt       String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  /// 166-unified-product-reference-registry.md, WO-166.4. Set only on a row
  /// written by `ProductReferenceSyncService` — never by the ordinary image
  /// upload path. `url` on such a row points directly at the platform app's
  /// own shared storage, never a locally re-uploaded copy (doc 166's own
  /// "one buffer, many readers" saving). A sync delivery only ever deletes
  /// and recreates rows carrying this same reference id, so a staff-uploaded
  /// image (this column null) is never touched by a sync.
  sourcedFromGlobalReferenceId String?

  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  translations  ProductImageTranslation[]
  aiSuggestions ProductAiSuggestion[]

  @@index([productId, order])
}

/// Alt text per locale. A filename is not a description in any language, so
/// this starts empty rather than lying — see the migration's backfill.
model ProductImageTranslation {
  id      String @id @default(cuid())
  imageId String
  locale  String
  alt     String

  image ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, locale])
}

/// Which garments a given unstitched fabric can be made into.
model ProductGarmentType {
  productId     String
  garmentTypeId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, garmentTypeId])
}

enum OptionDisplay {
  BUTTON // "S M L XL"
  DROPDOWN // long lists
  SWATCH // colour or fabric image
  TEXT // free entry, e.g. a monogram
}

/// A dynamic option axis a product varies along: "Size", "Colour", "Storage".
/// WO-3.1 (03-variants-sku-seo.md, Blocker B2) — additive alongside
/// ProductVariant's size/color/colorHex columns; those stay until a later,
/// separate release both writes and reads exclusively go through this model
/// (00-HOUSE-RULES.md §4, expand/contract). Do not drop them here.
model ProductOption {
  id        String        @id @default(cuid())
  productId String
  /// Stable machine key: "size", "storage". Never shown to a customer.
  key       String
  display   OptionDisplay @default(BUTTON)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductOptionTranslation[]
  values       ProductOptionValue[]

  @@unique([productId, key])
  @@index([productId, order])
}

model ProductOptionTranslation {
  id       String @id @default(cuid())
  optionId String
  locale   String
  label    String

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

/// A specific value on an option axis: "M", "Ferozi", "128GB".
model ProductOptionValue {
  id        String  @id @default(cuid())
  optionId  String
  key       String
  /// Colour swatch.
  swatchHex String?
  /// Fabric/pattern swatch image, when a hex cannot describe it.
  swatchUrl String?
  order     Int     @default(0)

  option       ProductOption                   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  translations ProductOptionValueTranslation[]
  variantLinks ProductVariantOptionValue[]

  @@unique([optionId, key])
  @@index([optionId, order])
}

model ProductOptionValueTranslation {
  id      String @id @default(cuid())
  valueId String
  locale  String
  label   String

  value ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
}

/// The join that DEFINES a variant: one row per option axis per variant. The
/// composite id guarantees a variant can never carry two values for the same
/// axis (e.g. both "Red" and "Blue" for "Colour" at once).
model ProductVariantOptionValue {
  variantId String
  optionId  String
  valueId   String

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([valueId])
}

/// Store-level, reusable option axis — "Size: XS/S/M/L/XL/XXL" typed once
/// under Catalogue -> Options & attributes instead of on every product. A
/// product instantiates from a template by copying its values into its own
/// ProductOption/ProductOptionValue rows; editing the template afterwards
/// never silently changes a live product. WO-3.1, 03-variants-sku-seo.md.
model OptionTemplate {
  id        String        @id @default(cuid())
  key       String        @unique
  display   OptionDisplay @default(BUTTON)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  translations OptionTemplateTranslation[]
  values       OptionTemplateValue[]

  @@index([order])
}

model OptionTemplateTranslation {
  id         String @id @default(cuid())
  templateId String
  locale     String
  label      String

  template OptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, locale])
}

model OptionTemplateValue {
  id         String  @id @default(cuid())
  templateId String
  key        String
  swatchHex  String?
  swatchUrl  String?
  order      Int     @default(0)

  template     OptionTemplate                   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  translations OptionTemplateValueTranslation[]

  @@unique([templateId, key])
  @@index([templateId, order])
}

model OptionTemplateValueTranslation {
  id      String @id @default(cuid())
  valueId String
  locale  String
  label   String

  value OptionTemplateValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
}

/// A storefront path that now 301s somewhere else — created automatically
/// when a live product/category slug changes, or entered by hand (including
/// a CSV import when migrating an old site). WO-3.9, 03-variants-sku-seo.md.
model Redirect {
  id          String   @id @default(cuid())
  /// Path only, no host, no locale prefix: "/product/old-slug". The locale
  /// segment is stripped before lookup and reapplied to `toPath` on 301,
  /// since a slug is shared across locales (Product.slug is not per-locale).
  fromPath    String   @unique
  toPath      String
  /// 301 permanent or 302 temporary.
  statusCode  Int      @default(301)
  /// True when created automatically by a slug change.
  isAutomatic Boolean  @default(false)
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isAutomatic])
}

// Collections and merchandising. WO-8.2,
// docs/implementation/content-marketing-search/08-content-marketing-search.md.
//
// Separate from the Category tree deliberately (the doc's own words): a
// Category is where a product structurally lives; a Collection is a curated
// or rule-based merchandising surface — a lookbook, a seasonal drop, a
// "complete the look" set — that cuts across categories.

enum CollectionSortStrategy {
  MANUAL
  BEST_SELLING
  NEWEST
  PRICE_ASC
  PRICE_DESC
  /// Sort by margin (basePrice - ProductVariant.costPrice). Needs Phase 1's
  /// cost data, which is exactly why most platforms cannot offer this.
  MARGIN
}

model Collection {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  /// Null: manual/curated membership only (CollectionProduct rows). Non-null:
  /// evaluated at read time by CollectionsService.resolveRuleProducts() —
  /// shape is `CollectionRule` in packages/shared/src/collection-rules.ts.
  /// Nightly materialisation for a very large catalogue is named and
  /// sequenced as its own follow-on in the Phase 8 status note, not built
  /// here — read-time evaluation is the honest, correct choice at this
  /// catalogue's size today.
  rule         Json?
  sortStrategy CollectionSortStrategy @default(MANUAL)
  imageUrl     String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  translations CollectionTranslation[]
  products     CollectionProduct[]

  @@index([isActive])
}

model CollectionTranslation {
  id              String  @id @default(cuid())
  collectionId    String
  locale          String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
}

/// Manual membership and manual sort order. Unused for a rule-based
/// collection — resolveRuleProducts() computes membership from
/// Collection.rule at read time instead of reading this table.
model CollectionProduct {
  collectionId String
  productId    String
  order        Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

// ─── Phase 9 — AI layer (09-ai-layer.md) ────────────────────────────────────
// The two rules that govern every model below: everything AI-generated is a
// DRAFT a human confirms (never written to the real Product/ProductImage
// columns until APPROVED), and every row here traces back to an AiUsageLog
// entry for cost accounting — see core.prisma's own comment on that model.

enum AiSuggestionKind {
  ALT_TEXT
  META_TITLE
  META_DESCRIPTION
  DESCRIPTION
  CARE_INSTRUCTIONS
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// WO-9.1. One row per (product or image, kind, locale) draft. ALT_TEXT sets
/// `imageId`; every other kind is product-level and leaves it null.
/// Approving a suggestion is what writes the real ProductTranslation/
/// ProductImageTranslation column — see ProductAiService.approve().
model ProductAiSuggestion {
  id            String             @id @default(cuid())
  productId     String
  imageId       String?
  kind          AiSuggestionKind
  locale        String
  suggestedText String
  status        AiSuggestionStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status, createdAt])
}

/// WO-9.2. One row per product, refreshed nightly from Review.fitFeedback —
/// "a garment where 40% say too small gets its recommendation shifted up a
/// size" (the doc's own words). `shift` is what SizeRecommendationService
/// adds to the arithmetic size match; it is never itself the recommendation.
model ProductSizeBias {
  productId     String   @id
  tooSmallPct   Float    @default(0)
  trueToSizePct Float    @default(0)
  tooLargePct   Float    @default(0)
  sampleSize    Int      @default(0)
  /// -1 = recommend one size down, 0 = no adjustment, +1 = one size up.
  shift         Int      @default(0)
  computedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// WO-9.6. A directed edge, product -> relatedProduct — "customers who
/// bought this kameez also bought this dupatta". Two relations on Product
/// (crossSellsFrom/crossSellsTo) because the edge is directional: a manual
/// "complete the look" pairing set from the kameez's own admin screen does
/// not imply the reverse is equally relevant from the dupatta's page.
/// MANUAL rows always outrank CO_OCCURRENCE/EMBEDDING ones at read time
/// (RecommendationsService's own rule, not encoded here) — "a merchandiser's
/// curated pairing beats the algorithm often enough that removing the
/// control is a mistake" (the doc's own words).
enum ProductCrossSellKind {
  MANUAL
  CO_OCCURRENCE
  EMBEDDING
}

model ProductCrossSell {
  id               String               @id @default(cuid())
  productId        String
  relatedProductId String
  kind             ProductCrossSellKind
  order            Int                  @default(0)
  createdAt        DateTime             @default(now())

  product        Product @relation("CrossSellSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("CrossSellTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([relatedProductId])
}

/// 150-product-kitting-bundles.md — a sellable shell over existing
/// variants, never a new physical item: selling one is entirely expressed
/// as decrementing its components (BundlesService.sellBundle()), and its
/// own "stock" is definitionally computed, never stored (see
/// bundleAvailableStock()). No `organizationId` column, the same deviation
/// from this document's own sketch pricing.prisma already made for the
/// same reason: `Category`/`Product` (what the doc claims this mirrors)
/// carry no such column either — this codebase is one Organization per
/// deployment.
model ProductBundle {
  id        String   @id @default(cuid())
  /// The bundle's own sellable identity — has its own SKU, its own listing,
  /// its own price via resolvePrice() (doc 146) — but produces NO stock row
  /// of its own.
  variantId String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components BundleComponent[]
}

model BundleComponent {
  id                 String @id @default(cuid())
  bundleId           String
  componentVariantId String
  quantity           Int    @default(1)

  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, componentVariantId])
}

// Content: pages, blog posts, banners, menus. WO-8.1,
// docs/implementation/content-marketing-search/08-content-marketing-search.md.
//
// Same conventions as catalog.prisma: customer-facing text lives in
// *Translation rows, one per locale (House Rule 6), never a column. A page
// or post body is an ordered array of typed blocks (rich text, image,
// product grid, banner, FAQ, video) rather than one rich-text blob — see
// `ContentBlock` in packages/shared/src/content-blocks.ts for the shape a
// `Json` body column here is expected to hold. A `richtext` block's `html`
// is sanitised before it is ever written (ContentService.sanitizeBlocks),
// so nothing downstream needs to sanitise again on render.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  /// Which storefront template renders this page. "default" is a plain
  /// content column; the apparel pack may add "landing" later without a
  /// migration — a new template is a value, not a schema change.
  template    String        @default("default")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  /// SEO section, matches Product.noindex (WO-3.7). False (default) means
  /// indexable and included in sitemap.ts.
  noindex     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations PageTranslation[]

  @@index([status])
  @@index([publishedAt])
}

model PageTranslation {
  id              String  @id @default(cuid())
  pageId          String
  locale          String
  title           String
  /// Ordered array of typed content blocks. See the file header.
  body            Json
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

model BlogPost {
  id           String        @id @default(cuid())
  slug         String        @unique
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  authorId     String?
  /// Free-text category, same idiom as Product.fabric/season — a taxonomy
  /// table is speculative until there are enough posts to need filtering it.
  category     String?
  tags         String[]      @default([])
  heroImageUrl String?
  noindex      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author       User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations BlogPostTranslation[]

  @@index([status, publishedAt])
  @@index([category])
}

model BlogPostTranslation {
  id              String  @id @default(cuid())
  blogPostId      String
  locale          String
  title           String
  body            Json
  /// Shown on the blog listing card; falls back to a truncation of the
  /// first rich-text block's plain text when null.
  excerpt         String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
}

model Banner {
  id           String    @id @default(cuid())
  /// A fixed, code-known slot — see BANNER_PLACEMENTS in
  /// packages/shared/src/content-blocks.ts. New placements are a shared-
  /// constant change plus the storefront component that reads the slot, not
  /// a migration; validated against that list in the DTO, not the schema,
  /// same reasoning as Page.template above.
  placementKey String
  imageUrl     String
  linkUrl      String?
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  translations BannerTranslation[]

  @@index([placementKey, isActive, order])
}

model BannerTranslation {
  id       String  @id @default(cuid())
  bannerId String
  locale   String
  headline String?
  subtext  String?
  /// Required for a11y whenever headline is null — enforced in the DTO.
  altText  String?

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
}

/// A tree per named slot (`menuKey`: "footer_help", "footer_about", …) — see
/// MENU_KEYS in packages/shared/src/content-blocks.ts. The header's and the
/// legal-links column's own primary nav stay as they are (routes.ts is the
/// document of record for those and several are permission/tier-gated in
/// code); this model drives the two additive CMS-editable footer columns
/// documented in the Phase 8 status note, not a wholesale nav replacement.
model MenuItem {
  id        String   @id @default(cuid())
  menuKey   String
  parentId  String?
  /// An internal path ("/pages/about-us") or an absolute external URL.
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       MenuItem?             @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     MenuItem[]            @relation("MenuItemTree")
  translations MenuItemTranslation[]

  @@index([menuKey, parentId, order])
}

model MenuItemTranslation {
  id         String @id @default(cuid())
  menuItemId String
  locale     String
  label      String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
}

// Core: identity, addresses, runtime settings, audit trail and the event outbox.
// Every other module may reference these; they reference no module.

enum UserRole {
  CUSTOMER
  STAFF
  TAILOR
  ADMIN
}

/// Which tier a FACT belongs to (RETAIL-ERP.md R8/R13, ADR-021). Lives here,
/// not in organization.prisma, so a scopeLevel column never makes an
/// always-on module (purchasing, bom, finance) schema-depend on the
/// off-by-default organization module. Same values as organization.prisma's
/// AdminScopeLevel (a GRANT's own scope) by design, deliberately not merged
/// with it — a grant and a fact's recorded scope are different concepts
/// that happen to share a vocabulary.
enum ScopeLevel {
  ORG
  BRAND
  BRANCH
}

model User {
  id                   String    @id @default(cuid())
  email                String?   @unique
  phone                String?   @unique // normalised E.164
  passwordHash         String?
  firstName            String?
  lastName             String?
  /// Free text, not an enum — never a fixed set a person has to fit into.
  gender               String?
  dateOfBirth          DateTime?
  avatarUrl            String?
  /// The old fixed-enum role. Superseded by `roleAssignments` (Role/
  /// UserRoleAssignment, below) — a user's *effective* permissions come
  /// from the roles they are assigned there, unioned, never from this
  /// column. Kept, unremoved, only as the seed's one-time migration source
  /// and as the default new signups get assigned into (`Customer`) — see
  /// role.service.ts. Nothing in PermissionsResolverService reads it.
  role                 UserRole  @default(CUSTOMER)
  isActive             Boolean   @default(true)
  emailVerifiedAt      DateTime?
  /// Set by GET /email/unsubscribe (a one-click, no-login link every
  /// automated marketing send carries). Checked before any marketing-purpose
  /// automation (MarketingAutomationCron) sends; never checked for
  /// transactional mail (order/payment/account), which isn't marketing.
  marketingEmailOptOut Boolean   @default(false)
  lastLoginAt          DateTime?
  /// The single sign-on identity linked to this account
  /// (access-control-identity/161-sso-identity-federation.md) —
  /// `<issuer>#<sub>`, because an OIDC `sub` is only unique within its own
  /// issuer. Null for a password-only account, which SSO leaves untouched.
  /// Indexed, not unique: sign-in resolves by email first; the index serves
  /// SsoService's refusal to link one external identity to a second account.
  ssoExternalId        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  addresses                         Address[]
  refreshTokens                     RefreshToken[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  /// Personal API keys this person issued — each one acts as them, capped
  /// live by their permissions (access-control-identity/163-personal-api-keys.md).
  apiKeys                           ApiKey[]                    @relation("ApiKeyOwner")
  /// Keys this person revoked as someone else's administrator, or by
  /// deactivating their owner.
  apiKeysRevoked                    ApiKey[]                    @relation("ApiKeyRevoker")
  carts                             Cart[]
  orders                            Order[]
  orderStatusEvents                 OrderStatusEvent[]
  auditLogs                         AuditLog[]
  contact                           Contact?                    @relation("ContactUser")
  identityVerification              IdentityVerification?
  ownedContacts                     Contact[]                   @relation("ContactOwner")
  ownedLeads                        Lead[]                      @relation("LeadOwner")
  interactions                      Interaction[]
  inboundEmailReplies               InboundEmailReply[]
  assignedFollowUps                 FollowUpTask[]              @relation("FollowUpAssignee")
  approvedPayments                  Payment[]                   @relation("PaymentApprover")
  segments                          Segment[]
  devices                           DeviceToken[]
  stockAdjustments                  StockAdjustment[]
  stockMovements                    StockMovement[]             @relation("StockMovementActor")
  permissionOverrides               UserPermission[]
  /// What this user's admin access is scoped to (RETAIL-ERP.md R10, WO-18.3)
  /// — empty for every deployment today. Model lives in organization.prisma
  /// (a togglable module), not here: this back-relation is the only mention
  /// of it core.prisma needs.
  adminScopes                       AdminScope[]
  /// Which named `Role` rows this user holds — plural, unioned (roles.ts).
  roleAssignments                   UserRoleAssignment[]
  purchaseOrdersCreated             PurchaseOrder[]             @relation("PurchaseOrderCreator")
  embeddedWidgetsCreated            EmbeddedWidget[]            @relation("EmbeddedWidgetCreator")
  microFrontendFragmentsRegistered  MicroFrontendFragment[]     @relation("MicroFrontendFragmentRegisteredBy")
  goodsReceiptsReceived             GoodsReceipt[]              @relation("GoodsReceiptReceiver")
  requisitionsRequested             PurchaseRequisition[]       @relation("RequisitionRequester")
  approvalStepsDecided              ApprovalStep[]              @relation("ApprovalStepDecider")
  stockCountsCreated                StockCount[]                @relation("StockCountCreator")
  stockCountsAssigned               StockCount[]                @relation("StockCountAssignee")
  workOrdersCreated                 WorkOrder[]                 @relation("WorkOrderCreator")
  expensesCreated                   Expense[]                   @relation("ExpenseCreator")
  bomRecipesCreated                 BomRecipe[]                 @relation("BomRecipeCreator")
  bomProductionRuns                 BomProductionRun[]          @relation("BomProductionOperator")
  policyQuarantinesResolved         PolicyQuarantine[]          @relation("PolicyQuarantineResolver")
  /// Payroll (docs/implementation/payroll/19-payroll.md) — one User is both the
  /// payee (compensationRates, leaveBalances, ...) and, for an ADMIN,
  /// possibly the actor who set a rate or decided a leave request; the two
  /// relation names below keep those two roles distinct on the same model.
  compensationRates                 CompensationRate[]
  compensationRatesCreated          CompensationRate[]          @relation("CompensationRateCreator")
  payrollBankAccount                PayrollBankAccount?
  dottedLineReportsAsReport          DottedLineReport[]           @relation("DottedLineReportUser")
  dottedLineReportsAsManager         DottedLineReport[]           @relation("DottedLineReportManager")
  lifecycleChecklists                LifecycleChecklist[]
  leaveBalances                     LeaveBalance[]
  leaveRequests                     LeaveRequest[]              @relation("LeaveRequestUser")
  leaveRequestsDecided              LeaveRequest[]              @relation("LeaveRequestDecider")
  payRunsApproved                   PayRun[]                    @relation("PayRunApprover")
  payRunsCreated                    PayRun[]                    @relation("PayRunCreator")
  payRunLines                       PayRunLine[]
  payRunAdjustments                 PayRunAdjustment[]
  payRunAdjustmentsCreated          PayRunAdjustment[]          @relation("PayRunAdjustmentCreator")
  /// hr.prisma (hr-people-org/79-employee-asset-management.md) — one User is
  /// both a possible asset holder and, for an ADMIN, the actor who issued or
  /// took back someone else's asset; three relation names for three distinct
  /// roles on the same model, same idiom as the payroll block above.
  assetAssignments                  AssetAssignment[]           @relation("AssetAssignmentHolder")
  assetAssignmentsIssued            AssetAssignment[]           @relation("AssetAssignmentIssuer")
  assetAssignmentsReturned          AssetAssignment[]           @relation("AssetAssignmentReturner")
  /// hr.prisma (hr-people-org/20-people-positions-ranks.md, ADR-044) — no
  /// separate Employee model; this User IS the employee when it holds a
  /// Posting. employeeProfile is optional supplementary detail, never a
  /// gate on whether a posting is possible.
  employeeProfile                   EmployeeProfile?
  postings                          Posting[]
  /// org-structure.prisma (access-control-identity/21-access-over-the-org-tree.md)
  /// — one User can hold a grant, issue one, and countersign a third at
  /// once; three relation names for three distinct roles on the same model,
  /// same idiom as the payroll and asset-assignment blocks above.
  orgUnitGrantsHeld                 OrgUnitGrant[]              @relation("OrgUnitGrantHolder")
  orgUnitGrantsIssued               OrgUnitGrant[]              @relation("OrgUnitGrantGranter")
  orgUnitGrantsCountersigned        OrgUnitGrant[]              @relation("OrgUnitGrantCountersigner")
  /// attendance.prisma (attendance-workforce/22-attendance-shifts-leave.md)
  /// — this User's own punches and shifts, plus, for someone who reconciles
  /// exceptions, the exceptions they resolved; three relation names for
  /// three distinct roles on the same model, same idiom as the blocks above.
  attendanceEvents                  AttendanceEvent[]
  shifts                            Shift[]
  attendanceExceptions              AttendanceException[]       @relation("AttendanceExceptionUser")
  attendanceExceptionsResolved      AttendanceException[]       @relation("AttendanceExceptionResolver")
  /// accounting.prisma (finance-accounting/147-fixed-asset-depreciation.md)
  /// — who set up a depreciation schedule, a real accounting-policy decision.
  assetDepreciationSchedulesCreated AssetDepreciationSchedule[]
  /// fulfilment.prisma (WO-6.4/6.6) — both core, same idiom as auditLogs above.
  manifestsCreated                  Manifest[]
  returnRequests                    ReturnRequest[]
  /// content.prisma (WO-8.1) — a staff account authoring a blog post.
  blogPosts                         BlogPost[]
  /// marketing.prisma (WO-8.4) — a staff account authoring a campaign.
  campaignsCreated                  Campaign[]
  /// giftcards.prisma (WO-5.5). SUM(StoreCreditTransaction.delta) — a cache,
  /// never written outside StoreCreditService's own conditional update; the
  /// ledger is the source of truth (see StoreCreditTransaction's own note).
  storeCreditBalance                Int                         @default(0)
  storeCreditTransactions           StoreCreditTransaction[]
  giftCardsPurchased                GiftCard[]                  @relation("GiftCardPurchaser")

  /// wallet.prisma (doc 155) — 1:1, distinct from storeCreditBalance above:
  /// a Wallet is Newax-issued PURCHASED credit with its own RESERVE/REDEEM
  /// lifecycle, never the goodwill/refund ledger StoreCreditTransaction is.
  /// Module ships off by default — see DECISIONS.md.
  walletAccount WalletAccount?

  /// Phase 7 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
  reviews                 Review[]
  wishlistItems           WishlistItem[]
  backInStockRequests     BackInStockRequest[]
  /// WO-5.5's own cache pattern, reused: SUM(LoyaltyTransaction.points) — a
  /// cache, never written outside LoyaltyService's own conditional update.
  loyaltyPoints           Int                      @default(0)
  loyaltyTransactions     LoyaltyTransaction[]
  /// Generated lazily on first request (human-code.ts, WO-5's own helper) —
  /// most customers never ask for a referral code, so most rows stay null.
  referralCode            String?                  @unique
  referralsMade           Referral[]               @relation("ReferralReferrer")
  referredBy              Referral?                @relation("ReferralReferee")
  notificationPreferences NotificationPreference[]

  @@index([role])
  @@index([createdAt])
  @@index([ssoExternalId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  /// Every token descended from one sign-in shares its familyId: a fresh
  /// value at login, inherited on every rotation. Reuse of a rotated token
  /// outside the grace window revokes the whole family at once
  /// (206-rate-limiting-caching-compression-hardening.md §2.2). Tokens issued
  /// before WO-206.3 were backfilled with their own id — each its own family.
  familyId     String
  /// When this token was exchanged for its successor. Null for a token that
  /// was never rotated — live, or revoked some other way (logout, password
  /// change, deactivation), which is never treated as reuse.
  rotatedAt    DateTime?
  /// The token that superseded this one. Set in the same transaction as
  /// rotatedAt, so a replay inside the grace window can hand back the very
  /// same successor instead of minting a second one.
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
}

/**
 * A one-time token mailed to reset a forgotten password.
 * Mirrors RefreshToken: only a SHA-256 hash is stored, so a leaked database
 * dump cannot be replayed as a reset link.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * A one-time token mailed to confirm an email address. Same shape and reasoning as PasswordResetToken.
 */
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Which request surface a personal API key acts on — two separate scope
/// catalogues, never mixed (163-personal-api-keys.md §2). ADMIN keys carry
/// `PERMISSION_CATALOG` keys (`permissionKeys`); STOREFRONT keys carry
/// `CUSTOMER_SCOPE_CATALOG` keys (`customerScopes`).
enum ApiKeySurface {
  ADMIN
  STOREFRONT
}

/// Why a key stopped working — kept on the row so the owner's own list can
/// say it, not only the audit trail.
enum ApiKeyRevocationReason {
  /// The owner revoked it from their own list.
  OWNER
  /// A `users.manage` holder revoked it from the oversight list.
  ADMINISTRATOR
  /// UsersAdminService.update() deactivated the owner (canonical ruling 6).
  OWNER_DEACTIVATED
}

/// A personal API key: a credential that acts as `user`, never as anyone more
/// powerful. Its effective access on every request is
/// `(permissionKeys or customerScopes) ∩ (user's live permissions) −
/// NON_DELEGATABLE_PERMISSIONS`, recomputed by ApiKeyAuthService — nothing
/// here is a snapshot of what the owner could do when it was made.
///
/// Written only by ApiKeysService. Node-local: deliberately not registered
/// with ReplicationRegistry, so a credential never leaves the node that
/// minted it. The migration adds what this DSL cannot say: a CHECK tying each
/// row to exactly one catalogue, and a trigger making revocation final.
model ApiKey {
  id             String                  @id @default(cuid())
  userId         String
  surface        ApiKeySurface
  /// Chosen by the owner. Shown to the owner and to `users.manage`, never
  /// put in the security email (it is text the minting person chose).
  name           String
  /// SHA-256 of the raw secret (core/security/api-token.ts) — the raw value
  /// is in exactly one HTTP response, the one that created or rotated it.
  /// Same discipline as TradingPartner.inboundApiKeyHash. Never selected by
  /// any read path.
  keyHash        String                  @unique
  /// The secret's last four characters, so a list can tell keys apart. The
  /// other 252 bits of the secret stay unknown.
  lastFour       String
  /// `PERMISSION_CATALOG` keys chosen at create/edit — ADMIN keys only; the
  /// CHECK keeps it empty on a STOREFRONT key.
  permissionKeys String[]                @default([])
  /// `CUSTOMER_SCOPE_CATALOG` keys — STOREFRONT keys only; the CHECK keeps it
  /// empty on an ADMIN key.
  customerScopes String[]                @default([])
  /// Mandatory, at most API_KEY_MAX_LIFETIME_DAYS after create or rotate.
  expiresAt      DateTime
  /// Best-effort, written at most once a minute per key — operational, not
  /// evidence; never fails a request.
  lastUsedAt     DateTime?
  /// Set by every rotate; null until the first.
  rotatedAt      DateTime?
  /// Null while the key is live. Once set, the row is final (trigger).
  revokedAt      DateTime?
  /// Set with revokedAt, never without it (CHECK).
  revokedReason  ApiKeyRevocationReason?
  /// Who revoked it: the owner, an administrator, or the admin who
  /// deactivated the owner. Null while the key is live — and null again if
  /// that person's own account is later erased (SetNull); revokedReason still
  /// says which kind of actor it was.
  revokedById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user      User  @relation("ApiKeyOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("ApiKeyRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  // The owner's own list (WHERE userId ORDER BY createdAt DESC), and the
  // deactivation revoke (WHERE userId AND revokedAt IS NULL).
  @@index([userId, createdAt])
  // The `users.manage` oversight list, newest first, paginated.
  @@index([createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  label      String? // "Home", "Office"
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  country    String   @default("PK")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Runtime configuration edited from the admin dashboard: store name, shipping
/// zones, COD fee, stitching lead times. Business rules are data, not constants.
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

/// What an EmailAccount is for, so EmailChannel can route an outgoing message
/// to the right mailbox instead of every email leaving from one address.
/// TRANSACTIONAL is the fallback purpose — order, payment and account mail
/// always has somewhere to send from even if only one account exists.
enum EmailAccountPurpose {
  TRANSACTIONAL
  MARKETING
  SUPPORT
}

/// A connected mailbox: SMTP to send, optionally IMAP to receive. Multiple
/// accounts may share a purpose (e.g. two marketing senders); the one with
/// isDefault wins, then the most recently updated. Secrets are stored as
/// AES-256-GCM ciphertext (@newax/shared's secret-crypto.ts) — never plaintext,
/// never returned by the API once saved.
model EmailAccount {
  id        String              @id @default(cuid())
  label     String // "Orders", "Support Inbox", "Marketing PK"
  purpose   EmailAccountPurpose @default(TRANSACTIONAL)
  isActive  Boolean             @default(true)
  /// The account EmailChannel prefers for its purpose when more than one is active.
  isDefault Boolean             @default(false)

  fromName  String
  fromEmail String
  replyTo   String?

  smtpHost              String
  smtpPort              Int       @default(587)
  /// True for implicit TLS (port 465). Port 587 upgrades with STARTTLS instead.
  smtpSecure            Boolean   @default(false)
  smtpUser              String
  smtpPasswordEncrypted String
  smtpVerifiedAt        DateTime?

  /// IMAP is optional per account. When configured, the mailbox poller
  /// (modules/customers/crm/email-inbox) logs in on a schedule and pulls new mail —
  /// see imapLastPolledAt/imapLastUid below for its resume cursor.
  imapHost              String?
  imapPort              Int?
  imapSecure            Boolean   @default(true)
  imapUser              String?
  imapPasswordEncrypted String?
  imapVerifiedAt        DateTime?

  /// Set after each poll, purely for the admin UI ("last checked 3 min ago").
  imapLastPolledAt DateTime?
  /// Highest UID the poller has seen for this mailbox, so a run does not
  /// rescan everything — not the idempotency guard itself (InboundEmail's
  /// unique constraint is), just a resume point.
  imapLastUid      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inboundEmails InboundEmail[]

  @@index([purpose, isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // "product.updated", "order.status_changed"
  entity    String // "Product", "Order"
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// A single grantable capability, e.g. "orders.manage". The key is what
/// guards check and what @RequirePermission(...) call sites reference —
/// label/category are display-only, for the Settings → Roles &amp; Permissions
/// screen.
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  category  String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermission[]
  /// The new, dynamic-role successor to `rolePermissions` above.
  roleGrants      RoleGrant[]
}

/// Which roles currently hold a given permission. This mapping is data, not
/// code — it starts seeded to reproduce the old RBAC role checks exactly, and
/// is then editable from the admin Settings screen.
model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

enum PermissionEffect {
  GRANT
  REVOKE
}

/// A per-user adjustment layered on top of their role's grants: GRANT adds a
/// permission their role doesn't have, REVOKE takes one away that it does.
/// Resolution is role grants first, then these overrides applied on top —
/// @see PermissionsResolverService.resolveForUser.
model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

/// A named, reusable bundle of permissions a super admin defines — "roles
/// are data, not code" (House Rule 9) taken to its actual conclusion. Until
/// now only which permissions a role holds was data (RolePermission,
/// keyed by the fixed UserRole enum); the roles themselves were still a
/// hardcoded enum. This table is the role itself: seeded once with four
/// rows matching today's enum (Customer, Tailor, Staff, Admin) so a fresh
/// deployment behaves identically, and freely renameable, deletable, or
/// joined by new custom roles from there — nothing in application code
/// depends on any particular row existing, the same guarantee House Rule 9
/// already gives every permission check.
///
/// A user may hold several roles at once (`UserRoleAssignment`, below);
/// their effective permissions are every held role's grants, unioned, with
/// their own `UserPermission` overrides applied on top — same order as
/// always, just merging more than one role's grants first.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants      RoleGrant[]
  assignments UserRoleAssignment[]
}

/// Which permissions a `Role` holds — the direct successor to the old
/// enum-keyed `RolePermission`, just pointing at a real `Role` row instead
/// of a fixed enum value.
model RoleGrant {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

/// Which `Role` rows a user holds. Plural on purpose — see `Role`'s own
/// comment: permissions from every assigned role union together.
model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Transactional outbox. Domain events are written in the same transaction as
/// the state change that produced them, then dispatched to subscribers by a
/// background worker — so a failing subscriber retries instead of losing the
/// event, and never blocks checkout.
model OutboxEvent {
  id          String       @id @default(cuid())
  name        String // "order.placed"
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([name])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// A push notification target: one installation of the mobile app.
///
/// Keyed on the token itself, because reinstalling the app or restoring a
/// backup can hand the same token to a different account — registering simply
/// moves it, rather than leaving the old owner receiving someone else's
/// garments.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  appVersion String?
  locale     String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Anonymous, aggregate first-party analytics — page views, add-to-cart,
/// checkout-started. sessionId is an opaque client-generated id, never a raw
/// IP or User-Agent, and this table is intentionally NOT related to User or
/// Contact: do not add a userId column here, it would join anonymous session
/// activity to a real identity.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // "page_view" | "add_to_cart" | "checkout_started"
  path      String? // for page_view: the route, e.g. "/en/product/lawn-suit-42"
  source    String   @default("direct") // "direct" | "organic" | "social" | "referral" | "email"
  sessionId String // opaque, anonymous, client-generated — never joined to a user
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId, createdAt])
}

/// Phase 9 (docs/implementation/ai-layer/09-ai-layer.md). Every AiProvider
/// call, whichever feature triggered it — the doc's own non-negotiable
/// ("Log tokens and cost per call, per feature") plus what AiService reads
/// to enforce the monthly budget cap. Never deleted by a feature; only
/// AiService writes here.
enum AiFeature {
  ALT_TEXT
  SEO_COPY
  SIZE_RECOMMENDATION
  DEMAND_FORECAST
  COD_RISK
  SEMANTIC_SEARCH
  VISUAL_SEARCH
  RECOMMENDATIONS
  WHATSAPP_ASSISTANT
  MARKDOWN_SUGGESTION
  REVIEW_SUMMARY
  IMPORT_CLEANUP
  // WO-35 (rag.prisma) — one AiCallKind each: EMBEDDING for both ingestion
  // and a retrieval query's own embedding, VISION for the scanned-page OCR
  // fallback, COMPLETION for generation.
  RAG_INGESTION
  RAG_RETRIEVAL
  RAG_GENERATION
  // 144-supply-chain-resilience-planning-engine.md (R23) — narrating an
  // already-computed propagation/ranking result; the model writes prose
  // around figures it is handed, never originates one of its own.
  PLANNING_NARRATION
}

enum AiCallKind {
  COMPLETION
  EMBEDDING
  VISION
}

model AiUsageLog {
  id           String     @id @default(cuid())
  feature      AiFeature
  kind         AiCallKind
  /// Matches the calling AiProvider's own `key` — "anthropic" | "openai".
  provider     String
  model        String
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  /// Estimated from the provider's published per-token rate at call time —
  /// see ai.service.ts's own PRICING table. Paisa, so it sums cleanly with
  /// every other money figure in this codebase.
  costPaisa    Int        @default(0)
  succeeded    Boolean    @default(true)
  errorMessage String?
  createdAt    DateTime   @default(now())

  @@index([feature, createdAt])
  @@index([createdAt])
}

// CRM: one customer record, whatever door the customer came in through.
//
// Contact is keyed on the normalised phone number (E.164). A guest COD order,
// a registered account and a walk-in lead for the same person collapse into a
// single Contact — that dedup is the whole value of the module, and it is
// unit-tested in the crm module.

enum ContactStatus {
  LEAD
  ACTIVE
  REPEAT
  DORMANT
  BLOCKED
}

model Contact {
  id          String        @id @default(cuid())
  /// Normalised to +92XXXXXXXXXX. The dedup key.
  phoneE164   String?       @unique
  email       String?       @unique
  name        String
  city        String?
  /// Free text, not an enum — never a fixed set a person has to fit into.
  gender      String?
  dateOfBirth DateTime?
  avatarUrl   String?
  /// Where they came from: "storefront", "whatsapp", "instagram", "walk_in".
  source      String        @default("storefront")
  status      ContactStatus @default(LEAD)
  ownerId     String?
  /// Set once the contact registers an account.
  userId      String?       @unique
  notes       String?

  /// Rolled up by the CRM's order.placed subscriber, not computed on read —
  /// the contact list has to stay fast with tens of thousands of rows.
  orderCount    Int       @default(0)
  lifetimeValue Int       @default(0) // paisa
  avgOrderValue Int       @default(0) // paisa
  lastOrderAt   DateTime?
  firstOrderAt  DateTime?
  /// WO-6.7 — rolled up by rto-contact.listener.ts on
  /// DomainEvent.ShipmentReturnedToOrigin, same idiom as orderCount above.
  /// What tells the shop which customers to require advance payment from.
  rtoCount      Int       @default(0)

  /// WO-8.4. The one opt-out Campaign sends check, regardless of channel —
  /// deliberately separate from User.marketingEmailOptOut (email-only, and
  /// only for account holders) because a Contact is CRM's record and a
  /// campaign audience is a Segment of Contacts, not Users. Defaults to
  /// opted IN, same as the existing marketingEmailOptOut default — a lead
  /// captured at POS or WhatsApp has given no signal either way yet.
  marketingOptOut Boolean @default(false)

  /// RFM scoring (WO-8.4), quintile-ranked (1-5) among contacts with at
  /// least one order — RfmScoringCron (crm module) recomputes all three
  /// nightly via a single NTILE(5) query. Null until the cron has run once
  /// for a contact with no orders yet.
  rfmRecencyScore   Int?
  rfmFrequencyScore Int?
  rfmMonetaryScore  Int?
  rfmComputedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                 User?                  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  user                  User?                  @relation("ContactUser", fields: [userId], references: [id], onDelete: SetNull)
  orders                Order[]
  // No `stitchingOrders` relation field here on purpose (B7, MULTI-SECTOR.md)
  // — see the matching note on OrderItem in orders.prisma. StitchingOrder
  // (apparel) keeps a plain `contactId` scalar instead of a Prisma relation.
  // This field was unused in application code, so nothing else changes.
  leads                 Lead[]
  interactions          Interaction[]
  followUps             FollowUpTask[]
  tags                  ContactTag[]
  inboundEmails         InboundEmail[]
  /// marketing.prisma (WO-8.4).
  campaignReceipts      CampaignRecipient[]
  /// whatsapp-assistant.prisma (WO-9.7).
  whatsAppConversations WhatsAppConversation[]

  @@index([status])
  @@index([ownerId])
  @@index([lastOrderAt])
  @@index([lifetimeValue])
  @@index([rfmRecencyScore, rfmFrequencyScore, rfmMonetaryScore])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// An enquiry that is not yet an order: a stitching quote request, a WhatsApp
/// message logged by staff, a contact-form submission.
model Lead {
  id               String     @id @default(cuid())
  contactId        String?
  name             String
  phone            String?
  email            String?
  message          String?
  /// "contact_form", "whatsapp", "instagram", "phone", "walk_in"
  source           String     @default("contact_form")
  status           LeadStatus @default(NEW)
  ownerId          String?
  /// Estimated value in paisa, filled in when quoting.
  quotedValue      Int?
  lostReason       String?
  convertedOrderId String?
  convertedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner          User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedOrder Order?         @relation("LeadConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  interactions   Interaction[]
  followUps      FollowUpTask[]
  inboundEmails  InboundEmail[]

  @@index([status, createdAt])
  @@index([ownerId])
  @@index([contactId])
}

enum InteractionKind {
  CALL
  WHATSAPP
  EMAIL
  SMS
  VISIT
  NOTE
  COMPLAINT
}

model Interaction {
  id         String          @id @default(cuid())
  contactId  String?
  leadId     String?
  kind       InteractionKind
  body       String
  actorId    String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([contactId, occurredAt])
  @@index([leadId, occurredAt])
}

/// A message pulled from a connected mailbox's IMAP inbox by the poller
/// (modules/customers/crm/email-inbox) — a customer's reply to an order or support
/// email. `messageId` is unique per account, so re-polling the same message
/// (the poller re-checks unseen mail every run, not a durable cursor) is a
/// no-op rather than a duplicate row. Auto-linked to a Contact only when the
/// From: address matches one that already exists — never auto-created, so a
/// bounce or an out-of-office reply cannot spawn a fake customer. Unlinked
/// rows sit in the admin Support Inbox for staff to link by hand.
model InboundEmail {
  id             String   @id @default(cuid())
  emailAccountId String
  messageId      String
  inReplyTo      String?
  fromAddress    String
  fromName       String?
  subject        String?
  /// Plain-text body only — attachments are not ingested.
  bodyText       String?
  receivedAt     DateTime
  contactId      String?
  leadId         String?
  /// Set once linked (auto or manual), so linking twice is a no-op.
  interactionId  String?  @unique
  createdAt      DateTime @default(now())

  emailAccount EmailAccount        @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  replies      InboundEmailReply[]

  @@unique([emailAccountId, messageId])
  @@index([contactId])
  @@index([receivedAt])
}

/// A staff reply sent from the Support Inbox, over the SAME connected
/// mailbox the original message arrived at (not resolved by purpose — a
/// reply has to leave from the mailbox the customer is already talking to).
/// One InboundEmail can have several: the thread continues as long as the
/// customer keeps replying, ingested as further InboundEmail rows.
model InboundEmailReply {
  id             String   @id @default(cuid())
  inboundEmailId String
  actorId        String?
  body           String
  sentAt         DateTime @default(now())

  inboundEmail InboundEmail @relation(fields: [inboundEmailId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inboundEmailId, sentAt])
}

model FollowUpTask {
  id         String    @id @default(cuid())
  contactId  String?
  leadId     String?
  assigneeId String?
  note       String
  dueAt      DateTime
  isDone     Boolean   @default(false)
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User?    @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([isDone, dueAt])
  @@index([assigneeId, isDone])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  contacts ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

/// A saved contact filter — "repeat buyers in Lahore", "bridal enquiries" —
/// stored as a filter definition and exportable to CSV for WhatsApp broadcasts.
model Segment {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  filter      Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// marketing.prisma (WO-8.4) — a campaign's audience.
  campaigns      Campaign[]
  /// onsite-messaging.prisma (WO-8.6) — optional segment targeting.
  onsiteMessages OnsiteMessage[]
}

// Custom fields: a narrow, bounded JSONB overlay, never a general EAV model
// (architecture-patterns/104-jsonb-eav-extensibility.md, WO-104.1,
// DECISIONS.md ADR-045). `entityType` is a closed, code-known list — adding
// an entity to it is a small, reviewed code change (one Prisma field, one
// service branch), never an arbitrary string a client could point at a
// table this mechanism was never wired into.
//
// No `organizationId`: per ADR-044/ADR-040, this deployment IS the tenant —
// `organization` is off by default in every deployment today, and threading
// a column through every table for a multi-org concept most deployments
// never turn on is exactly the anti-pattern those ADRs already rejected.

enum CustomFieldValueType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  JSON
}

model CustomFieldDefinition {
  id         String               @id @default(cuid())
  entityType String
  key        String
  label      String
  valueType  CustomFieldValueType
  isRequired Boolean              @default(false)
  // Constraints below are each meaningful for exactly one valueType (pattern:
  // TEXT, minValue/maxValue: NUMBER, options: SELECT/MULTI_SELECT) and null
  // for the rest — enforced in CustomFieldsService, not here, same as
  // valueType-specific validation already was before these existed.
  pattern    String?
  minValue   Float?
  maxValue   Float?
  options    Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// Embedding a third-party dashboard: a narrow iframe pattern, not a
// micro-frontend architecture (architecture-patterns/113-micro-frontend-
// embedding.md, WO-113.1). No organizationId (ADR-044/ADR-040): this
// deployment IS the tenant.

model EmbeddedWidget {
  id        String   @id @default(cuid())
  /// Stable, admin-chosen slug — what the embedding screen and the token
  /// issuer both key off. Never derived from the vendor's own name in code.
  key       String   @unique
  label     String
  targetUrl String
  isActive  Boolean  @default(true)
  createdByUserId String?
  createdBy       User?    @relation("EmbeddedWidgetCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A general EAV model, built by explicit owner override (ADR-026).
// architecture-patterns/140-general-eav-extensibility-model.md (WO-140.1),
// DECISIONS.md ADR-049. Coexists with doc 104's own bounded
// CustomFieldDefinition/Supplier.customFields — that overlay remains in
// place for the entities it already covers; this table is the general
// fallback for any entity doc 104's own allowlist does not (yet) name.
//
// No organizationId: per ADR-044/ADR-040 (already applied to doc 104's own
// CustomFieldDefinition), this deployment IS the tenant.
//
// No foreign key to the target entity: entityType varies, so entityId
// cannot be a real Prisma relation. Deleting an entity does NOT cascade to
// its attributes automatically — EntityAttributeService.deleteAll() must be
// called explicitly by every entity's own deletion path that opts in. This
// is a real, standing maintenance obligation, not a one-time cost.

model EntityAttribute {
  id             String   @id @default(cuid())
  /// No code-known allowlist — validated at write time against the live
  /// Prisma.ModelName registry (EntityAttributeService's own runtime
  /// check), never a hand-maintained array that can drift from the schema.
  entityType     String
  entityId       String
  attributeKey   String
  /// Stored as text; typed interpretation (number, date, boolean) is a
  /// caller-side convention via valueType, not a database constraint — the
  /// direct consequence of accepting the EAV trade-off doc 140 names.
  attributeValue String
  valueType      String   @default("TEXT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, attributeKey])
  @@index([entityType, entityId])
}

// Feature flags — the missing piece between "built" and "everyone has it"
// (resilience-scalability/37-scalability-future-upgrades.md, WO-37.2).
// Additive only; no existing table altered.
//
// A flag is a de-risking tool, not a permanent branch in the code (doc 37's
// own words): every flag names, at creation, either a removal date or the
// criteria that ends it. `removalCriteria` completes doc 37's own Prisma
// sketch, which named the WO-37.3 lifecycle audit ("every flag with no
// stated removal criteria") but never gave it a column to check — this one
// is that column, the same "necessary, non-speculative completion" doc 37
// itself asks for.

/// FeatureFlagService.isEnabled(key, organizationId) is the one caller
/// every other module goes through — never a raw `prisma.featureFlag`
/// read from outside core/feature-flags, the same "one writer per
/// invariant" discipline CLAUDE.md already states for stock.
model FeatureFlag {
  id          String @id @default(cuid())
  /// "payroll.advance-salary-v2", "pos.kitchen-ticket". Already
  /// unique-indexed by the constraint below — doc 37's own scope-lens text
  /// says so explicitly ("key is already unique-indexed"), so no separate
  /// `@@index([key])` duplicates it.
  key         String @unique
  description String

  /// Rows, not a single global boolean — an org-level allowlist, a
  /// percentage rollout, or both, exactly the way LeaveType/Rank favour
  /// rows over a hardcoded enum for the same reason: one rollout shape
  /// does not fit every flag.
  rolloutPercent Int      @default(0)
  enabledOrgIds  String[]
  /// true = force off regardless of the above, for an incident. The
  /// operational reason this table exists at all — generalizes the
  /// `tax.enabled`-style one-off settings boolean into a reusable
  /// primitive.
  killSwitch     Boolean  @default(false)

  /// Doc 37's own "threshold nobody approves alone" scope-lens: true when
  /// this flag gates a money- or stock-writing path, so flipping it to
  /// 100% rollout or clearing `killSwitch` needs a second approver who is
  /// not whoever proposed the change — the identical
  /// createdById/approvedById maker-checker shape
  /// `BankFacilityDrawdown` and `SettlementBatch.writeoff*` already
  /// establish for their own thresholds. A cosmetic/UI-only flag never
  /// sets this and never needs the second approval below.
  moneyOrStockPath Boolean @default(false)

  /// The pending half of the same maker-checker pair, held on the flag
  /// itself (never more than one risky change proposed at a time) rather
  /// than a separate request table — proportional to a boolean gate, the
  /// same "smallest complete change" CLAUDE.md's change-minimization rule
  /// asks for. `proposedRolloutPercent`/`proposedKillSwitchOff` name what
  /// was asked for, `proposedById` who asked; `approveRollout()` refuses a
  /// caller equal to `proposedById` (FeatureFlagsAdminService, mirroring
  /// `SettlementsService.approveWriteoff()`'s own refusal) and clears all
  /// four fields on commit.
  proposedRolloutPercent Int?
  proposedKillSwitchOff  Boolean   @default(false)
  proposedById           String?
  proposedAt             DateTime?
  approvedById           String?
  approvedAt             DateTime?

  /// Every flag's own age, for WO-37.3's staleness window — never a
  /// separately maintained "flag age" counter that could drift from this.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Null until either the flag is removed from the codebase (100%
  /// rollout, deleted) or promoted to a permanent Setting/MODULES entry.
  /// WO-37.3's audit surfaces every row still null past the staleness
  /// window — "no artifact" is exactly what a bare `n/a` would be here,
  /// so this column exists precisely so that answer is checkable.
  removalCriteria String?

  @@index([createdAt])
}

// Finance: operational expenses and per-order economics (RETAIL-ERP.md
// Tranche 6, WO-23.1 — "build 10-admin-dashboard.md §B as written, now
// posting to the GL"). ExpenseCategory + Expense are WO-B.1; OrderEconomics
// below is WO-B.3.
//
// Deliberately NOT double-entry. If you find yourself wanting a JournalEntry
// model, stop - see docs/implementation/finance-accounting/04-finance.md. The GL posting this
// tranche adds (posting-rules.subscriber.ts's onExpenseRecorded) is a
// DERIVED journal entry keyed off (source, sourceRef) — Expense itself never
// gains a status column for it, matching how OrderPlaced/PaymentSucceeded
// already work. OrderEconomics is a derived REPORTING snapshot, not a GL
// posting at all — order revenue/COGS already post to the ledger at
// OrderPlaced time (posting-rules.subscriber.ts's onOrderPlaced); this table
// exists purely so unit-economics reports don't recompute across the whole
// order tree on every read.
// Money is integer paisa (Rule 5). Every report groups by incurredAt, never
// paidAt: October's rent paid in November is an October expense.

model ExpenseCategory {
  id       String  @id @default(cuid())
  key      String  @unique // "rent", "salaries", "marketing", "packaging"
  /// Staff-only label. NOT a translation row - Rule 6's second paragraph, and D10.
  name     String
  /// Direct costs sit above the gross-profit line; operating below it.
  isDirect Boolean @default(false)
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([isActive, order])
}

enum ExpenseRecurrence {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Expense {
  id          String @id @default(cuid())
  categoryId  String
  /// Paisa. Always positive - an expense is not a negative income.
  amount      Int
  currency    String @default("PKR")
  description String

  /// The date the cost BELONGS TO, which is not always when it was entered.
  incurredAt DateTime
  /// When money actually left. Null = unpaid. Cash flow is the only consumer.
  paidAt     DateTime?

  payee      String?
  supplierId String?
  reference  String?
  receiptUrl String? // via the existing StorageDriver (WO-B.2)

  recurrence      ExpenseRecurrence @default(NONE)
  recurringFromId String?
  /// Period key of a generated instance, e.g. "2026-08". With recurringFromId
  /// this is what makes the cron idempotent at the DATABASE level (WO-B.2).
  recurringPeriod String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// WO-23.3 (RETAIL-ERP.md R13/R8, ADR-021). "Expenses are recorded at
  /// whichever tier pays them" — defaults to BRAND, same reasoning as
  /// PurchaseOrder.scopeLevel. No locationId: an expense names a tier, not
  /// a place stock sits.
  scopeLevel   ScopeLevel @default(BRAND)
  /// This node's own identifier (AppConfigService.nodeId) when recorded —
  /// a bare string, never a Node row FK. Null for an expense recorded
  /// before this column existed.
  originNodeId String?

  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recurringFrom Expense?        @relation("ExpenseRecurrence", fields: [recurringFromId], references: [id], onDelete: SetNull)
  generated     Expense[]       @relation("ExpenseRecurrence")

  @@unique([recurringFromId, recurringPeriod])
  @@index([incurredAt])
  @@index([categoryId, incurredAt])
  @@index([paidAt])
  @@index([supplierId])
  @@index([scopeLevel])
}

/// One row per order, written when it reaches DELIVERED and recomputed if it
/// is later RETURNED (WO-B.3). `orderId` is the primary key on purpose — this
/// is a snapshot keyed 1:1 on the order it describes, never a log of
/// recomputations; each write overwrites the same row, matching the
/// idempotent-upsert idiom every other domain-event listener here already
/// uses.
model OrderEconomics {
  orderId String @id

  /// itemsSubtotal + stitchingSubtotal - itemDiscountTotal - orderDiscount.
  /// Zeroed on RETURNED — see shippingCostEstimated's own note on why revenue
  /// and cogs, and only those two, zero on a return.
  revenue               Int
  shippingIncome        Int
  codFeeIncome          Int
  /// Σ OrderItem.unitCost × quantity. Zeroed on RETURNED, same as revenue —
  /// reversing one without the other drives margin negative on every return.
  cogs                  Int
  /// Σ Shipment.cost across the order's shipments (nullable per shipment).
  shippingCost          Int
  /// True when shippingCost fell back to 0 for lack of real Shipment.cost
  /// data (no shipment row yet, or one exists with cost still null) — a
  /// figure this table lied about would be worse than one it flags.
  shippingCostEstimated Boolean  @default(false)
  /// round(grandTotal × FinanceGatewayFeeBps[provider] / 10000). 0 for a COD
  /// order under the default settings — not a special case in code, just
  /// what the default bps table says for "cod".
  gatewayFee            Int
  /// Flat per-order cost from the FinancePackagingCostPerOrder setting.
  packagingCost         Int
  /// revenue + shippingIncome + codFeeIncome - cogs - shippingCost -
  /// gatewayFee - packagingCost.
  contribution          Int
  computedAt            DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Micro-frontend fragments, built by explicit owner override (ADR-026),
// added alongside doc 93's single-app convention rather than replacing it
// (architecture-patterns/143-micro-frontend-architecture.md). No
// organizationId (ADR-044/ADR-040): this deployment IS the tenant.
//
// The literal `next.config.js` module-federation build this document
// sketches (WO-143.1) is not built: `@module-federation/nextjs-mf` does
// not support this repository's own Next.js 15 (an open, unresolved
// upstream compatibility issue) — see DECISIONS.md ADR-049. The mount
// mechanism this schema and FragmentsService serve is instead doc 113's
// own iframe + short-lived embed-token pattern, reused unchanged
// (WO-143.4, exactly as the doc's own text already asks for), scoped by
// `mountPoints` and gated by `status`.

model MicroFrontendFragment {
  id                 String         @id @default(cuid())
  /// Stable, admin-chosen slug — what the mount point and the token issuer
  /// both key off. Never derived from the vendor's own name in code.
  key                String         @unique
  label              String
  remoteUrl          String
  /// Which admin screens may embed this fragment — never a blanket
  /// "embed anywhere" grant.
  mountPoints        String[]
  status             FragmentStatus @default(ACTIVE)
  /// The design-law compliance attestation doc 143 requires before a
  /// fragment may go ACTIVE — this repository's own overflow/contrast
  /// checks cannot reach across a federation boundary by tooling alone,
  /// so it is enforced by process at registration instead.
  attestedAt         DateTime
  attestedByUserId   String?
  attestedBy         User?          @relation("MicroFrontendFragmentRegisteredBy", fields: [attestedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

enum FragmentStatus {
  ACTIVE
  SUSPENDED
}

// Phase 6 (docs/implementation/06-shipping-fulfilment-returns.md) — shipping
// as data instead of a JSON setting, the shipment lifecycle, and returns/RMA.
//
// New module `fulfilment` (core pack — every shop ships something). Owns
// this file; Shipment itself stays in orders.prisma (extended below) because
// WO-6.4 says so explicitly and orders already owns its lifecycle columns.

enum ShippingRateType {
  FLAT
  BY_WEIGHT
  BY_PRICE
  BY_ITEM
}

model ShippingZone {
  id         String   @id @default(cuid())
  key        String   @unique
  order      Int      @default(0)
  /// Cities matched case-insensitively. An empty list = the catch-all zone.
  cities     String[] @default([])
  isActive   Boolean  @default(true)
  /// Exactly one zone must be the fallback — enforced in ShippingService, not
  /// the database, the same way "exactly one Location isDefault" already is.
  isCatchAll Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations ShippingZoneTranslation[]
  rates        ShippingRate[]
}

/// House Rule 6: labelEn/labelUr, not columns on ShippingZone itself.
model ShippingZoneTranslation {
  id     String @id @default(cuid())
  zoneId String
  locale String
  label  String

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, locale])
}

model ShippingMethod {
  id         String   @id @default(cuid())
  key        String   @unique // "standard" | "express" | "same_day"
  /// Preferred CourierProvider key for this method — matches a live
  /// provider's `key`, but stored as a bare string (courier-provider.ts is a
  /// TS interface, not a table) so adding a provider never touches this row.
  courierKey String?
  etaMinDays Int      @default(2)
  etaMaxDays Int      @default(5)
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations ShippingMethodTranslation[]
  rates        ShippingRate[]
  shipments    Shipment[]
}

model ShippingMethodTranslation {
  id       String @id @default(cuid())
  methodId String
  locale   String
  label    String

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([methodId, locale])
}

model ShippingRate {
  id            String           @id @default(cuid())
  zoneId        String
  methodId      String
  type          ShippingRateType @default(FLAT)
  /// Paisa. For BY_WEIGHT/BY_ITEM this is per unit above `includedUnits`.
  fee           Int
  baseFee       Int              @default(0)
  includedUnits Int              @default(0)
  /// Order subtotal above which this rate is free. Null = never free.
  freeAbove     Int?
  /// Band bounds, for tiered rates. Null = unbounded.
  minValue      Int?
  maxValue      Int?
  isActive      Boolean          @default(true)

  zone   ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  /// Not unique: BY_PRICE/BY_WEIGHT tier a zone+method pair across several
  /// banded rows (minValue/maxValue); FLAT/BY_ITEM use exactly one.
  @@index([zoneId, methodId])
}

/// WO-6.1's own closing line: "Add per-product shipping classes and a
/// handling fee." A product with no class costs nothing extra to pack — the
/// FK is nullable and every read treats null as a zero handling fee.
model ShippingClass {
  id          String   @id @default(cuid())
  key         String   @unique
  /// Paisa, added on top of the zone/method rate for every unit of this
  /// class in the order.
  handlingFee Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations ShippingClassTranslation[]
  products     Product[]
}

model ShippingClassTranslation {
  id      String @id @default(cuid())
  classId String
  locale  String
  label   String

  shippingClass ShippingClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, locale])
}

enum ManifestStatus {
  OPEN
  DISPATCHED
}

/// A day's pickup, grouped by courier — WO-6.4's printable handover sheet.
model Manifest {
  id           String         @id @default(cuid())
  number       String         @unique // "MFT-2026-0001"
  courierKey   String
  status       ManifestStatus @default(OPEN)
  dispatchedAt DateTime?
  createdById  String?
  createdAt    DateTime       @default(now())

  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  shipments Shipment[]

  @@index([courierKey, status])
}

/// A shipment may cover only part of an order (WO-6.4's partial-shipment
/// note) — the shipment holds these rather than implicitly covering every
/// OrderItem on the order.
model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([orderItemId])
}

/// The tracking timeline — one row per status change, courier's raw string
/// kept in `meta` for support, never trusted for logic (WO-6.2's own rule).
model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  rawStatus  String?
  meta       Json?
  occurredAt DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

/// Seeded, editable — WO-6.6's own rule: reason codes are the fit-feedback
/// input for Phase 9, never free text.
model ReturnReasonCode {
  id       String  @id @default(cuid())
  key      String  @unique // "too_small" | "damaged" | "not_as_described" | …
  isActive Boolean @default(true)
  order    Int     @default(0)

  translations ReturnReasonTranslation[]
  items        ReturnRequestItem[]
}

model ReturnReasonTranslation {
  id       String @id @default(cuid())
  reasonId String
  locale   String
  label    String

  reason ReturnReasonCode @relation(fields: [reasonId], references: [id], onDelete: Cascade)

  @@unique([reasonId, locale])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  REFUNDED
  CLOSED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
  REPAIR
  REJECTED
}

model ReturnRequest {
  id           String            @id @default(cuid())
  number       String            @unique // "RMA-2026-0001"
  orderId      String
  userId       String?
  status       ReturnStatus      @default(REQUESTED)
  resolution   ReturnResolution?
  customerNote String?
  staffNote    String?
  /// Customer-uploaded photos, via StorageDriver.
  photoUrls    String[]          @default([])

  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  receivedAt   DateTime?
  inspectedAt  DateTime?
  refundedAt   DateTime?
  refundAmount Int?
  /// Ecosystem audit 2026-10-30 (merged from @newaxhq/orders's RMA restocking
  /// fee) — snapshotted when `refundAmount` was computed rather than
  /// caller-supplied, so a later rate change never rewrites history. Null
  /// when the resolver typed `refundAmount` by hand, or no fee applied.
  restockingFeeMinor Int?

  order Order               @relation(fields: [orderId], references: [id])
  user  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ReturnRequestItem[]

  @@index([status, requestedAt])
  @@index([orderId])
}

model ReturnRequestItem {
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String
  reasonId    String
  quantity    Int
  /// Set at inspection: is it saleable? Null until then.
  restockable Boolean?
  restocked   Boolean  @default(false)

  returnRequest ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id])
  reason        ReturnReasonCode @relation(fields: [reasonId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
}

/// Same INSERT ... ON CONFLICT ... RETURNING shape as every other
/// document-prefix.ts counter (OrderNumberCounter, PayRunNumberCounter, …).
model ReturnRequestNumberCounter {
  year    Int @id
  counter Int @default(0)
}

model ManifestNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// Phase 5 WO-5.4/5.5 (docs/implementation/promotions-giftcards/05-promotions-giftcards.md).
//
// Same ledger discipline as the stock ledger (Phase 1): balance is DERIVED,
// never edited directly, every change is a row, and redemption is a
// conditional update (`WHERE balance >= amount`) so two simultaneous
// checkouts against the same balance cannot both succeed.
//
// A gift card is NOT a discount — it is tender, applied after tax and
// shipping against the final total (orders.service.ts's placeOrder), and it
// is a liability until redeemed (Phase 4's "gift card breakage").

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id           String         @id @default(cuid())
  /// Human-readable, unambiguous: no O/0, no I/1/l (giftcard-code.ts). Stored uppercase.
  code         String         @unique
  initialValue Int
  /// DERIVED from `transactions` below. Never written directly outside GiftCardsService's own conditional updates.
  balance      Int
  status       GiftCardStatus @default(ACTIVE)
  currency     String         @default("PKR")

  purchasedByUserId String?
  /// Who it was bought for.
  recipientName     String?
  recipientEmail    String?
  recipientPhone    String?
  message           String?
  /// Order that bought it, when it was sold rather than issued by staff.
  sourceOrderId     String?

  expiresAt DateTime?
  issuedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  purchasedBy  User?                 @relation("GiftCardPurchaser", fields: [purchasedByUserId], references: [id], onDelete: SetNull)
  sourceOrder  Order?                @relation("GiftCardSourceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]

  @@index([status])
  @@index([purchasedByUserId])
}

model GiftCardTransaction {
  id           String   @id @default(cuid())
  giftCardId   String
  /// Negative = spent, positive = issued or topped up. Never zero.
  delta        Int
  balanceAfter Int
  reason       String // "issue" | "redeem" | "refund" | "expire" | "adjust" | "cancel"
  orderId      String?
  actorId      String?
  createdAt    DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([orderId])
}

/// Same ledger shape, attached to a User rather than a code — refunds, RTO
/// goodwill and service recovery all land here. `User.storeCreditBalance` is
/// a CACHE of SUM(delta), kept only so a checkout redemption can use the same
/// atomic conditional-update idiom as GiftCard.balance; StoreCreditReconcileCron
/// re-derives it from this ledger nightly (WO-5.5's own "add a reconciliation
/// check" note) — this table, not the cached column, is the source of truth.
model StoreCreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       String // "refund" | "goodwill" | "redeem" | "expire" | "adjust" | "referral" (WO-7.7)
  orderId      String?
  actorId      String?
  note         String?
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId])
}

// Employee assets: which physical equipment (laptop, phone, uniform) is
// issued to which employee, and whether it came back
// (docs/implementation/hr-people-org/79-employee-asset-management.md).
//
// Every actor here is a User — this codebase never built the doc's own
// separate Employee model (payroll.prisma made the same call first, for the
// same reason: "one User is both the payee and, for an ADMIN, the actor who
// acts on someone else's record"). No organizationId: this repository scopes
// a deployment to one brand at build time (CLAUDE.md's own axis rules), and
// no other model in this schema carries a literal organizationId column
// either — the same single-tenant idiom CompensationRate/LeaveBalance/etc.
// already use.

// Positions and the rank ladder (hr-people-org/20-people-positions-ranks.md,
// DECISIONS.md ADR-044). No separate Employee model — the identical call
// this file's own header already made for assets, and payroll.prisma made
// first: "every actor here is a User." Doc 20's own stated reason for a
// separate model (a person who may never sign in) does not hold against
// the actual User schema — email/phone/passwordHash are already all
// nullable there, so a login-less worker is already representable as a
// User row with all three null, unable to authenticate by construction
// (AuthService.login() cannot locate or verify such a row). EmployeeProfile
// below is NOT that fourth actor table: it is a thin, optional 1:1 sidecar
// for the handful of HR-specific fields (employeeCode, joinedOn, leftOn,
// status) that have no home on the universal, always-on User model and
// mean nothing when `hr` is off — ADR-044's Option 2.

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  LEFT
}

/// Optional HR-specific metadata about a User who works here. A User with
/// no row here can still hold a Posting — this table only ever adds detail,
/// never gates whether someone can be posted.
model EmployeeProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  /// The payroll/HR identifier the client already uses on paper. No
  /// organizationId scoping it (ADR-044) — this deployment IS the tenant.
  employeeCode String           @unique
  status       EmploymentStatus @default(ACTIVE)
  joinedOn     DateTime
  /// Set on the last working day. Kept, never deleted — payroll, attendance
  /// and completed tasks must still resolve years later.
  leftOn       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// A rank is a rung. Rows, not an enum — one client has five grades, the
/// next has twenty-two. `level` is the only thing compared, and it is
/// compared with `>`, never with equality against a hardcoded number.
model Rank {
  id    String @id @default(cuid())
  key   String @unique
  label String
  /// Higher outranks lower. Gaps are deliberate: seed 10, 20, 30 so a band
  /// can be inserted later without renumbering everyone.
  level Int    @unique

  positions Position[]
  compensationBand CompensationBand?
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/hr's MatrixOrgSolver):
/// a secondary ("dotted-line") reporting edge, person to person — matrix
/// reporting is a real relationship this schema never modelled, distinct
/// from `Position.reportsToId`'s primary, post-to-post line. Many-to-many:
/// one person can dot-line to several managers, one manager can hold many
/// dotted reports.
model DottedLineReport {
  id                  String   @id @default(cuid())
  userId              String
  dottedManagerUserId String
  createdAt           DateTime @default(now())

  user          User @relation("DottedLineReportUser", fields: [userId], references: [id])
  dottedManager User @relation("DottedLineReportManager", fields: [dottedManagerUserId], references: [id])

  @@unique([userId, dottedManagerUserId])
  @@index([dottedManagerUserId])
}

enum LifecycleChecklistType {
  ONBOARDING
  OFFBOARDING
  PROMOTION
  TRANSFER
}

enum ClearanceRole {
  HR_ADMIN
  IT_ADMIN
  FACILITIES
  FINANCE
  MANAGER
  EMPLOYEE
}

enum LifecycleChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/hr's
/// LifecycleChecklistEngine): the admin-configured task list for one
/// checklist type. A `LifecycleChecklist` copies these at creation time
/// into its own `LifecycleChecklistTask` rows — the same "snapshot at
/// write time" idiom `Task.orgUnitId`/`PayRunLine.compensationRateId`
/// already establish — so a later template edit never rewrites a
/// checklist already in progress.
model LifecycleChecklistTemplateTask {
  id                   String                  @id @default(cuid())
  type                 LifecycleChecklistType
  taskKey              String
  title                String
  description          String
  assignedRole         ClearanceRole
  requiredForCompletion Boolean                @default(true)
  /// string[] of taskKey — every id here must belong to the same `type`;
  /// validated by LifecycleChecklistService.setTemplate(), not by Postgres.
  prerequisiteTaskKeys Json?
  sortOrder            Int                     @default(0)

  @@unique([type, taskKey])
}

/// One lifecycle event's checklist instance for one employee.
model LifecycleChecklist {
  id          String                    @id @default(cuid())
  userId      String
  type        LifecycleChecklistType
  status      LifecycleChecklistStatus  @default(PENDING)
  createdById String?
  createdAt   DateTime                  @default(now())
  completedAt DateTime?

  user  User                     @relation(fields: [userId], references: [id])
  tasks LifecycleChecklistTask[]

  @@index([userId, type])
  @@index([status])
}

/// A snapshot copy of one template task, plus its own completion state.
model LifecycleChecklistTask {
  id                    String         @id @default(cuid())
  checklistId           String
  taskKey               String
  title                 String
  description           String
  assignedRole          ClearanceRole
  requiredForCompletion Boolean
  prerequisiteTaskKeys  Json?
  completed             Boolean        @default(false)
  /// Bare scalar, not a relation — this row must still explain who signed
  /// off years later even if that User row is gone, the same
  /// "erasure the ledger cannot obey" reasoning TaskTransition.byUserId
  /// already documents.
  completedByUserId     String?
  completedByUserRole   ClearanceRole?
  completedAt           DateTime?

  checklist LifecycleChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, taskKey])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/hr's
/// CompaRatioCalculator): the salary range for one Rank, used to compute
/// compa-ratio and range penetration. One band per rank — a rank with none
/// is simply excluded from an audit, never assumed.
model CompensationBand {
  id                 String   @id @default(cuid())
  rankId             String   @unique
  minSalaryMinor     Int
  midpointSalaryMinor Int
  maxSalaryMinor     Int
  updatedAt          DateTime @updatedAt

  rank Rank @relation(fields: [rankId], references: [id])
}

/// A post in the org chart: "Finance Manager, North Region". The post
/// carries the rank and the unit; the person occupying it is a `Posting`. A
/// post outlives its occupant, which is what makes a vacancy expressible.
model Position {
  id          String  @id @default(cuid())
  title       String
  orgUnitId   String
  rankId      String
  /// The post this one reports to. The reporting line lives on the POST,
  /// not on the person, so a leaver does not sever the chain — a later
  /// escalation document walks this edge.
  reportsToId String?

  orgUnit   OrgUnit    @relation(fields: [orgUnitId], references: [id])
  rank      Rank       @relation(fields: [rankId], references: [id])
  reportsTo Position?  @relation("Reporting", fields: [reportsToId], references: [id])
  reports   Position[] @relation("Reporting")
  postings  Posting[]
  /// tasks-notifications-support/23-tasks-allotment-tracking.md (ADR-049) —
  /// the durable address work is assigned to. Cross-schema relation into
  /// tasks.prisma, same pack ('core'), no TypeScript coupling: `tasks`
  /// never imports `hr` and `hr` never imports `tasks`.
  tasks     Task[]

  @@index([orgUnitId])
  @@index([reportsToId])
}

/// Who holds which post, when. History, not a current-state column: last
/// year's attendance and payroll must resolve to the unit and rank the
/// person held THEN, not the one they hold now.
model Posting {
  id         String    @id @default(cuid())
  /// The User occupying this post — never a separate Employee row (ADR-044).
  userId     String
  positionId String
  /// Exactly one posting per user may be primary at a time. A person can
  /// genuinely hold two posts (acting cover, a shared services lead); the
  /// primary is the one payroll and the org chart use.
  isPrimary  Boolean   @default(true)
  startedOn  DateTime
  endedOn    DateTime?

  user     User     @relation(fields: [userId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@index([userId, endedOn])
  @@index([positionId, endedOn])
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETIRED
  LOST
}

model Asset {
  id                String      @id @default(cuid())
  /// The physical tag/serial a staff member reads off the item.
  assetTag          String      @unique
  /// Free text/data-driven, never a closed enum — "laptop", "phone",
  /// "uniform", "vehicle" and whatever a client adds later, unconstrained.
  category          String
  description       String
  /// Paisa. Optional — not every asset has a tracked purchase cost.
  purchaseCostMinor Int?
  purchasedOn       DateTime?
  status            AssetStatus @default(AVAILABLE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  assignments          AssetAssignment[]
  /// finance-accounting/147-fixed-asset-depreciation.md — at most one
  /// active schedule, per that document's own @@unique.
  depreciationSchedule AssetDepreciationSchedule?

  @@index([status])
}

/// One row per issue/return cycle — an asset's full custody history, never
/// overwritten. The same "history table, not a mutable current-holder
/// column" discipline StockMovement already establishes for stock:
/// `returnedAt IS NULL` is the one query answering "who currently has this,"
/// never a separate currentHolderId column on Asset that could drift from
/// the assignment history.
model AssetAssignment {
  id           String    @id @default(cuid())
  assetId      String
  userId       String
  issuedAt     DateTime  @default(now())
  issuedById   String
  returnedAt   DateTime?
  returnedById String?
  /// Free-text note at return ("scratched screen"), never required.
  condition    String?

  asset      Asset @relation(fields: [assetId], references: [id])
  user       User  @relation("AssetAssignmentHolder", fields: [userId], references: [id])
  issuedBy   User  @relation("AssetAssignmentIssuer", fields: [issuedById], references: [id])
  returnedBy User? @relation("AssetAssignmentReturner", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([userId, returnedAt])
}

// A client-supplied Idempotency-Key, closing the one gap doc 117's own
// domain-key strategy structurally cannot reach: the moment BEFORE a row
// exists to key against — creating it in the first place.
// architecture-patterns/157-client-request-idempotency-keys.md (WO-157.1).
// No organizationId (ADR-044/ADR-040): this deployment IS the tenant; every
// route this guards resolves its own actor without an organizationId today
// (some, like guest checkout, resolve no actor at all), so `(scope, key)`
// is already unique enough for a single-tenant deployment.

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyKey {
  id             String               @id @default(cuid())
  /// One per guarded route — "orders.place", "pos.sale.create".
  scope          String
  /// Client-supplied, opaque — one UUID per logical action, resent
  /// unchanged on every retry of that same action.
  key            String
  /// sha256 of the request body — catches key reuse with a DIFFERENT
  /// payload, refused rather than silently replayed.
  requestHash    String
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?

  @@unique([scope, key])
  @@index([createdAt])
}

/// Tracks a User's identity verification against nID (Newax's external
/// identity/KYC platform — https://github.com/nadeemmurtaza/nID). One row per
/// User: erp-1 is a single-tenant shop today, so there is exactly one nID
/// tenant (this shop) and one verification per person, not per case — a
/// retry after EXPIRED or REJECTED reuses this row rather than creating a
/// second one, since nidCaseId always points at nID's most recent case for
/// this user.
enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model IdentityVerification {
  id     String @id @default(cuid())
  userId String @unique

  /// nID's Subject.id for this user. Set on the first start() call and
  /// reused on every retry — nID's Phase 0 has no dedup of its own (a
  /// second POST /v1/subjects with the same externalRef creates a second
  /// Subject), so this column is where that idempotency actually lives.
  /// See NidVerificationProvider.start().
  nidSubjectId  String?
  /// nID's VerificationCase.id for the current or most recent attempt.
  nidCaseId     String?
  status        IdentityVerificationStatus @default(NOT_STARTED)
  /// The VerificationMethodProvider key nID resolved the case with, e.g. "otp_sms".
  method        String?
  failureReason String?

  startedAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Layby and instalment sales (finance-accounting/151-layby-installment-sales.md)
// — a schedule of expected payments against one order, a variant of two
// mechanisms this repository already has: a payment-schedule shape
// generalised from doc 145's own paymentTermDays, and Payment's own
// multi-tender-per-order capability (Payment.orderId is a plain FK, not
// unique — several Payment rows already coexist against one order).

/// LAYBY: goods held until paid in full — the order's own fulfilment is
/// gated on the plan reaching COMPLETED. INSTALMENT: goods released now,
/// paid off over time — the order proceeds through its ordinary status
/// transitions unaffected; the schedule only tracks what remains owed.
enum InstalmentPlanType {
  LAYBY
  INSTALMENT
}

enum InstalmentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

model InstalmentPlan {
  id           String               @id @default(cuid())
  orderId      String               @unique
  type         InstalmentPlanType
  /// Snapshotted from the order's own grandTotal at plan creation — never
  /// re-read live, so a later price correction elsewhere never reshapes an
  /// in-progress plan.
  totalMinor   Int
  depositMinor Int                  @default(0)
  status       InstalmentPlanStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  cancelledAt  DateTime?
  defaultedAt  DateTime?

  order    Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  schedule InstalmentScheduleLine[]
  payments InstalmentPayment[]

  @@index([status])
}

model InstalmentScheduleLine {
  id          String   @id @default(cuid())
  planId      String
  dueDate     DateTime
  amountMinor Int

  plan InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dueDate])
}

/// One row per actual payment received — never assumed to match the
/// schedule exactly; a customer paying early, late, or a different amount
/// than scheduled is normal, and the schedule is a plan, not a constraint
/// on what Payment rows can exist. `paymentId` is unique: a Payment belongs
/// to at most one plan's history, never double-counted into two.
model InstalmentPayment {
  id         String   @id @default(cuid())
  planId     String
  paymentId  String   @unique
  receivedAt DateTime @default(now())
  /// True only for the deposit collected at plan creation — the one payment
  /// `cancel()`'s deposit-forfeiture Setting can apply to; every later
  /// instalment payment is never subject to forfeiture, only the deposit is.
  isDeposit  Boolean  @default(false)

  plan    InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// Inventory: the stock ledger. Every change to ProductVariant.stock has
// exactly one StockMovement row, written in the same transaction, so the
// ledger replays to the live number and "why is stock 4" always has an answer.

enum StockMovementReason {
  PURCHASE_RECEIPT // goods received against a purchase order
  SALE // order placed
  CANCELLATION // order cancelled, stock returned to the shelf
  RETURN // customer returned goods
  ADJUSTMENT // manual correction by staff
  DAMAGE // written off as damaged
  COUNT // variance posted by a stock count
  WRITE_OFF // lost, stolen, expired
  PRODUCTION_CONSUMPTION // raw material consumed by a released WorkOrder
  PRODUCTION_RECEIPT // finished goods credited by a completed WorkOrder
  POS_SALE // till sale (RETAIL-ERP.md R11) — distinct from SALE so a ledger read can tell channel apart without joining Order
  POS_OFFLINE_VARIANCE // InventoryService.postUnconditional() drove a variant negative (R5) — paired 1:1 with a StockVariance row
  TRANSFER_OUT // WO-22.1: leaving a location (source on dispatch, or the in-transit bucket returning to source on cancel)
  TRANSFER_IN // WO-22.1: arriving at a location (the in-transit bucket on dispatch, or the destination/source on receive/cancel)
}

model StockMovement {
  id             String              @id @default(cuid())
  variantId      String
  /// Positive = stock in, negative = stock out. NEVER zero.
  delta          Int
  /// Stock level AFTER this movement, so history reads without replaying deltas.
  resultingStock Int
  reason         StockMovementReason

  /// Which location this movement happened at. Every deployment gets a
  /// default Location row in the backfill migration (B6, MULTI-SECTOR.md), so
  /// this is never actually optional at the application layer even though it
  /// is nullable here for one release, per the expand/contract rule
  /// (00-HOUSE-RULES.md §4).
  locationId String?

  /// What caused it: "Order" | "GoodsReceipt" | "StockCount" | null for manual.
  refType String?
  refId   String?

  /// Unit cost in paisa at the moment of the movement. Set on PURCHASE_RECEIPT
  /// (what we paid) and on SALE (what it cost us - the COGS figure). Null for a
  /// movement where cost is not meaningful.
  unitCost Int?

  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor           User?            @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  lotAllocations  LotAllocation[]
  serializedUnits SerializedUnit[]

  @@index([variantId, createdAt])
  @@index([reason, createdAt])
  @@index([refType, refId])
  @@index([locationId])
}

/// STORE/WAREHOUSE are physical, staffed or stocked normally. IN_TRANSIT is
/// neither — a transient bucket a StockTransfer (WO-22.1, R4) creates for
/// itself, holding exactly the quantity currently between two real
/// locations. Splitting it out as its own Location (rather than a flag on
/// the transfer) is what R4 turns on: everything VariantLocationStock and
/// the ledger already do for a real location comes free for "goods on a
/// truck" too, with no schema change and no unsafe cross-database constraint.
enum LocationType {
  STORE
  WAREHOUSE
  IN_TRANSIT
  /// WO-23.3, RETAIL-ERP.md R13: where a BomProductionRun consumes raw stock
  /// and credits finished stock. A deployment with no dedicated production
  /// floor keeps using its one WAREHOUSE/STORE location — this type exists
  /// for the deployment that wants the distinction, not as a requirement.
  PRODUCTION
}

/// A place stock physically lives. Single-location shops get exactly one row
/// (isDefault: true) and never see it in any UI — B6, MULTI-SECTOR.md.
model Location {
  id   String       @id @default(cuid())
  name String
  code String       @unique // "MAIN", "LHR-01" — short, used in ledger refs
  type LocationType @default(STORE)

  /// Which retail brand this location belongs to — null for every
  /// deployment today (the deployment's own implicit brand, brand.ts).
  /// Populated once sub-brands exist and a BRAND-tier database's locations
  /// need to say which sub-brand they serve.
  retailBrandId String?
  /// The node that reported this location — null for every deployment
  /// today. Scaffolding for R6 point 2 ("Location.code" is one of the
  /// natural keys R6 names as needing `@@unique([originNodeId, value])`
  /// once branches create locations independently), deliberately NOT wired
  /// into `code`'s constraint yet: Postgres does not treat two NULLs as
  /// equal in a composite unique index, so `@@unique([originNodeId, code])`
  /// with both columns nullable would let two STANDALONE-deployment
  /// locations both be coded "MAIN" — silently *weaker* than today's
  /// `@unique`, the opposite of the point. Needs a NULL-safe index (a
  /// COALESCE'd expression index, hand-written into the migration) before
  /// it can replace the plain unique below — deferred alongside
  /// Product.slug/SKU/barcode (WO-18.2's commit), not attempted half-safe.
  originNodeId  String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  address       Json?
  createdAt     DateTime @default(now())

  retailBrand       RetailBrand?           @relation(fields: [retailBrandId], references: [id], onDelete: SetNull)
  stocks            VariantLocationStock[]
  movements         StockMovement[]
  workOrders        WorkOrder[]
  variances         StockVariance[]
  spotCheckPolicies SpotCheckPolicy[]
  spotChecks        SpotCheck[]
  lotStocks         LotStock[]
  serializedUnits   SerializedUnit[]

  @@index([isActive])
  @@index([retailBrandId])
}

enum StockVarianceStatus {
  OPEN
  RESOLVED
}

/// One row per oversell InventoryService.postUnconditional() let through (R5:
/// a POS sale that already happened is never rejected by sync). Paired with
/// the StockMovement (POS_OFFLINE_VARIANCE) that recorded the actual negative
/// delta; this row is the exception queue a manager works from, and its
/// posting rule (posting-rules.subscriber.ts) books the shrinkage journal
/// (R15). refType/refId follow StockMovement's own convention rather than a
/// relation, so inventory stays independent of orders/pos.
model StockVariance {
  id              String              @id @default(cuid())
  variantId       String
  locationId      String
  /// Positive magnitude the variant went negative by. Always > 0.
  overshootQty    Int
  stockMovementId String              @unique
  refType         String?
  refId           String?
  status          StockVarianceStatus @default(OPEN)

  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?

  /// 156-single-employee-branch-loss-prevention.md. The OPEN PosShift at
  /// this location when this variance's own underlying movement happened —
  /// resolved once, inside the same transaction as the variance itself,
  /// never reassigned after the fact. Null when no shift was open (a
  /// non-POS location, or a variance predating this column).
  posShiftId String?

  /// 158-serialized-unit-tracking.md §4 — set when the missing/oversold item
  /// is serial-tracked, naming the EXACT unit rather than only the SKU.
  /// Additive: every variance predating serials, or on a non-serialized
  /// variant, keeps this null.
  serializedUnitId String?

  createdAt DateTime @default(now())

  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  posShift       PosShift?       @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  serializedUnit SerializedUnit? @relation(fields: [serializedUnitId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([variantId])
  @@index([locationId])
  @@index([posShiftId])
  @@index([serializedUnitId])
}

/// 156-single-employee-branch-loss-prevention.md §3. An expected cadence for
/// unpredictable spot counts at a location — never a fixed schedule
/// ("we always count on the 1st"), the exact predictability this document
/// names as the weaker alternative.
model SpotCheckPolicy {
  id              String   @id @default(cuid())
  /// Null = applies to every location with no more specific policy.
  locationId      String?
  minSkusPerCheck Int      @default(5)
  /// An EXPECTED cadence in days, not a fixed schedule — InventoryCron rolls
  /// a randomized due-check within this window.
  frequencyDays   Int      @default(3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  checks   SpotCheck[]

  @@index([locationId, isActive])
}

enum SpotCheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A small, unscheduled StockCount-like sheet — a handful of SKUs, never the
/// whole shop, completable in minutes on the POS/mobile device.
model SpotCheck {
  id           String          @id @default(cuid())
  policyId     String
  locationId   String
  status       SpotCheckStatus @default(PENDING)
  scheduledFor DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  policy   SpotCheckPolicy @relation(fields: [policyId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])
  lines    SpotCheckLine[]

  @@index([locationId, status])
  @@index([policyId, scheduledFor])
}

model SpotCheckLine {
  id          String @id @default(cuid())
  spotCheckId String
  variantId   String
  /// System stock at the moment the check was scheduled — frozen, the same
  /// "expected is frozen at start" discipline WO-1.7's StockCountLine
  /// already established.
  expected    Int
  counted     Int?
  /// counted - expected, written when the check completes.
  variance    Int?

  spotCheck SpotCheck      @relation(fields: [spotCheckId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([spotCheckId, variantId])
}

/// Stock, per variant, per location. The thing InventoryService.move() writes
/// to. ProductVariant.stock is a denormalized SUM across this table for that
/// variant, recomputed inside the same transaction as every write — see
/// InventoryService.move() and 17-inventory-locations.md.
model VariantLocationStock {
  variantId  String
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([variantId, locationId])
}

/// CACHE: variantId as primary key. Safe to delete and recompute.
model VariantSalesStat {
  variantId           String    @id
  units30             Int       @default(0)
  units90             Int       @default(0)
  lastSoldAt          DateTime?
  daysOfCover         Float?
  ageDays             Int?
  isSlowMover         Boolean   @default(false)
  isDeadStock         Boolean   @default(false)
  lastLowStockAlertAt DateTime?
  computedAt          DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

/// WO-9.3 (09-ai-layer.md). No model, deliberately — "for a boutique with a
/// year of history, a well-chosen average beats an over-fitted model" (the
/// doc's own words). `seasonalFactor` is this same period last year's units
/// divided by the trailing-30 baseline (1.0 = no seasonal effect); a null
/// means there isn't a year of history yet to compare against, and the
/// forecast falls back to the trailing average alone. CACHE, same idiom as
/// VariantSalesStat: safe to delete and recompute, written by the same
/// nightly InventoryCron pass that already computes units30/units90.
model VariantForecast {
  variantId             String    @id
  forecastedDailyDemand Float     @default(0)
  seasonalFactor        Float?
  /// Null until preferredSupplier/leadTimeDays and the forecast together
  /// place a stockout inside that lead time — see InventoryCron's own
  /// comment on how this is computed, not derived at read time.
  projectedStockoutAt   DateTime?
  reasonEn              String?
  computedAt            DateTime  @default(now())

  /// Ecosystem audit 2026-10-30 (merged from @newaxhq/inventory's dynamic
  /// safety-stock formula) — advisory only, same posture as every field
  /// above: InventoryCron computes these from real demand variance and
  /// SupplierLeadTimeObservation's own lead-time variance, but never writes
  /// ProductVariant.reorderPoint itself. Null when there is no preferred
  /// supplier to derive a lead time from.
  safetyStockUnits      Int?
  suggestedReorderPoint Int?
  serviceLevelPercent   Int?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

/// WO-9.8. One row per slow-mover/dead-stock variant InventoryCron has
/// already flagged (VariantSalesStat.isSlowMover/isDeadStock) that a person
/// has not yet acted on. `discountId` is null until CREATED — the Discount
/// itself (promotions.prisma) is what a person actually activates
/// (`isActive: false` on creation); this row is only the reasoning trail
/// ("20% off clears an estimated 60% in 30 days; margin falls from Rs 900 to
/// Rs 210 a unit", the doc's own example) that a bare Discount row cannot
/// carry on its own.
enum MarkdownSuggestionStatus {
  PENDING
  CREATED
  DISMISSED
}

model MarkdownSuggestion {
  id                     String                   @id @default(cuid())
  variantId              String
  discountId             String?
  suggestedBps           Int
  estimatedClearancePct  Float
  estimatedClearanceDays Int
  marginBeforePaisa      Int
  marginAfterPaisa       Int
  status                 MarkdownSuggestionStatus @default(PENDING)
  createdAt              DateTime                 @default(now())
  resolvedAt             DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, status])
  @@index([status, createdAt])
}

// 32-lots-batch-expiry-fefo.md, DECISIONS.md ADR-068. `lots` is core, not a
// pack (MULTI-SECTOR.md's own ruling: "a bakery, a chemist and a battery
// warehouse need the identical sub-ledger") — a sub-ledger UNDER the
// existing VariantLocationStock row, never a second stock model. LotStock's
// quantity for a given (lotId, locationId) sums, across every lot of a
// variant, to that variant/location's own VariantLocationStock.quantity —
// the same predicate-on-write invariant House Rule 10 already requires for
// ordinary stock, enforced by LotsService, never a nightly reconciliation.
model Lot {
  id               String    @id @default(cuid())
  productVariantId String
  /// The manufacturer's or the receiving branch's own batch code — unique
  /// per variant, not global; two suppliers legitimately reuse "L001".
  lotCode          String
  expiresOn        DateTime?
  receivedOn       DateTime  @default(now())
  /// The goods receipt this lot was created from — a bare scalar, per this
  /// schema's existing cross-module decoupling convention (StockMovement
  /// already names `sourceRef` the same way; GoodsReceipt is `purchasing`,
  /// a separate module from `inventory`).
  sourceReceiptId  String?
  createdAt        DateTime  @default(now())

  variant     ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  stocks      LotStock[]
  allocations LotAllocation[]

  /// bom.prisma — a production run whose FINISHED output belongs to this lot
  /// (71-recipe-batch-traceability.md). Both `lots` and `bom` are core, so
  /// this is an ordinary core-to-core relation, not a cross-pack coupling.
  outputOfRuns    BomProductionRun[]     @relation("BomOutputLot")
  /// Every BomProductionLine that consumed this lot as a raw-material input.
  consumedByLines BomProductionLineLot[]
  /// 158-serialized-unit-tracking.md — units that shipped in this batch,
  /// when the supplier also lot-codes. Null-able on the SerializedUnit side:
  /// a sector may use serials without ever using lots.
  serializedUnits SerializedUnit[]

  @@unique([productVariantId, lotCode])
  @@index([expiresOn])
}

/// The per-location quantity for ONE lot. VariantLocationStock stays the
/// authoritative total per variant/location; this table's rows for a given
/// (variantId, locationId) must sum to that total.
model LotStock {
  id         String @id @default(cuid())
  lotId      String
  locationId String
  quantity   Int    @default(0)

  lot      Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([lotId, locationId])
  @@index([locationId])
}

/// One row per unit of movement that consumed a specific lot — the join a
/// recall query walks. Written by LotsService at the moment of allocation,
/// inside the same transaction as the StockMovement it belongs to, never
/// backfilled after the fact.
model LotAllocation {
  id              String   @id @default(cuid())
  lotId           String
  stockMovementId String
  quantity        Int
  allocatedAt     DateTime @default(now())

  lot           Lot           @relation(fields: [lotId], references: [id])
  stockMovement StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)

  /// A movement legitimately draws from a given lot at most once — this is
  /// the "second copy of the write" guard: a redelivered/retried allocation
  /// call for the same (lot, movement) pair is a no-op, never a duplicate
  /// row or a double-decremented LotStock.
  @@unique([lotId, stockMovementId])
  @@index([lotId])
  @@index([stockMovementId])
}

// 158-serialized-unit-tracking.md, DECISIONS.md ADR-068. The other end of
// the same idea `lots` already proves: a lot groups many units under one
// batch identity, a serial number gives exactly one unit its own identity.
// No organizationId (ADR-040/044/046/049/060/062, and this document's own
// doc-148/doc-144 precedent): this deployment IS the tenant boundary, so
// `serialNumber` is unique across the whole deployment, not per-org — the
// stricter, more correct constraint for a manufacturer-assigned identifier
// (an IMEI is already globally unique in the real world).
enum SerializedUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  RMA_TO_SUPPLIER
  WRITTEN_OFF
}

model SerializedUnit {
  id               String               @id @default(cuid())
  productVariantId String
  /// Manufacturer-assigned in the overwhelming majority of cases (IMEI, a
  /// printed serial) — this system records it, never generates it, unlike
  /// documentNumber()'s own sequence-generated codes elsewhere in this repo.
  serialNumber     String               @unique
  status           SerializedUnitStatus @default(IN_STOCK)
  /// The batch this unit shipped in, when the supplier also lot-codes —
  /// null when the sector uses serials without lots.
  lotId            String?
  /// Current location, valid only while status = IN_STOCK. History of how it
  /// got there is StockMovement's own job — never duplicated here as a
  /// second location ledger.
  locationId       String?
  /// Set once, on SOLD — which order carried this exact unit out the door.
  /// A bare scalar, no relation: `orders` is a separate module from
  /// `inventory`, the identical decoupling GoodsReceipt.locationId already
  /// uses for `purchasing`.
  orderId          String?
  /// The StockMovement that produced the CURRENT status. Deliberately NOT
  /// unique, correcting an internal contradiction in this document's own
  /// draft: its own prose claimed "unique per movement," but its own §2
  /// code sample already shares ONE receiving movement (delta = line
  /// quantity) across every serial received in that line — the code's
  /// shape is the one actually consistent with how `receiveGoods()`
  /// batches a line's stock movement rather than moving one unit at a
  /// time. Idempotency instead comes from the status check
  /// `sellSerializedUnit()` already performs (`status !== 'IN_STOCK'`
  /// refuses a retry outright), the same guard the doc's own toxic-pair
  /// answer names — never from a uniqueness constraint a genuinely shared
  /// movement would violate on receipt.
  stockMovementId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  variant       ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  lot           Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  location      Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stockMovement StockMovement?  @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  variances     StockVariance[]

  @@index([productVariantId, status])
  @@index([orderId])
  @@index([stockMovementId])
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockCount {
  id          String           @id @default(cuid())
  countNumber String           @unique
  status      StockCountStatus @default(DRAFT)
  note        String?

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdBy  String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines StockCountLine[]

  creator  User? @relation("StockCountCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignee User? @relation("StockCountAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status])
}

model StockCountLine {
  id           String @id @default(cuid())
  stockCountId String
  variantId    String

  expected Int?
  counted  Int?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockCount StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, variantId])
}

// Trading-partner invoices and quotes (WO-18.3's remaining "forth"
// documents, 18-trading-partner-network.md) — a bounded MVP, not
// RETAIL-ERP.md's full R18 `invoicing` module. R18 asks for a legal,
// gapless-per-fiscal-year number allocated at the brand tier, CreditNote,
// payment terms and AR aging across every customer; that needs the
// accounting module's FiscalYear/FiscalPeriod machinery and is its own,
// much larger tranche. This is smaller: a document a connected
// TradingPartner receives when staff choose to issue or send one, numbered
// the same R6-style way a PurchaseOrder is (advisory lock + MAX scan, see
// invoice.service.ts / quote.service.ts). `tradingPartnerId` and `orderId`
// are bare scalars, not relations — mirrors Supplier.tradingPartnerId
// (purchasing.prisma) — so this file adds no coupling to any other module,
// and "one order invoiced in parts" style linking stays out of scope.

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id               String      @id @default(cuid())
  number           String      @unique
  tradingPartnerId String
  status           QuoteStatus @default(SENT)
  currency         String
  validUntil       DateTime?
  lines            QuoteLine[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([tradingPartnerId])
  @@index([status])
}

model QuoteLine {
  id             String @id @default(cuid())
  quoteId        String
  quote          Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sku            String
  nameEn         String
  quantity       Int
  unitPriceMinor Int

  @@index([quoteId])
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique
  tradingPartnerId String
  /// Trace-back only — see file header. Never joined for financial totals.
  orderId          String?
  status           InvoiceStatus @default(ISSUED)
  currency         String
  issueDate        DateTime      @default(now())
  dueDate          DateTime?
  subtotalMinor    Int
  taxMinor         Int           @default(0)
  totalMinor       Int
  lines            InvoiceLine[]
  createdAt        DateTime      @default(now())

  @@index([tradingPartnerId])
  @@index([status])
  @@index([orderId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku            String
  nameEn         String
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int

  @@index([invoiceId])
}

// Phase 7 WO-7.7 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// Kept simple, per the brief's own words. Points are a ledger
// (`LoyaltyTransaction`), mirroring how `StoreCreditTransaction` (Phase 5)
// already proved this shape: `User.loyaltyPoints` is a cache, the ledger is
// the source of truth, and every write goes through `LoyaltyService`'s own
// conditional update, never a bare `prisma.user.update()`.
//
// Points are earned on DELIVERED, never on placement — crediting at
// placement would mint free points on every COD order a customer cancels
// before it ships. `@@unique([orderId, type])` is the actual guard: it makes
// earning (and, separately, reversing) idempotent per order at the database
// level, not merely by convention.
//
// Redemption does not get its own balance — it converts points straight into
// a `StoreCreditTransaction` (Phase 5's existing ledger), so there is exactly
// one place a customer's spendable balance lives.

enum LoyaltyTransactionType {
  EARNED
  /// Points converted to store credit (Phase 5's ledger) at a configured rate.
  REDEEMED
  /// The order that earned these points was later cancelled/returned.
  REVERSED
  /// A manual staff correction — always carries a note.
  ADJUSTED
}

model LoyaltyTransaction {
  id      String                 @id @default(cuid())
  userId  String
  /// Null for ADJUSTED; every EARNED/REVERSED ties to the order that caused it.
  orderId String?
  type    LoyaltyTransactionType
  /// Positive for EARNED/ADJUSTED-credit, negative for REDEEMED/REVERSED/ADJUSTED-debit.
  points  Int
  note    String?

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
  @@index([userId, createdAt])
}

/// Trailing-12-month spend bands. Few rows, staff-editable — a reference
/// table because a threshold and a benefit description is exactly what
/// `TaxRate`/`DeductionType` already are elsewhere in this schema, not
/// because loyalty needs its own framework.
model LoyaltyTier {
  id                   String  @id @default(cuid())
  name                 String
  /// Trailing-12-month spend required to hold this tier, in paisa.
  minSpend             Int
  benefitDescriptionEn String
  benefitDescriptionUr String?
  sortOrder            Int     @default(0)
  /// Ecosystem audit 2026-10-29 (merged from @newaxhq/loyalty): basis points
  /// applied on top of LoyaltyPointsPerRupeeBps when earning — 10000 = 1.0x
  /// (no change), 15000 = 1.5x. Previously computed and shown in balance()
  /// but never actually applied to earnForOrder()'s own points math, so a
  /// higher tier displayed a reward it never paid out.
  earnMultiplierBps    Int     @default(10000)

  @@index([minSpend])
}

/// One referee can be referred exactly once (`@@unique([refereeId])`) — the
/// actual guard against a customer collecting the same referral reward twice
/// by re-entering a code. `LoyaltyService` additionally refuses a referral
/// where the referrer and referee share a phone number or a shipping
/// address, the two signals this codebase can actually check without a
/// device-fingerprinting vendor it does not have (named honestly, not
/// silently skipped).
model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String
  code       String
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([referrerId])
}

// Campaigns and broadcasts. WO-8.4,
// docs/implementation/content-marketing-search/08-content-marketing-search.md.
//
// The `marketing` module already existed before this file (settings +
// MarketingAutomationCron's abandoned-cart/review/replenishment automation)
// — this is the data model that automation never needed but a campaign send
// does: who it went to, on which channel, and what happened.

enum CampaignChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  /// Contact.marketingOptOut was true, or the phone was in PhoneOptOut, at
  /// send time — checked then, never at list-build time (the doc's own
  /// non-negotiable).
  SKIPPED_OPT_OUT
  /// The channel needs something this Contact doesn't have — an email
  /// channel and no email on file, for one.
  SKIPPED_NO_CONTACT
  FAILED
  OPENED
  CLICKED
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  channel     CampaignChannel
  segmentId   String
  /// locale -> { subject?, body }. `subject` is read for EMAIL only.
  content     Json
  status      CampaignStatus  @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  segment    Segment             @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id            String                  @id @default(cuid())
  campaignId    String
  contactId     String
  status        CampaignRecipientStatus @default(PENDING)
  sentAt        DateTime?
  /// Set by the 1x1 open-tracking pixel route (email only).
  openedAt      DateTime?
  /// Set by the click-through redirect route.
  clickedAt     DateTime?
  failureReason String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

/// The phone-number equivalent of User.marketingEmailOptOut's unsubscribe
/// link. A campaign or an abandoned-cart phone touch (WO-8.5) may reach
/// someone with no account row to carry an opt-out flag on — this is the
/// durable record for that case, checked at send time by both
/// CampaignsService and MarketingAutomationCron.
model PhoneOptOut {
  phoneE164  String   @id
  optedOutAt DateTime @default(now())
}

// Measurements: garment types, their measurement fields, and saved customer
// profiles.
//
// Measurement fields are ROWS, not code. Staff add "cuff width" from the admin
// dashboard and every measurement form picks it up without a deploy. The Zod
// validator is built from these rows by packages/shared, so the API, the
// website and the mobile app enforce exactly the same rules.

enum MeasurementUnit {
  INCH
  CM
}

model GarmentType {
  id       String  @id @default(cuid())
  key      String  @unique // "kameez", "shalwar"
  labelEn  String
  labelUr  String
  order    Int     @default(0)
  isActive Boolean @default(true)

  /// The garment list IS the stitching price list, in paisa. A
  /// STITCHING_SERVICE product only overrides this when the customer picks one.
  stitchingPrice   Int     @default(0)
  /// Withdraws the garment from the stitching flow without hiding it from
  /// measurements or from jobs already in production.
  stitchingEnabled Boolean @default(true)

  /// Base fabric requirement in Gaz (36" width) from the tailoring reference table; null when unknown.
  baseFabricGaz Float?
  /// Regional/synonym display names, e.g. ["Anarkali", "Panel Dress", "Gown"].
  aliasesEn     String[] @default([])
  aliasesUr     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields        MeasurementField[]
  profiles      MeasurementProfile[]
  optionGroups  StitchingOptionGroup[]
  stitchingJobs StitchingJob[]
  /// Cart lines waiting to be made into this garment.
  /// STITCHING_SERVICE products that stitch this garment.
  /// Unstitched fabrics that can be made into this garment.
  sizeChart     GarmentSizeChart[]

  @@index([isActive, order])
}

model MeasurementField {
  id            String          @id @default(cuid())
  garmentTypeId String
  key           String // "chest", "sleeve_length"
  labelEn       String
  labelUr       String
  unit          MeasurementUnit @default(INCH)
  /// Inclusive bounds in `unit`; they reject fat-fingered entry (38 vs 380).
  min           Float
  max           Float
  required      Boolean         @default(true)
  order         Int             @default(0)
  helpEn        String?
  helpUr        String?
  isActive      Boolean         @default(true)

  garmentType GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)

  @@unique([garmentTypeId, key])
  @@index([garmentTypeId, order])
}

/// A saved set of measurements: "Ammi – kameez", "Self – shalwar".
model MeasurementProfile {
  id            String      @id @default(cuid())
  userId        String
  garmentTypeId String
  label         String
  /// field key -> value, validated against the garment's MeasurementFields.
  values        Json
  notes         String?
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Restrict)

  @@unique([userId, garmentTypeId, label])
  @@index([userId])
}

/// A standard RTW size row (XS-XXL) for a garment, offered as a shortcut
/// alongside the "type your own measurements" flow.
model GarmentSizeChart {
  id            String   @id @default(cuid())
  garmentTypeId String
  sizeToken     String // "XS" | "S" | "M" | "L" | "XL" | "XXL"
  /// field key -> value, same shape as MeasurementProfile.values, validated against the garment's active MeasurementFields.
  values        Json
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  garmentType GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)

  @@unique([garmentTypeId, sizeToken])
  @@index([garmentTypeId, order])
}

// A general metadata-driven UI engine, built by explicit owner override
// (ADR-026) — architecture-patterns/141-general-metadata-driven-ui-engine.md
// (WO-141.1). No organizationId (ADR-044/ADR-040): this deployment IS the
// tenant.
//
// `fields` is the FieldMetadata[] shape the renderer consumes; it is stored
// as JSON because its own shape (a list of field descriptors) has no useful
// relational structure of its own, matching this repository's own JSONB
// idiom (doc 104's own `customFields` column) rather than a five-table join
// to describe "a list of fields." This model describes the FORM only — it
// stores no values of its own; a screen that renders one decides where its
// own values live (the one built here reuses doc 140's own EntityAttribute
// rows, never a second, parallel value-storage mechanism).

model FormMetadata {
  id         String   @id @default(cuid())
  /// Which entity this form describes — validated against Prisma.ModelName
  /// at write time (FormMetadataService's own check), the same mitigation
  /// doc 140 already established for the identical typo risk.
  entityType String   @unique
  /// FieldMetadata[]: { key, label, valueType, isRequired, options?, helpText? }
  fields     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Phase 7 WO-7.8 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// Transactional categories (order confirmation, payment result) are not
// represented here at all — they are not opt-out, so there is nothing to
// store. Only the categories a customer may actually turn off exist as rows:
// stitching progress, marketing, and back-in-stock alerts.
//
// `marketing` × `email` is the one cell this table does NOT own: it already
// has a real, wired subscriber (`User.marketingEmailOptOut`, read by
// `MarketingAutomationCron`'s abandoned-cart and review-request sends) that
// predates this model. Duplicating that one cell into a second store would
// create two sources of truth for the same fact, so `NotificationsService`
// reads/writes that specific cell through the existing column and every
// other (channel, category) pair through this table. Absence of a row means
// enabled — a customer who has changed nothing needs no rows at all.
//
// SMS and WhatsApp have no wired `NotificationChannel` implementation yet
// (doc 33, `docs/implementation/integrations-connectivity/33-sms-whatsapp-channels.md`,
// is written but unbuilt) — their preference rows are honestly inert until
// that channel exists, the same "absent collaborator" pattern this repo
// already uses for JazzCash/Easypaisa before their credentials exist.

enum NotificationPreferenceChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationPreferenceCategory {
  STITCHING_PROGRESS
  MARKETING
  BACK_IN_STOCK
}

model NotificationPreference {
  id       String                         @id @default(cuid())
  userId   String
  channel  NotificationPreferenceChannel
  category NotificationPreferenceCategory
  enabled  Boolean                        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
}

// Internal notifications, meetings and escalation
// (tasks-notifications-support/24-internal-notifications-meetings-escalation.md,
// DECISIONS.md ADR-060).
//
// Delivery itself is NOT rebuilt here — NotificationChannel/EmailChannel/
// ExpoPushChannel/LogChannel/NotificationsService (core/notifications/)
// already exist and are reused unchanged. What was missing was AUDIENCE:
// saying "every department head in the North region" and having it resolve
// to people, at send time, not at draft time.
//
// No organizationId anywhere in this file (ADR-040/044/046/049): this
// deployment IS the tenant boundary. EscalationRule.sourceType is unique
// alone, the same correction TaskStageDefinition.key already makes.

/// Who a message goes to, stored as a specification, not a list of user
/// ids — "the finance department" must mean the finance department ON THE
/// DAY IT SENDS, not the membership frozen when somebody drafted it.
model Audience {
  id String @id @default(cuid())

  /// Root of the subtree this addresses. NULL means the whole
  /// organization (subject to the sender's own reach at resolve time).
  orgUnitId String?
  /// Include units below the root, or only the root itself.
  includeDescendants Boolean @default(true)
  /// Only people at or above this rank level (hr.prisma's Rank.level).
  /// NULL means everyone.
  minRankLevel Int?
  /// Only these positions, when the audience is a named handful.
  positionIds String[]

  createdByUserId String
  createdAt       DateTime @default(now())

  broadcasts BroadcastMessage[]
  meetings   Meeting[]

  @@index([orgUnitId])
}

/// A record that an internal message was actually sent — the "reversal
/// document" lens answer for this module: a sent message cannot be
/// unsent, so this row is the permanent, immutable proof of what went out,
/// to whom, and when. Not a second delivery mechanism: `recipientCount`
/// and `excludedCount` are computed by AudienceService.resolve() against
/// the sender's own reach, and the actual fan-out is NotificationsService,
/// unchanged.
model BroadcastMessage {
  id       String @id @default(cuid())
  senderId String
  audienceId String

  subject String
  body    String

  /// How many recipients the send actually reached.
  recipientCount Int
  /// How many the sender's own requested audience named that their reach
  /// excluded — shown on the compose screen BEFORE send, stored here so
  /// the record matches what the sender was shown, never a surprise
  /// after the fact.
  excludedCount Int @default(0)

  /// Above ANNOUNCE_QUORUM_RANK (Setting) or addressed to more than N
  /// people, a broadcast needs a countersignature before it sends — see
  /// notify.service.ts's own comment. NULL when no approval was required.
  approvalChainId String? @unique
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  audience Audience @relation(fields: [audienceId], references: [id])

  @@index([senderId, createdAt])
}

model Meeting {
  id         String   @id @default(cuid())
  title      String
  detail     String?
  startsAt   DateTime
  endsAt     DateTime
  /// A group spans zones — same rule as AttendanceEvent (doc 22).
  timezone   String
  location   String?
  audienceId String
  calledByUserId String
  orgUnitId  String
  createdAt  DateTime @default(now())
  /// Cancellation is a notice to the same materialised invitation list,
  /// never a delete — see MeetingsService.cancel()'s own comment.
  cancelledAt DateTime?

  audience    Audience            @relation(fields: [audienceId], references: [id])
  invitations MeetingInvitation[]

  @@index([orgUnitId, startsAt])
}

enum InviteResponse {
  NO_RESPONSE
  ACCEPTED
  DECLINED
  TENTATIVE
}

/// Materialised at send time — resolved once from the Audience, then
/// fixed, so a person invited Monday can still answer Tuesday after being
/// moved to another department. The audience is a live spec; this list is
/// a record.
model MeetingInvitation {
  id         String  @id @default(cuid())
  meetingId  String
  userId     String
  /// Required means the meeting's shortfall report counts this person
  /// when they have not answered; optional means it does not.
  required    Boolean        @default(true)
  response    InviteResponse @default(NO_RESPONSE)
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId, response])
}

/// The timer that makes a stalled task visible — climbs Position.reportsTo,
/// never a person, so a vacant post is skipped to its own reportsTo (the
/// leaver case, handled by construction, same as doc 23's own unclaiming).
/// Watches Task rows (tasks.prisma) by Task.sourceType, the identical
/// (type, id) convention doc 23 already uses for its own event intake, so
/// this module imports no module it escalates for and no module imports
/// this one.
model EscalationRule {
  id String @id @default(cuid())

  /// Matches Task.sourceType. Unique alone (no organizationId — this
  /// deployment IS the tenant).
  sourceType String @unique
  /// How long without a state change (a new TaskTransition) before it fires.
  afterMinutes Int
  /// How many rungs up Position.reportsTo to climb per fire.
  stepsPerFire Int @default(1)
  /// Stop climbing here (Rank.level). NULL climbs to the root, which is
  /// almost never wanted.
  ceilingRankLevel Int?
  maxFires         Int @default(3)

  fires EscalationFire[]
}

/// One row per actual escalation fire — the idempotency and fire-count
/// tracking EscalationRule.maxFires needs. `@@unique([taskId, fireNumber])`
/// is the guard: a cron tick that overlaps a previous one can only ever
/// insert the same (taskId, fireNumber) once.
model EscalationFire {
  id                  String   @id @default(cuid())
  taskId              String
  ruleId              String
  /// 1, 2, 3… up to the rule's own maxFires.
  fireNumber          Int
  /// The Position this fire actually notified, after skipping vacant
  /// posts and applying the ceiling.
  climbedToPositionId String
  firedAt             DateTime @default(now())

  rule EscalationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([taskId, fireNumber])
  @@index([taskId])
}

// A bulletin board (tasks-notifications-support/61-policy-communications-bulletin.md,
// DECISIONS.md ADR-062). Doc 24's own delivery is reused unchanged for the
// "you have a new notice" ping (BulletinNotificationListener calls
// AudienceService.resolve()/NotificationsService.send() exactly as
// NotifyService does) — this is the missing RECORD, never a second
// delivery mechanism. Lives here, not in `hr` (the doc's own casual
// suggestion), because it reuses AudienceService.resolve() directly:
// hr and notify are separate module packs with no approved coupling, and
// the doc's own "never a bulletin-specific second audience-resolution
// mechanism" rule leaves no other place to put it.

/// One published notice. `authorId`/`BulletinAcknowledgement.userId` — no
/// `Employee` model exists in this codebase (every actor is `User`,
/// ADR-044/040), and no `organizationId` (this deployment IS the tenant,
/// ADR-040/044/046/049/060) — both are deviations from this document's own
/// literal sketch, the same two this session's every other doc-24-family
/// build already makes.
model Bulletin {
  id           String           @id @default(cuid())
  authorId     String
  title        String
  bodyMarkdown String
  category     BulletinCategory

  /// NULL means the whole organization; otherwise the subtree rooted here
  /// (OrgUnit.path), exactly as Audience.orgUnitId already means for doc 24.
  audienceOrgUnitId String?

  publishedAt DateTime  @default(now())
  /// Optional — some notices are time-bound.
  expiresAt   DateTime?
  requiresAcknowledgement Boolean @default(false)

  /// A bulletin is retracted, never deleted — "the reversal document" lens:
  /// removes it from the active list while the row and every
  /// acknowledgement already recorded against it remain (JournalEntry
  /// reversal's own "never erased, only superseded" discipline).
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgements BulletinAcknowledgement[]

  @@index([audienceOrgUnitId, publishedAt])
}

enum BulletinCategory {
  POLICY
  MEMO
  NOTICE
  HR_ANNOUNCEMENT
}

/// `@@unique([bulletinId, userId])` is the whole mechanism: a double-click
/// of "acknowledge" is a P2002 the service swallows, never a duplicate row.
model BulletinAcknowledgement {
  id             String   @id @default(cuid())
  bulletinId     String
  userId         String
  acknowledgedAt DateTime @default(now())

  bulletin Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId])
}

// On-site messaging. WO-8.6,
// docs/implementation/content-marketing-search/08-content-marketing-search.md.
//
// "Keep it restrained. Three popups on one page loses more revenue than any
// of them earns" — the doc's own words — is why every message here targets a
// page and, optionally, a segment, and is scheduled rather than always-on.

enum OnsiteMessageKind {
  ANNOUNCEMENT_BAR
  POPUP
  NEWSLETTER_CAPTURE
  COOKIE_CONSENT
}

enum OnsitePopupTrigger {
  IMMEDIATE
  TIMED
  EXIT_INTENT
}

model OnsiteMessage {
  id           String             @id @default(cuid())
  kind         OnsiteMessageKind
  /// A path prefix ("/", "/shop", "/product") — null targets every page.
  pagePattern  String?
  segmentId    String?
  trigger      OnsitePopupTrigger @default(IMMEDIATE)
  /// Seconds before showing. TIMED trigger only.
  delaySeconds Int?
  linkUrl      String?
  isActive     Boolean            @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  segment      Segment?                   @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  translations OnsiteMessageTranslation[]

  @@index([kind, isActive])
}

model OnsiteMessageTranslation {
  id              String  @id @default(cuid())
  onsiteMessageId String
  locale          String
  headline        String?
  body            String?
  ctaLabel        String?

  onsiteMessage OnsiteMessage @relation(fields: [onsiteMessageId], references: [id], onDelete: Cascade)

  @@unique([onsiteMessageId, locale])
}

/// A distinct, lightweight capture list — not folded into Contact. Most
/// submitters have never transacted, and forcing an immediate Contact row
/// for a bare anonymous email would pollute CRM dedup with addresses that
/// never become a sale. A subscriber who later orders is linked by Contact's
/// own email-dedup path when a real Contact is created from that order, not
/// from here.
model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  locale       String
  source       String    @default("onsite_popup")
  subscribedAt DateTime  @default(now())
  optedOutAt   DateTime?

  @@index([optedOutAt])
}

// Orders and shipments.
//
// Order lines are SNAPSHOTS. Name, price, measurements and stitching options
// are copied in at purchase time and never joined back to the live product —
// a price change or a renamed product must not rewrite history.

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// R11: a till sale is a channel of `orders`, not a parallel order system.
enum OrderChannel {
  WEB
  POS
}

/// WO-9.4 (09-ai-layer.md). The recommended action a rule-based COD-risk
/// score sorts an order into — never an instruction the system carries out
/// itself. "A person decides; the score sorts a queue" (the doc's own
/// words): nothing in this codebase auto-cancels or auto-requires payment
/// off this field alone.
enum CodRiskAction {
  AUTO_CONFIRM
  CONFIRMATION_CALL
  REQUIRE_ADVANCE_PAYMENT
}

model Order {
  id        String      @id @default(cuid())
  number    String      @unique // "YSN-2026-0001"
  userId    String?
  contactId String?
  status    OrderStatus @default(PENDING)
  currency  String      @default("PKR")

  /// R11's additive scalar columns. Bare scalars, not relations — `pos` and
  /// `organization` are separate modules from `orders` (module-boundary
  /// rule), and originNodeId is replication scaffolding (R6/R7), not
  /// currently written by anything. Null for every WEB order.
  channel      OrderChannel @default(WEB)
  locationId   String?
  terminalId   String?
  shiftId      String?
  originNodeId String?

  /// Guest checkout: no account, so contact details live on the order.
  guestName  String?
  guestEmail String?
  guestPhone String?

  /// WO-8.5 — which cart this order was placed from, set once at
  /// checkout(place()) and never rewritten. Purely for the recovered-revenue
  /// report: an order whose sourceCart had a reminder/incentive/first-touch
  /// send before placedAt is revenue marketing recovered. SetNull, not
  /// Cascade — a cart row can outlive or be pruned independently of an order
  /// that already has its own full snapshot of everything it needs.
  sourceCartId String?

  /// Address snapshots, not foreign keys — the address book is editable.
  shippingAddress Json
  billingAddress  Json?

  /// All amounts in paisa. Recomputed server-side from the cart at placement;
  /// the client's numbers are never trusted.
  itemsSubtotal     Int
  stitchingSubtotal Int @default(0)
  itemDiscountTotal Int @default(0)
  orderDiscount     Int @default(0)
  shippingFee       Int @default(0)
  codFee            Int @default(0)
  /// EXCLUSIVE-mode tax across the whole order, mirroring OrderItem.taxAmount
  /// summed -- kept here too so order lists/reports don't need to sum lines.
  /// 0 when tax is off or the shop uses INCLUSIVE mode (see 15-tax-module.md).
  taxAmount         Int @default(0)
  grandTotal        Int

  shippingZone String?
  customerNote String?
  staffNote    String?
  cancelReason String?
  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Set once MarketingAutomationCron sends the post-delivery review-request
  /// email (marketing.review_request) — the dedup flag, since the cron scans
  /// every DELIVERED order past the threshold on every run.
  reviewRequestSentAt DateTime?

  /// WO-9.4 — computed synchronously at place(), COD orders only (a paid
  /// order has already cleared, RTO risk does not apply). Null for every
  /// non-COD order, and for a COD order placed before this existed.
  codRiskScore      Int?
  codRiskAction     CodRiskAction?
  codRiskComputedAt DateTime?
  /// The single dominant reason CodRiskService picked codRiskAction — "start
  /// with a transparent rule-based score. It is explainable to staff" (the
  /// doc's own words). Staff-facing only, same as VariantForecast.reasonEn
  /// (WO-9.3); never shown to the customer.
  codRiskReasonEn   String?

  /// Which other module asked for this order and by what key (an auction
  /// settlement, WO-234.6). Null for every checkout and point-of-sale order.
  /// Unique together, so asking twice for the same thing yields the first order
  /// and never a second: the guard against a retry after a crash.
  sourceType String?
  sourceRef  String?

  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact                 Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceCart              Cart?                    @relation(fields: [sourceCartId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  statusEvents            OrderStatusEvent[]
  convertedLeads          Lead[]                   @relation("LeadConvertedOrder")
  /// finance.prisma's OrderEconomics (WO-B.3) — null until DELIVERED.
  economics               OrderEconomics?
  /// fulfilment.prisma's ReturnRequest (WO-6.6) — independent of
  /// Order.status; see ReturnRequest's own doc comment for why a return
  /// does not by itself move the order out of DELIVERED.
  returnRequests          ReturnRequest[]
  /// promotions.prisma's snapshot of every discount this order received (WO-5.3).
  orderDiscounts          OrderDiscount[]
  /// giftcards.prisma — gift-card/store-credit tender applied to this order, and any gift card this order purchased (WO-5.4/5.5).
  giftCardTransactions    GiftCardTransaction[]
  storeCreditTransactions StoreCreditTransaction[]
  /// instalments.prisma (finance-accounting/151-layby-installment-sales.md)
  /// — null for every ordinary immediate-tender-in-full sale.
  instalmentPlan          InstalmentPlan?
  giftCardsSold           GiftCard[]               @relation("GiftCardSourceOrder")
  /// Phase 7 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
  loyaltyTransactions     LoyaltyTransaction[]

  @@unique([sourceType, sourceRef])
  @@index([status, placedAt])
  @@index([userId])
  @@index([contactId])
  @@index([guestPhone])
  @@index([channel])
  @@index([shiftId])
  @@index([sourceCartId])
  @@index([codRiskAction, placedAt])
}

enum OrderItemFulfillmentStatus {
  READY
  /// Backordered against an externally sourced variant — waiting on a
  /// PurchaseOrder receipt (StockReplenished).
  AWAITING_STOCK
  /// Backordered against a producedInHouse variant — waiting on a WorkOrder
  /// completion (also StockReplenished; the two are indistinguishable to
  /// the customer, both just "stock isn't here yet").
  AWAITING_PRODUCTION
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  /// Kept for reporting; nullable so deleting a product cannot delete history.
  productId String?
  variantId String?

  kind         ProductKind
  nameEn       String
  nameUr       String?
  sku          String?
  imageUrl     String?
  variantLabel String? // "Medium / Ferozi"

  /// Per-unit amounts in paisa.
  unitPrice        Int
  unitCost         Int @default(0)
  quantity         Int @default(1)
  stitchingFeeUnit Int @default(0)
  discountUnit     Int @default(0)
  /// unitPrice*qty + stitchingFeeUnit*qty - discountUnit*qty
  lineTotal        Int

  /// Tax on this line, in paisa, AT THE MOMENT OF PURCHASE -- a snapshot
  /// like unitCost and unitPrice (House Rule 7). Zero for every order placed
  /// before this module existed or while tax.enabled is off; never
  /// backfilled. In EXCLUSIVE mode this is added on top of lineTotal; in
  /// INCLUSIVE mode it is extracted from a lineTotal that already contains
  /// it, for the invoice, and changes nothing the customer paid.
  taxAmount  Int @default(0)
  /// The rate actually applied, basis points, snapshotted for the same
  /// reason as taxAmount -- a later rate change must not rewrite history.
  taxRateBps Int @default(0)

  /// Stitching add-on snapshot.
  stitchingServiceId   String?
  stitchingServiceName String?
  garmentTypeKey       String?
  measurementSnapshot  Json?
  optionsSnapshot      Json?
  stitchingNotes       String?
  /// What the customer actually typed, kept alongside measurementSnapshot so a
  /// dispute can be settled against their own entry rather than the resolved set.
  measurementValues    Json?
  /// Option group key -> the customer's own words for that design area.
  customDesignText     Json?
  /// Which standard size (XS-XXL) the customer picked, when they used the RTW size chart instead of typing measurements. Kept for tailor/support reference; measurementValues still carries the actual numbers used.
  sizeToken            String?

  /// Set once MarketingAutomationCron sends a replenishment nudge
  /// (marketing.replenishment_reminder) for this line's Product.isConsumable
  /// item — per item, not per order, since one order can hold several.
  replenishmentReminderSentAt DateTime?

  /// Scoped to the LINE, not Order.status — a backordered item does not
  /// change what CONFIRMED/PROCESSING/etc. mean for the order as a whole
  /// (that state machine already tracks payment/fulfillment separately).
  /// Only set away from READY when checkout.allow_backorder is on; stays
  /// READY (the default) for every order placed with it off.
  fulfillmentStatus OrderItemFulfillmentStatus @default(READY)
  awaitingSince     DateTime?

  createdAt DateTime @default(now())

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  stitchingService   Product?            @relation("OrderItemStitchingService", fields: [stitchingServiceId], references: [id], onDelete: SetNull)
  /// fulfilment.prisma (WO-6.4/6.6) — both core, same as economics above.
  shipmentItems      ShipmentItem[]
  returnRequestItems ReturnRequestItem[]
  // No `stitchingJob` relation field here on purpose (B7, MULTI-SECTOR.md):
  // core must never type-reference an apparel-pack model, or core.prisma
  // cannot compile without the apparel schema present — which breaks any
  // client extraction that excludes apparel. StitchingJob (apparel) keeps a
  // plain `orderItemId` scalar column pointing here instead of a Prisma
  // relation; the join happens in application code
  // (EntityEnrichmentRegistry, or StitchingJobsService.attachOrderContext).

  /// Phase 7 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
  review Review?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  /// Courier provider key: "manual", "tcs", "leopards" — matches a live
  /// CourierProvider.key (fulfilment/courier-provider.ts), never trusted
  /// beyond that: booking goes through the provider the key names, not a
  /// courier-specific branch anywhere in this module.
  courier        String         @default("manual")
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  cost           Int? // paisa
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// WO-6.4's own extension fields (fulfilment module — Shipment itself
  /// stays here because orders already owns its lifecycle columns).
  methodId       String?
  weightGrams    Int?
  packageCount   Int       @default(1)
  labelUrl       String?
  manifestId     String?
  /// Courier-specific detail (label payload, webhook body) that doesn't earn
  /// its own column — never read for logic, only shown to support.
  meta           Json?
  /// Set the moment this shipment is recognised as a return-to-origin
  /// (WO-6.7) — a courier-initiated RETURNED with no matching customer
  /// ReturnRequest, as opposed to one raised through the returns flow.
  isRto          Boolean   @default(false)
  rtoAt          DateTime?
  failedAttempts Int       @default(0)
  /// FulfilmentCron's own bookkeeping: when this shipment was last polled,
  /// so a consignment that hasn't moved in days is not hit every 30 minutes
  /// forever (WO-6.5's own backoff rule) — see FulfilmentCron.pollActive().
  lastPolledAt   DateTime?

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method   ShippingMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  manifest Manifest?       @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  items    ShipmentItem[]
  events   ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([manifestId])
}

/// WO-9.4 (09-ai-layer.md) — nightly-cached inputs to CodRiskService's
/// "city RTO rate" and "order value versus the city's average" signals.
/// CodRiskCron recomputes every row from this node's own COD Shipment/Order
/// history; place() reads a row by city (a single indexed lookup) rather
/// than aggregating this on every checkout. Both counts come from the same
/// COD-shipment population, so the two signals never disagree about which
/// orders they're describing. A city absent from this table, or below the
/// shop's own minimum-sample setting, is simply not trusted yet — CodRiskService
/// treats that as "no signal", never as "zero risk".
model CityCodRiskStat {
  city           String   @id
  totalShipments Int
  rtoShipments   Int
  /// paisa.
  avgOrderValue  Int
  computedAt     DateTime @default(now())
}

/// Backing store for sequential per-year order numbers (YSN-2026-0001). One
/// row per year — this node's own row, in this node's own database, which
/// is why it stays correct once a chain deployment has more than one node
/// (WO-18.2): the sequence is allocated purely locally, and NODE_ID is
/// folded into the final string by document-number.ts, not into this
/// table. `counter` is incremented via a single atomic
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING`, which Postgres
/// serialises at the row level — no application-side lock or transaction
/// needed. See nextOrderNumber() in orders.service.ts for why: an earlier
/// version derived the next number by reading MAX(Order.number), which is a
/// read-then-write race (two concurrent checkouts could read the same max),
/// and a later version tried to fix that with an advisory lock — but the
/// lock has to span both the read AND the eventual Order insert to mean
/// anything, and by the time that insert happens the checkout has moved on
/// to unrelated work (inventory, payment, cart) that has nothing to do with
/// numbering. A counter reserves the number as its own atomic step, so it is
/// correct regardless of what the rest of checkout does afterwards — the
/// same way a gap appears after any failed insert on an auto-increment key
/// if the reserving checkout never completes.
model OrderNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// The `organization` module (RETAIL-ERP.md Part 5, WO-18.3) — the top tier
// of a multi-brand deployment, its roster of brands, per-brand policy, admin
// scoping, and the registry of this deployment's own child nodes. A
// togglable module, not core platform infra: off by default, and every
// deployment today runs with it off — see modules.registry.ts and
// module-packs.ts. Nothing outside this file's models should ever be
// non-empty until `organization` is switched on for a chain deployment.

/// The top tier — the owner's group, run by a super admin from one
/// dashboard (Part 1). Optional: a Chain-edition deployment (one brand,
/// many branches) has no Organization row at all; only an
/// Organization-edition deployment's ORG-tier database does, describing
/// itself. A BRAND-tier deployment never holds one — it knows its
/// organization only through PARENT_URL (WO-18.1), never a local row.
model Organization {
  id                       String   @id @default(cuid())
  name                     String
  /// R9's `org.allow_inter_brand_transfers` — off by default, the same
  /// permissive-switch-starts-closed convention `BrandPolicy`'s three flags
  /// already use. Read directly by TransfersService (WO-22.2) via Prisma,
  /// not through OrganizationService — a read, not a same-transaction
  /// write, so it needs no KNOWN_MODULE_COUPLINGS entry.
  allowInterBrandTransfers Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  retailBrands RetailBrand[]
}

/// A retail brand — the business entity a branch belongs to. Distinct from
/// `Brand` in catalog.prisma, which means the *maker* of a product (Gul
/// Ahmed, Khaadi); this is the retailer. This deployment's OWN identity
/// stays `packages/shared/src/brand.ts` (Br1: one deployment serves one
/// brand, resolved at build time) — never a row in this table. A row here
/// is always some OTHER retail brand: a sibling the organization also owns
/// (at an ORG-tier database), or a sub-brand nested under this deployment's
/// own brand (at a BRAND-tier database — "sub-brands live in here", Part 1).
/// Nesting is arbitrary depth via `parentId`, per the owner's own ruling
/// that a brand can have nested sub-brands.
model RetailBrand {
  id             String   @id @default(cuid())
  organizationId String?
  parentId       String?
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parent       RetailBrand?  @relation("RetailBrandHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     RetailBrand[] @relation("RetailBrandHierarchy")
  policy       BrandPolicy?
  locations    Location[]
  adminScopes  AdminScope[]
  nodes        Node[]
  /// hr-people-org/19-org-structure-offices-departments.md — units
  /// belonging to this brand; NULL on OrgUnit means group-wide.
  orgUnits     OrgUnit[]

  @@index([organizationId])
  @@index([parentId])
}

/// Per-brand policy switches (R9) — what R9 calls
/// `brand.allow_branch_product_creation` and its siblings, generalised from
/// a single Setting row (House Rule 4, still the answer while a deployment
/// has only its one implicit brand) to one row per `RetailBrand` once
/// sub-brands exist: sub-brand A may let its branches propose products,
/// sub-brand B may not. Replicates down (R2); enforced at both ends — the
/// branch for UX, the receiving tier on ingest, never trusted from the
/// branch alone. `org.allow_inter_brand_transfers` (R9's fourth switch) is
/// organization-level, not brand-level, and stays a plain Setting.
model BrandPolicy {
  id                         String   @id @default(cuid())
  retailBrandId              String   @unique
  allowBranchProductCreation Boolean  @default(false)
  allowBranchLocalPurchasing Boolean  @default(false)
  allowInterBranchTransfers  Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  retailBrand RetailBrand @relation(fields: [retailBrandId], references: [id], onDelete: Cascade)
}

enum AdminScopeLevel {
  ORG
  BRAND
  BRANCH
}

/// What a user's admin access is scoped to (R10) — never a role check
/// (House Rule 9 forbids `if (user.role === 'SUPER_ADMIN')`). A super admin
/// is simply a user holding an ORG-level AdminScope; that is the entire
/// mechanism, no special case anywhere else. `assertCanManageAtScope()` and
/// `scopeFilterFor()` (WO-18.4) read this — nothing does yet.
///
/// The composite unique below is real protection only at BRANCH level,
/// where both `retailBrandId` and `branchNodeId` are set: a null in *any*
/// column of a Postgres composite unique index exempts that row from
/// comparison entirely, so it cannot stop two identical ORG-level rows
/// (both nullable columns null) or two identical BRAND-level rows
/// (`branchNodeId` still null) for the same user — see the identical trap
/// on `Location.code`, caught and documented rather than repeated silently
/// here. Left unenforced at those two levels rather than reached for a
/// NULL-safe expression index ahead of any code that would actually create
/// a duplicate: harmless either way, since this is a grant table — a
/// duplicate row confers nothing an existence check over the single row
/// would not already.
model AdminScope {
  id            String          @id @default(cuid())
  userId        String
  level         AdminScopeLevel
  retailBrandId String?
  branchNodeId  String?
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailBrand RetailBrand? @relation(fields: [retailBrandId], references: [id], onDelete: Cascade)
  branchNode  Node?        @relation(fields: [branchNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, level, retailBrandId, branchNodeId])
  @@index([userId])
}

enum NodeRole {
  BRANCH
  BRAND
}

enum NodeStatus {
  ACTIVE
  SUSPENDED
}

/// A child node this deployment knows about — a brand's branches, or an
/// organization's brands (R1, R14; WO-18.1, moved here from core.prisma in
/// WO-18.3 once it had siblings to live beside — Part 5 owns it under
/// `organization`, not core platform infra). Recorded on the PARENT only: a
/// branch never lists itself here, its brand does, and that is what the
/// drill-down dashboard (R19, WO-18.5) reads and what the replication
/// engine (Tranche 3) will authenticate a child against. This deployment's
/// OWN identity is NODE_ROLE/NODE_ID (env.validation.ts), never a row in
/// its own Node table — a STANDALONE or BRANCH deployment has no tier below
/// it and this table stays empty.
model Node {
  id                String     @id @default(cuid())
  /// The child deployment's own NODE_ID. Globally unique the way every other
  /// natural key here is (R6) — two branches of the same brand, or two
  /// brands of different organizations, must never collide.
  nodeId            String     @unique
  role              NodeRole
  /// Display name for the admin drill-down — "Lahore — Gulberg", not a slug.
  label             String
  /// Where the parent reaches this child to pull facts and push policy.
  url               String
  /// SHA-256 of the credential this child presents on every replication
  /// call (WO-20.2) — same shape as `TradingPartner.inboundApiKeyHash`
  /// (trading-partners.prisma): issued once via `rotateInboundKey()`, shown
  /// to the operator raw exactly that once, never persisted or echoed back.
  /// The child is configured with the raw value as its own `PARENT_API_KEY`.
  inboundApiKeyHash String?    @unique
  status            NodeStatus @default(ACTIVE)
  lastSeenAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  /// WO-23.3c/e (RETAIL-ERP.md R9/R13, ADR-023). Which brand this child
  /// belongs to — a BRAND-role Node names the one brand that deployment
  /// represents; a BRANCH-role Node names the (sub-)brand it is a branch
  /// of. Null until an operator sets it (registration alone cannot infer
  /// it), which is itself meaningful: the receiving tier CANNOT resolve a
  /// `BrandPolicy` for an unbadged node and treats that the same as "policy
  /// says no" (fail closed, same reasoning as ADR-021's missing-row
  /// default), never as "no brand, so nothing to check."
  retailBrandId String?

  adminScopes AdminScope[]
  retailBrand RetailBrand? @relation(fields: [retailBrandId], references: [id], onDelete: SetNull)
  /// hr-people-org/19-org-structure-offices-departments.md — units whose
  /// data physically lives on this node.
  orgUnits    OrgUnit[]

  @@index([role])
  @@index([status])
  @@index([retailBrandId])
}

// The org tree: offices, regions, departments — whatever shape a client's
// own org chart takes (hr-people-org/19-org-structure-offices-departments.md).
//
// Deliberately orthogonal to the deployment topology (Organization ->
// RetailBrand -> Node, organization.prisma): that hierarchy is
// infrastructure, re-shaped by a migration; this one is re-drawn on a
// Tuesday when somebody reorganises. AdminScopeLevel is untouched — see
// DECISIONS.md ADR-044. No organizationId anywhere in this file: the
// Organization model is optional even when its own module is on, and that
// module is off by default in every deployment today, so a required
// organizationId here would make this file unusable on the deployment
// shape this repository actually ships (ADR-044, the same reasoning
// ADR-040 already applies to receivables.prisma/settlements.prisma).

/// What kinds of unit this deployment's org chart has. Rows, not an enum —
/// one client says Head Office / Region / Branch / Department, the next
/// says Division / Cluster / Store / Function. `isOffice` marks the types
/// that can hold a posting address and a cost centre; a department
/// typically cannot.
model OrgUnitType {
  id       String  @id @default(cuid())
  /// Stable key for seeds and code that must name one — 'head_office',
  /// 'region', 'department'.
  key      String  @unique
  label    String
  /// Ordering hint for the picker only. NOT a depth constraint.
  rank     Int     @default(0)
  isOffice Boolean @default(false)

  units OrgUnit[]
}

model OrgUnit {
  id       String  @id @default(cuid())
  /// Human key used on imports and in the URL — 'hq', 'north', 'hr'.
  code     String
  name     String
  typeId   String
  parentId String?

  /// Materialised ancestor path, root first, INCLUDING this unit's own id.
  /// Denormalised on purpose: every access check and every report filter is
  /// "this unit and everything under it", and an adjacency list alone
  /// cannot answer that without a recursive CTE per request. Maintained by
  /// `OrgUnitService.move()` and nothing else — see the single-writer rule.
  path  String[]
  /// Depth from the root, 0-based. Derived from `path.length - 1`, stored
  /// so a list screen can indent without loading ancestors.
  depth Int      @default(0)

  /// Where this unit's data physically lives, when that is a separate
  /// deployment. NULL is the common case and means "the deployment reading
  /// this row" — a Solo shop, or a head-office department in the same
  /// database. Never assume one unit per node or one node per unit.
  nodeId        String?
  /// The brand this unit belongs to, when the group runs several. NULL
  /// means group-wide — a head office serving every brand.
  retailBrandId String?

  isActive Boolean   @default(true)
  /// Closed, not deleted. An org unit is referenced by attendance rows,
  /// journal lines and completed tasks that must still explain themselves
  /// years later; deleting one rewrites history.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type              OrgUnitType        @relation(fields: [typeId], references: [id])
  parent            OrgUnit?           @relation("OrgUnitTree", fields: [parentId], references: [id])
  children          OrgUnit[]          @relation("OrgUnitTree")
  node              Node?              @relation(fields: [nodeId], references: [id])
  retailBrand       RetailBrand?       @relation(fields: [retailBrandId], references: [id])
  positions         Position[]
  grants            OrgUnitGrant[]
  /// attendance-workforce/22-attendance-shifts-leave.md — devices, punches
  /// and shifts scoped to this unit.
  attendanceDevices AttendanceDevice[]
  attendanceEvents  AttendanceEvent[]
  shifts            Shift[]
  geofenceZones     AttendanceGeofenceZone[]
  workCenters       WorkCenter[]

  @@unique([retailBrandId, code])
  @@index([parentId])
  @@index([path])
  @@index([nodeId])
}

/// access-control-identity/21-access-over-the-org-tree.md — an explicit,
/// time-boxed grant of authority over a subtree. Derived access from a
/// `Posting` is NOT stored here — it is computed by GrantService from the
/// open Posting rows themselves, so it cannot outlive the post. `expiresAt`
/// is NOT NULL, deliberately: a grant with no end date is the thing every
/// access review finds three years later, held by someone who changed jobs
/// twice. A permanent need is a posting, not a grant — change the org chart.
model OrgUnitGrant {
  id             String    @id @default(cuid())
  /// The principal receiving it. A User, because this is an access grant and
  /// only a principal can hold one — an employee with no login gets nothing
  /// here (hr-people-org/20-people-positions-ranks.md).
  userId         String
  orgUnitId      String
  /// What the grant confers, as PERMISSION_CATALOG keys — a subset, never a
  /// role name: roles change membership underneath a grant and would
  /// silently widen it.
  permissionKeys String[]
  /// READ or ACTING. ACTING additionally lets the holder approve at the
  /// target post's rank, which is why it needs the countersignature below.
  mode           GrantMode @default(READ)

  expiresAt             DateTime
  /// Who granted it, and — when `mode` is ACTING — who countersigned.
  grantedByUserId       String
  countersignedByUserId String?
  reason                String

  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user            User    @relation("OrgUnitGrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User    @relation("OrgUnitGrantGranter", fields: [grantedByUserId], references: [id])
  countersignedBy User?   @relation("OrgUnitGrantCountersigner", fields: [countersignedByUserId], references: [id])
  orgUnit         OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([orgUnitId])
}

enum GrantMode {
  READ
  ACTING
}

// Parties: the permanent counterparty profile. One canonical record per
// business a shop trades with — a supplier today, a retailer/distributor/
// manufacturer counterparty whenever a real feature needs one — searched and
// selected rather than re-typed into each transaction. Role-specific tables
// (Supplier today) hang a 1:1 off Party for fields only that role needs,
// instead of duplicating name/contact/address per role.

enum PartyRoleName {
  SUPPLIER
  MANUFACTURER
  DISTRIBUTOR
  RETAILER
}

model Party {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  city        String?
  taxId       String?
  notes       String?
  isActive    Boolean @default(true)

  /// Set only once a real external counterparty system is integrated — out
  /// of scope today (see packages/shared/src/entities/organization.ts). Lets
  /// a future integration key off this Party without a schema change.
  externalRef    String?
  externalSystem String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles    PartyRoleAssignment[]
  supplier Supplier?

  @@index([phone])
  @@index([taxId])
}

model PartyRoleAssignment {
  id      String        @id @default(cuid())
  partyId String
  role    PartyRoleName

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, role])
}

// Payments. `provider` is a plain string key, not an enum, so a new gateway is
// a new PaymentProvider class plus an entry in the PAYMENT_PROVIDERS env
// allowlist — no migration.
//
// Live today: cod, bank_transfer. Written and awaiting merchant credentials:
// jazzcash, easypaisa.

enum PaymentStatus {
  PENDING
  AWAITING_APPROVAL // bank transfer receipt uploaded, staff must approve
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String
  provider String // "cod" | "bank_transfer" | "jazzcash" | "easypaisa"
  status   PaymentStatus @default(PENDING)
  /// Amount in paisa.
  amount   Int
  currency String        @default("PKR")

  /// Our reference sent to the gateway, and whatever it sends back.
  reference     String? @unique
  providerRef   String?
  /// Raw gateway request/response and bank-transfer receipt details.
  meta          Json?
  receiptUrl    String?
  failureReason String?

  approvedById String?
  paidAt       DateTime?
  refundedAt   DateTime?
  refundAmount Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approvedBy           User?                 @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  /// instalments.prisma — set only for a payment that is a deposit or a
  /// scheduled instalment against a layby/instalment plan.
  instalmentPayment    InstalmentPayment?
  /// settlements.prisma — which SettlementBatch line(s), if any, cover this
  /// payment. Plural: a partial-batch institution could in principle split
  /// one payment's settlement across two batches, though none does today.
  settlementBatchLines SettlementBatchLine[]

  @@index([orderId])
  @@index([status])
  @@index([provider, status])
}

// Payroll: compensation rates, leave balances and pay runs
// (docs/implementation/payroll/19-payroll.md, closing the gap
// docs/erp-lenses/gap-38/38-gap-hr-payroll-no-posting-artifact-for-compe.md names).
//
// Every actor here is a User — same idiom as Expense.createdById,
// BomRecipe.createdById, StockCount creator/assignee. GL posting
// (PayRunLine -> JournalEntry on PayrollRunPosted) is additive: this module
// works standalone with `accounting` disabled, same non-coupling every
// other module's posting rule already demonstrates (R15).

enum CompensationBasis {
  MONTHLY
  HOURLY
  COMMISSION
}

/// One row per rate change, never updated in place — effectiveFrom is what
/// lets a pay-run built for a past period read the rate actually in force
/// on each of its days, not today's rate applied retroactively to a
/// mid-period raise.
model CompensationRate {
  id            String            @id @default(cuid())
  userId        String
  basis         CompensationBasis
  /// Paisa — MONTHLY: per month. HOURLY: per hour. COMMISSION: base salary;
  /// commission itself is computed at pay-run build time (WO-19.2), not
  /// stored here.
  amountMinor   Int
  effectiveFrom DateTime
  /// Null = still in force. Set the moment a later row's effectiveFrom
  /// begins, so a query never has to compute "the latest row before X".
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())

  user        User         @relation(fields: [userId], references: [id])
  createdBy   User?        @relation("CompensationRateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  payRunLines PayRunLine[]

  @@index([userId, effectiveFrom])
}

enum LeaveKind {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

model LeaveType {
  id                String    @id @default(cuid())
  key               String    @unique // "annual", "sick", "unpaid"
  name              String
  kind              LeaveKind
  /// Days credited per accrual run (LeaveAccrualCron, WO-19.3). 0 for
  /// UNPAID and OTHER, which are never accrued, only requested.
  accrualDaysPerRun Float     @default(0)
  isActive          Boolean   @default(true)

  balances    LeaveBalance[]
  requests    LeaveRequest[]
  accrualRuns LeaveAccrualRun[]
}

/// One row per user per leave type — the running balance a request debits
/// and an accrual run credits. Never derived on the fly from a sum of
/// requests, so a balance is a fact a payslip can quote, not a report that
/// might disagree with itself between two reads.
model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  /// Days, to 0.25 precision (half/quarter-day leave is real).
  balance     Float    @default(0)
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId])
}

/// Idempotency guard for LeaveAccrualCron (WO-19.3) — mirrors FinanceCron's
/// own recurring-expense idempotency (WO-B.2): one row per (leaveTypeId,
/// period) makes a re-run of the same period a no-op instead of a double
/// credit.
model LeaveAccrualRun {
  id          String   @id @default(cuid())
  leaveTypeId String
  /// "2026-09" — the period this run credited.
  period      String
  ranAt       DateTime @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([leaveTypeId, period])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String             @id @default(cuid())
  userId       String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  /// Inclusive day count, half-days allowed — computed at submit time, not
  /// re-derived from startDate/endDate later, so an approved request's
  /// cost cannot silently drift if a leave-type's working-day calendar
  /// changes.
  days         Float
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime           @default(now())

  user      User      @relation("LeaveRequestUser", fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  decidedBy User?     @relation("LeaveRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

enum PayRunStatus {
  DRAFT
  APPROVED
  POSTED
}

/// The pay-run document (erp-lenses/38: "the pay run is a document, not a
/// report"). scopeLevel/originNodeId follow Expense's own precedent
/// (WO-23.3, ADR-021) — payroll is recorded at whichever tier employs the
/// staff, defaulting to BRAND.
model PayRun {
  id           String       @id @default(cuid())
  number       String       @unique // PayRunNumberCounter, "PR-2026-0001"
  periodStart  DateTime
  periodEnd    DateTime
  status       PayRunStatus @default(DRAFT)
  scopeLevel   ScopeLevel   @default(BRAND)
  originNodeId String?
  approvedById String?
  approvedAt   DateTime?
  postedAt     DateTime?
  createdById  String?
  createdAt    DateTime     @default(now())

  lines       PayRunLine[]
  adjustments PayRunAdjustment[]
  approvedBy  User?              @relation("PayRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("PayRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, periodStart])
}

/// One line per employee per run. Every money field is paisa, computed once
/// at build time and frozen — re-running the builder on a DRAFT run
/// replaces its lines; nothing recomputes a line silently after APPROVED.
model PayRunLine {
  id                 String @id @default(cuid())
  payRunId           String
  userId             String
  /// The CompensationRate row this line's gross was computed from —
  /// traceable, not a copied scalar with no source.
  compensationRateId String
  grossMinor         Int
  /// Days of UNPAID leave in this period, and the paisa deducted for them —
  /// both zero for someone who took none.
  unpaidLeaveDays    Float  @default(0)
  unpaidLeaveMinor   Int    @default(0)
  /// Itemised statutory deductions, e.g. [{"code":"TAX","amountMinor":...}].
  /// Sums to deductionsMinor; not its own table yet (19.1's note in
  /// 19-payroll.md) because no jurisdiction-specific rule has been
  /// requested — a JSON line-item bag is honest about that, a hardcoded tax
  /// bracket would not be.
  deductions         Json
  deductionsMinor    Int    @default(0)
  netMinor           Int
  /// Which `PayrollTaxBracket.version` produced this line's TAX deduction —
  /// null for a line calculated before brackets were ever configured, or
  /// with no tax bracket in effect. Never recomputed after the fact: a
  /// later `setBrackets` call starts a new version and leaves this alone.
  taxBracketVersion  Int?

  payRun           PayRun           @relation(fields: [payRunId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  compensationRate CompensationRate @relation(fields: [compensationRateId], references: [id])

  @@unique([payRunId, userId])
}

enum PayRunAdjustmentReason {
  OVERPAYMENT
  UNDERPAYMENT
  CORRECTION
}

/// erp-lenses/38's "the overpayment has no way back": a line-level
/// correction keyed to the original PayRun, postable in the CURRENT open
/// period even when the original run's period is CLOSED — never a
/// full-entry reversal of the whole run for one employee's error (WO-19.5).
model PayRunAdjustment {
  id          String                 @id @default(cuid())
  payRunId    String
  userId      String
  reason      PayRunAdjustmentReason
  /// Positive always; sign is implied by `reason` (OVERPAYMENT recovers
  /// money, UNDERPAYMENT/CORRECTION pays more), never a signed amount a
  /// reader has to interpret.
  amountMinor Int
  note        String
  createdById String?
  createdAt   DateTime               @default(now())

  payRun    PayRun @relation(fields: [payRunId], references: [id])
  user      User   @relation(fields: [userId], references: [id])
  createdBy User?  @relation("PayRunAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/payroll's
/// ProgressiveTaxEngine): the progressive tax schedule PayRunService.build()
/// withholds against. One row per bracket, `baseTaxMinor` (cumulative tax
/// from lower brackets) recomputed at read time rather than stored, so
/// editing one bracket's rate can never leave a stale cumulative figure on
/// the brackets above it. Empty table = no brackets = $0 withheld, the same
/// "not modelled" behaviour 19-payroll.md shipped with — configuring this is
/// opt-in, not a surprise deduction on an existing deployment.
model PayrollTaxBracket {
  id           String   @id @default(cuid())
  /// Paisa. The top bracket's row has ceilingMinor = null (open-ended).
  floorMinor   Int
  ceilingMinor Int?
  /// Basis points, e.g. 1000 = 10.00%.
  rateBps      Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Ecosystem audit 2026-10-30: `setBrackets` replaces the active schedule
  /// by deactivating this version's rows and inserting the next version's,
  /// never deleting — a `PayRunLine.taxBracketVersion` written at
  /// calculation time can always be joined back to the exact rates that
  /// produced it, even after a later edit.
  version      Int      @default(1)

  @@index([isActive, floorMinor])
  @@index([version])
}

enum PayrollBankAccountType {
  CHECKING
  SAVINGS
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/payroll's
/// BankFileGenerator): one disbursement account per employee, used to build
/// a NACHA/SEPA/BACS payment file for a POSTED pay run. Every field but
/// `userId` is optional because the three formats need different ones (ACH
/// wants routingNumberOrSortCode + accountNumber, SEPA wants iban) — which
/// fields are required is validated at file-generation time, against the
/// format actually requested, not here.
model PayrollBankAccount {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  routingNumberOrSortCode String?
  accountNumber          String?
  iban                   String?
  bic                    String?
  accountType            PayrollBankAccountType?
  updatedAt              DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// The eighth document-number counter (document-prefix.ts), same
/// INSERT ... ON CONFLICT ... RETURNING shape as the other seven
/// (TransferNumberCounter's own year/counter columns, named identically).
model PayRunNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// The till (RETAIL-ERP.md R7/R11, Tranche 4). WO-21.1 owns a terminal's
// identity and how it authenticates. WO-21.2 (this file's other half) owns
// the shift lifecycle and cash movements. WO-21.3 wired the actual sale —
// PosSalesService hands a validated line list to OrdersService.placeFromPos()
// (`pos -> orders` in KNOWN_MODULE_COUPLINGS, per R11) — so a shift's X/Z
// report is still cash-movements-only here; folding sale/tender totals into
// it is a follow-up, not faked by this file. WO-21.5 adds PosReceipt and a
// return path (reusing OrdersService.changeStatus()/PaymentsService.refund()
// through their EXISTING admin endpoints — no new pos -> payments coupling).
// pos-hardware/31 (WO-31.2/31.3) builds park/retrieve (PosParkedSale) and a
// line's modifier set / non-typed quantity source (PosLineModifier,
// PosLineQuantitySource) — a till-side price override remains unbuilt.

enum PosTerminalStatus {
  /// Registered, no working device credential yet — cannot authenticate.
  PENDING
  ACTIVE
  /// Manually disabled — a lost or decommissioned till. Its own credential
  /// stops working immediately even if it still hashes correctly, the same
  /// guarantee TradingPartner/Node give their SUSPENDED row.
  SUSPENDED
}

/// A physical till. `locationId` is a bare scalar, not a `@relation` — the
/// same "no coupling to another module's schema file" choice
/// invoicing.prisma already made for `tradingPartnerId`/`orderId` — so this
/// file stays fully self-contained; `PosTerminalsService` checks the
/// location exists at write time instead of leaning on a DB-level FK.
model PosTerminal {
  id         String @id @default(cuid())
  /// Short, human-chosen — "LHR-01-T1" — printed on receipts (WO-21.5) and
  /// shown on the branch's own exception dashboard.
  code       String @unique
  label      String
  locationId String

  /// SHA-256 of the device credential this terminal presents on every
  /// request — same shape as `TradingPartner.inboundApiKeyHash` /
  /// `Node.inboundApiKeyHash`: issued once via `rotateDeviceKey()`, shown to
  /// the operator raw exactly that once, never persisted or echoed back.
  deviceKeyHash String? @unique

  status     PosTerminalStatus @default(PENDING)
  lastSeenAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  shifts PosShift[]

  @@index([locationId])
  @@index([status])
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

/// One cashier's stretch at one terminal, opened with a cash float and
/// closed with a physical count (RETAIL-ERP.md R11, WO-21.2). `terminalId`
/// is a real `@relation` — unlike `PosTerminal.locationId`, this stays
/// inside the SAME module's own schema file, so there is no cross-module
/// coupling to avoid. `openedByUserId`/`closedByUserId` are bare scalars,
/// the same decoupling `JournalLine.contactId`/`supplierId`
/// (accounting.prisma) already use for naming a `User` without a
/// `@relation` into another module's table.
model PosShift {
  id             String  @id @default(cuid())
  terminalId     String
  openedByUserId String
  closedByUserId String?

  openingCashMinor Int
  /// The cashier's own physical count at close — compared against the
  /// running total from `cashMovements` for the Z-report's over/short.
  closingCashMinor Int?

  status   PosShiftStatus @default(OPEN)
  openedAt DateTime       @default(now())
  closedAt DateTime?

  terminal       PosTerminal     @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  cashMovements  CashMovement[]
  /// 156-single-employee-branch-loss-prevention.md — variances attributed to
  /// this shift's own custody window.
  stockVariances StockVariance[]
  /// pos-hardware/31 WO-31.2/31.3 — sales started but not yet tendered.
  parkedSales    PosParkedSale[]

  @@index([terminalId])
  @@index([status])
}

enum CashMovementType {
  /// The float the shift opened with — recorded once, by `openShift()`, never by `recordCashMovement()` directly.
  OPENING_FLOAT
  /// Cash added to the drawer mid-shift outside a sale (a bank top-up, a correction).
  CASH_IN
  /// Cash removed for a reason other than a drop — a refund paid in cash, a till-to-safe correction.
  CASH_OUT
  /// A cash drop to the safe — physically leaves the drawer, still counted toward the shift's own cash-in total until the Z-report.
  DROP
  /// Petty cash paid out of the drawer for an expense (a delivery rider, a supply run).
  PAID_OUT
}

/// One physical cash movement at the drawer during a shift — always a
/// positive `amountMinor`; `type` says which direction. Never a sale: a
/// sale's cash tender posts through `orders`/`payments`
/// (OrdersService.placeFromPos(), WO-21.3) like any other payment, not as a
/// row here.
model CashMovement {
  id          String           @id @default(cuid())
  shiftId     String
  type        CashMovementType
  amountMinor Int
  reason      String?
  actorId     String
  createdAt   DateTime         @default(now())

  shift PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

/// One receipt per POS sale (WO-21.5) — created by PosSalesService right
/// after OrdersService.placeFromPos() succeeds, best-effort and outside that
/// call's own transaction, the same "not core to the sale's correctness"
/// reasoning AuditService.record() already uses: a missing receipt row would
/// never be why a sale should roll back. `orderId` is a bare scalar (orders
/// is a different module's schema file), unique — one receipt per order, its
/// print history tracked by incrementing `printCount` rather than creating a
/// new row per reprint.
model PosReceipt {
  id         String    @id @default(cuid())
  orderId    String    @unique
  printCount Int       @default(0)
  printedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orderId])
}

/// pos-hardware/31 §2 (WO-31.2) — a modifier on a basket/receipt line, e.g.
/// "extra shot", "no onions", "large". `priceDeltaMinor` is why this is not
/// just a text note: it changes the till total, folded into the OrderItem's
/// own `unitPrice` at `OrdersService.placeFromPos()` (no schema change to
/// `orders` needed — "a richer line, no new coupling", doc 31's own words).
/// This row is pos-owned display/audit metadata written best-effort AFTER
/// the sale commits; it is never read back to compute money.
model PosLineModifier {
  id     String @id @default(cuid())
  /// The basket line this modifier applies to — a bare scalar per this
  /// file's existing decoupling convention (no `@relation` across the
  /// pos/catalog/orders boundary): deliberately NOT a foreign key to the
  /// `OrderItem` it produced, since `pos` never learns that item's id.
  lineRef String
  key     String
  label   String
  priceDeltaMinor Int @default(0)
  createdAt DateTime @default(now())

  @@index([lineRef])
}

enum QuantitySource {
  TYPED
  SCALE_WEIGHT
  BOM_RECIPE_SCALE
}

/// pos-hardware/31 §2 (WO-31.2) — extends the basket line concept with
/// where its quantity came from: a scale reading or a scaled BOM recipe,
/// not just a typed integer. Metadata on the line, not a new sale model;
/// same bare-scalar `lineRef` convention as `PosLineModifier` above.
model PosLineQuantitySource {
  lineRef  String @id
  source   QuantitySource
  /// Set only when source = BOM_RECIPE_SCALE — which bom.prisma recipe this
  /// line's formula came from. Read-only pointer; pos never writes to bom.
  recipeId String?
}

enum PosOrderType {
  COUNTER
  TAB
  TABLE
}

/// pos-hardware/31 §3 (WO-31.2/31.3) — a sale that has started but not
/// tendered, exactly the "park/retrieve" pos.prisma's own header already
/// named as unbuilt. A `COUNTER` sale never parks (retail/bakery counters
/// tender immediately); `TAB`/`TABLE` sales may park repeatedly before final
/// tender. Belongs to a shift, never floats free of one.
model PosParkedSale {
  id      String       @id @default(cuid())
  shiftId String
  orderType PosOrderType @default(COUNTER)
  /// "Table 4", "Tab — Ahmed" — free text; this repository does not model a
  /// restaurant floor plan, only a label a server recognizes.
  label   String
  /// The full basket snapshot (pos-core's own basket shape) — park/retrieve
  /// replays the underlying maths, never a second sale model.
  basketSnapshot Json
  parkedAt    DateTime  @default(now())
  retrievedAt DateTime?

  shift PosShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([shiftId, retrievedAt])
}

// The `pricing` module — 146-wholesale-tiered-pricing.md
// (b2b-wholesale-multientity/146-wholesale-tiered-pricing.md). Resolves
// "what does THIS buyer pay for THIS variant in THIS context," replacing
// the inline `variant.priceOverride ?? product.basePrice` fallback with a
// chain: an assigned PriceList's own quantity-break entry, falling through
// to that same existing expression unchanged. No `organizationId` column,
// deviating from this doc's own sketch — `Category`/`Product` carry none
// either, and `receivables.prisma`'s own header note already states why:
// this codebase is one Organization per deployment, so a catalog/CRM-
// adjacent config table (not a money-posting ledger line) needs no
// per-row tenant column. `PriceListAssignment.tagId` is a real FK to
// `Tag`, not the doc's own loose `customerTag` string, so a rename of a
// tag can never silently strand an assignment string-matching nothing.

model PriceList {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries     PriceListEntry[]
  assignments PriceListAssignment[]
}

/// A quantity break OR a flat override — never both meaninglessly: a row
/// with minQuantity=1 IS the flat override case, so this is one shape, not
/// two competing mechanisms.
model PriceListEntry {
  id             String @id @default(cuid())
  priceListId    String
  variantId      String
  minQuantity    Int    @default(1)
  unitPriceMinor Int

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQuantity])
  @@index([variantId])
}

/// Which price list applies to which buyer — a customer, or a customer's
/// tag (a segment/channel). Exactly one active assignment wins per buyer,
/// resolved customer-specific-first, then by tag; a buyer with neither
/// falls through to today's existing default (PricingService.resolvePrices()).
model PriceListAssignment {
  id          String  @id @default(cuid())
  priceListId String
  customerId  String? // Contact.id — same join CustomerCreditTerm.customerId already uses
  tagId       String? // Tag.id

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tagId])
}

// Production: bills of materials and work orders for variants made in-house
// (ProductVariant.producedInHouse — catalog.prisma) rather than bought in
// from a Supplier. Mirrors purchasing's PurchaseOrder shape deliberately: a
// WorkOrder is the in-house equivalent of a PO, consuming component stock
// instead of receiving it from outside.

/// One recipe per produced variant: how many of each component variant it
/// takes to make one unit. Keyed by ProductVariant (not, say, GarmentType),
/// so the recipe applies uniformly whether the finished item is stitched,
/// assembled, or anything else made in-house — see docs on
/// StitchingJobsService.createForOrderItem() for how a stitched order line
/// resolves its BOM through OrderItem.variantId.
model BillOfMaterial {
  id        String   @id @default(cuid())
  variantId String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant    ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  components BillOfMaterialLine[]
}

model BillOfMaterialLine {
  id                 String @id @default(cuid())
  billOfMaterialId   String
  componentVariantId String
  /// Units of the component consumed per ONE unit of the produced variant.
  quantityPerUnit    Float

  billOfMaterial   BillOfMaterial @relation(fields: [billOfMaterialId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BomComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([billOfMaterialId, componentVariantId])
  @@index([componentVariantId])
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  COMPLETED
  CANCELLED
}

enum WorkOrderSource {
  REORDER
  ORDER_CASCADE
  MANUAL
}

/// The in-house "make this" ledger entry. DRAFT reserves nothing; RELEASED
/// consumes each BOM component's stock (StockMovementReason
/// PRODUCTION_CONSUMPTION); COMPLETED credits the produced variant's stock
/// (PRODUCTION_RECEIPT). CANCELLED reverses any RELEASED consumption.
model WorkOrder {
  id                String          @id @default(cuid())
  number            String          @unique // "WO-2026-0001"
  variantId         String
  quantityOrdered   Int
  quantityCompleted Int             @default(0)
  status            WorkOrderStatus @default(DRAFT)
  source            WorkOrderSource

  /// Free-form pointer to whatever triggered this — an OrderItem id, a
  /// StitchingJob id, etc. Scalar, not a relation: production is core and
  /// must not type-reference a pack model (same pattern as
  /// StitchingJob.orderItemId — see MULTI-SECTOR.md).
  sourceRefType String?
  sourceRefId   String?

  locationId  String?
  notes       String?
  releasedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  location  Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([variantId])
  @@index([sourceRefType, sourceRefId])
}

/// Same shape as PurchaseOrder's OrderNumberCounter-style tables: one row
/// per year, incremented atomically to avoid the MAX()-read race.
model WorkOrderNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// Phase 5 WO-5.1/5.2/5.3 (docs/implementation/promotions-giftcards/05-promotions-giftcards.md).
//
// Two things people conflate, kept distinct: an automatic Discount applies
// itself when its conditions match; a PromoCode is the same Discount rule
// plus a code the customer has to type. Evaluation itself is a pure function
// (`evaluateDiscounts`, @newax/shared) — this schema only holds the rules it
// reads and the OrderDiscount snapshot of what it decided.

enum DiscountType {
  PERCENTAGE // basis points, House Rule 5
  FIXED_AMOUNT // paisa off
  FREE_SHIPPING
  BUY_X_GET_Y
  TIERED // spend more, save more — see DiscountRule's own doc comment in @newax/shared/discounts.ts
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
  COLLECTION
  SHIPPING
}

model Discount {
  id          String        @id @default(cuid())
  name        String // staff-facing, not translated
  type        DiscountType
  scope       DiscountScope @default(ORDER)
  /// PERCENTAGE/TIERED: basis points (1000 = 10%). FIXED_AMOUNT: paisa. Unused by FREE_SHIPPING/BUY_X_GET_Y.
  value       Int
  /// Cap on a PERCENTAGE/TIERED discount, in paisa. Null = uncapped.
  maxDiscount Int?

  /// Conditions. All that are set must hold — see evaluateDiscounts().
  minSubtotal       Int?
  minQuantity       Int?
  productIds        String[] @default([])
  categoryIds       String[] @default([])
  customerSegmentId String?
  firstOrderOnly    Boolean  @default(false)

  /// BUY_X_GET_Y only.
  buyQuantity    Int?
  getQuantity    Int?
  getDiscountBps Int? // 10000 = free

  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  /// Can this combine with other discounts?
  isStackable Boolean   @default(false)
  /// Lower runs first when several stackable discounts apply.
  priority    Int       @default(0)

  usageLimit        Int? // total redemptions across all customers
  usageLimitPerUser Int?
  usageCount        Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codes      PromoCode[]
  orderLines OrderDiscount[]

  @@index([isActive, startsAt, endsAt])
}

model PromoCode {
  id                 String    @id @default(cuid())
  discountId         String
  /// Stored UPPERCASE and compared uppercase. Customers type in any case.
  code               String    @unique
  isActive           Boolean   @default(true)
  usageLimit         Int?
  usageCount         Int       @default(0)
  /// Single-customer code, e.g. a service-recovery gesture.
  restrictedToUserId String?
  expiresAt          DateTime?
  /// Set when this code came from a bulk generation run.
  batchId            String?
  createdAt          DateTime  @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  /// cart.prisma (WO-8.5) — the abandoned-cart this code was minted for.
  carts    Cart[]

  @@index([discountId])
  @@index([batchId])
}

/// Which discounts an order actually received, so it can explain itself.
/// Snapshot rule (House Rule 7): name/type/amount are copied, never joined —
/// the Discount may be edited or deleted after the order that used it.
model OrderDiscount {
  id          String   @id @default(cuid())
  orderId     String
  discountId  String?
  promoCodeId String?
  name        String
  type        String
  /// Paisa this discount removed from the order — orderDiscount plus every
  /// line's discountUnit*quantity it produced, so an order can be audited
  /// against the sum of its own OrderDiscount rows.
  amount      Int
  createdAt   DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  city            String?
  /// ISO 3166-1 alpha-2, e.g. "PK", "CN". Null for a domestic supplier whose
  /// country was never recorded before this field existed (RETAIL-ERP.md R16).
  country         String?
  /// ISO 4217 — the currency their bills are raised in. Defaults to the
  /// deployment's own base currency; only an international supplier's bills
  /// actually carry FX (see SupplierBill.fxRateScaled).
  currency        String   @default("PKR")
  /// Their tax registration number — NTN, TRN, VAT id, whatever the
  /// jurisdiction calls it. Free text: the label is locale policy, not a
  /// column (see brand.ts), and a supplier's own paperwork is what the
  /// bookkeeper reads regardless of what we'd call it.
  taxId           String?
  /// Free text: "FOB Shanghai", "DDP", "EXW" — customs/shipping terms for an
  /// international supplier. Display-only today, no INCOTERMS enum.
  incoterms       String?
  /// True marks a supplier whose bills need the FX posting rules (WO-19.3) —
  /// distinct from `currency !== base`, since a shop may quote a domestic
  /// supplier in USD without customs/duty being involved at all.
  isInternational Boolean  @default(false)
  /// Free text: "30 days net", "advance", "on delivery".
  paymentTerms    String?
  /// Typical days from order to delivery. Feeds reorder suggestions.
  leadTimeDays    Int      @default(7)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// The permanent counterparty profile this Supplier is the SUPPLIER-role
  /// extension of (parties.prisma). Nullable during the expand phase of an
  /// expand/contract rollout: a backfill script (prisma/backfill-parties.ts)
  /// creates one Party per pre-existing Supplier row; every Supplier created
  /// from here on gets one transactionally (see PurchasingService.create()).
  /// name/contactName/phone/email/address/city above stay in place — reading
  /// exclusively through party and dropping them is a deliberate follow-up,
  /// not part of this change.
  partyId          String? @unique
  party            Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// Null (the default) means manual entry, exactly as before this field
  /// existed. Set it to feed this supplier's bills in automatically once
  /// they're a connected TradingPartner (18-trading-partner-network.md,
  /// WO-18.2) — trading-partners is a togglable pack and purchasing must
  /// never import it, so this is a bare scalar FK, not a cross-module
  /// service call.
  tradingPartnerId String?

  products SupplierProduct[]
  expenses Expense[]
  // Note: purchaseOrders and bills are for WO-1.5, not included yet.

  /// architecture-patterns/104-jsonb-eav-extensibility.md, WO-104.1 — a
  /// bounded, admin-defined overlay (CustomFieldDefinition), never a
  /// business-logic input; application code never branches on a value here.
  customFields Json @default("{}")

  tradingPartner    TradingPartner?  @relation(fields: [tradingPartnerId], references: [id], onDelete: SetNull)
  preferredVariants ProductVariant[] @relation("PreferredSupplier")
  purchaseOrders    PurchaseOrder[]
  supplierBills     SupplierBill[]

  @@index([isActive, name])
  @@index([tradingPartnerId])
}

/// What a given supplier charges for a given variant, and under what terms.
model SupplierProduct {
  id           String  @id @default(cuid())
  supplierId   String
  variantId    String
  /// The supplier's own code for it, for the PO they will read.
  supplierSku  String?
  /// Last agreed unit cost in paisa. Pre-fills a new PO line.
  lastCost     Int     @default(0)
  /// Minimum order quantity this supplier accepts.
  moq          Int     @default(1)
  leadTimeDays Int?
  isPreferred  Boolean @default(false)

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, variantId])
  @@index([variantId, isPreferred])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     String              @unique
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  currency   String              @default("PKR")

  subtotal    Int @default(0)
  freightCost Int @default(0)
  dutyCost    Int @default(0)
  otherCost   Int @default(0)
  total       Int @default(0)

  /// WO-23.3 (RETAIL-ERP.md R13/R8, ADR-021). Which tier raised this PO.
  /// Defaults to BRAND — "brand purchasing is the default and behaves as
  /// today," and every deployment shipped so far is exactly one brand. A
  /// request, not itself a FACT (R2 names "goods receipt", not "purchase
  /// order") — ReplicationRegistry registers GoodsReceipt, not this model.
  scopeLevel   ScopeLevel @default(BRAND)
  /// This node's own identifier (AppConfigService.nodeId) at the moment the
  /// PO was created — a bare string, never a Node row FK (a branch has no
  /// Node row for itself). Null for a PO raised before this column existed.
  originNodeId String?

  expectedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  /// WO-213.2 (213-partner-fact-exchange.md). The `PartnerFactInbox` row this
  /// order was created from, when a connected partner's `sale.dispatched` fact
  /// made it. Null means "raised by a person, or from a requisition". A bare
  /// scalar, no `@relation`: purchasing is decoupled from `tradingpartners`
  /// (ADR-012). UNIQUE is the point: a fact is delivered at least once, so the
  /// second attempt to create its order must be a no-op by constraint, not by
  /// a check that two deliveries could race past.
  sourceFactInboxId String? @unique
  createdBy         User?                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items             PurchaseOrderItem[]
  receipts          GoodsReceipt[]
  bills             SupplierBill[]
  /// The requisition this PO was converted from, if any — doc 152's own
  /// "click the number" lens: the PO's own detail screen links back to why
  /// it was bought. Back-relation only; the FK lives on PurchaseRequisition.
  sourceRequisition PurchaseRequisition?

  @@index([status, createdAt])
  @@index([supplierId])
  @@index([scopeLevel])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Int
  lineTotal        Int
  note             String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id])
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  number          String   @unique
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  receivedById    String?
  notes           String?
  freightCost     Int      @default(0)
  dutyCost        Int      @default(0)
  otherCost       Int      @default(0)
  createdAt       DateTime @default(now())

  /// Where this receipt actually landed — WO-23.3, R13's org-warehouse
  /// receiving. Bare scalar, no `@relation`: purchasing decouples from
  /// inventory the same way transfers.prisma's own Location-id columns
  /// already do. Resolves to InventoryService.defaultLocationId() when the
  /// caller does not name one, matching every receipt before this column
  /// existed.
  locationId String

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([locationId])
}

model GoodsReceiptItem {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  variantId           String
  quantity            Int
  unitCost            Int
  landedUnitCost      Int

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  variant           ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([goodsReceiptId])
  @@index([variantId])
}

enum SupplierBillStatus {
  UNPAID
  PARTIAL
  PAID
  /// Ecosystem audit 2026-10-30 (merged from @newaxhq/purchasing's 3-way
  /// match, per docs/erp-lenses/procurement-supplier-lifecycle/13's "The
  /// bill nobody checked" lens) — the bill's amount fell outside
  /// purchasing.bill_match_tolerance_percent of the PO/GoodsReceiptItem
  /// total. Never posts to Accounts Payable and never accepts a payment
  /// until released back to UNPAID by a `purchasing.release_bill_match`
  /// holder (PurchasingService.releaseBillMatchReview()).
  PENDING_MATCH_REVIEW
}

model SupplierBill {
  id              String             @id @default(cuid())
  supplierId      String
  purchaseOrderId String?
  reference       String?
  /// In `currency` below — the supplier's own invoiced amount, not
  /// necessarily the base currency (RETAIL-ERP.md R16).
  amount          Int
  /// Cumulative, in `currency` below — the same unit as `amount`, so
  /// "amount - amountPaid" is always the outstanding balance in the bill's
  /// own currency without a conversion.
  amountPaid      Int                @default(0)
  /// ISO 4217. Defaults to the deployment's own base currency; set from the
  /// supplier's own `currency` when raised.
  currency        String             @default("PKR")
  /// rate * 1_000_000 (House Rule 5 / R16) at the moment this bill was
  /// raised — the "booked" rate a later payment's settlement rate is
  /// compared against to post a realised FX gain/loss. 1_000_000 for a
  /// base-currency bill; never re-derived once set (House Rule 7).
  fxRateScaled    Int                @default(1000000)
  /// `amount` converted to the base currency at `fxRateScaled`, computed
  /// once at creation (`convertToBase`, @newax/shared) — what actually
  /// posts to Accounts Payable (posting-rules.subscriber.ts).
  baseAmountMinor Int
  status          SupplierBillStatus @default(UNPAID)
  /// Ecosystem audit 2026-10-30. Why this bill is PENDING_MATCH_REVIEW, in
  /// words an operator can act on (the PartnerFactInbox.statusReason idiom)
  /// — null once released, or if the bill never needed review.
  matchReviewReason String?
  issuedAt        DateTime           @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([supplierId, status])
  @@index([status, dueAt])
}

/// 152-purchase-requisition.md. A request to buy, distinct from the
/// PurchaseOrder that results once approved — the two different decisions
/// ("should we buy this at all" vs. "is this specific PO's price/supplier
/// right") this repository previously conflated into one PurchaseOrder row.
enum RequisitionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

model PurchaseRequisition {
  id                       String                    @id @default(cuid())
  requestedById            String
  /// Named explicitly, never defaulted — the same discipline every other
  /// location-aware write in this repository already follows.
  locationId               String
  justification            String
  status                   RequisitionApprovalStatus @default(PENDING)
  /// Set once, by convertToPurchaseOrder() — converting an already-CONVERTED
  /// requisition is refused, so one requisition never produces two POs.
  convertedPurchaseOrderId String?                   @unique
  rejectionNote            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  requestedBy            User              @relation("RequisitionRequester", fields: [requestedById], references: [id])
  convertedPurchaseOrder PurchaseOrder?    @relation(fields: [convertedPurchaseOrderId], references: [id], onDelete: SetNull)
  lines                  RequisitionLine[]

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([locationId])
}

model RequisitionLine {
  id                     String @id @default(cuid())
  requisitionId          String
  variantId              String
  quantity               Int
  /// A requester's own estimate — never a real cost until an actual PO line
  /// snapshots one at convertToPurchaseOrder() time.
  estimatedUnitCostMinor Int?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  variant     ProductVariant      @relation(fields: [variantId], references: [id])

  @@index([requisitionId])
  @@index([variantId])
}

/// resilience-scalability/144-supply-chain-resilience-planning-engine.md
/// (WO-144.6, R25) — one row per goods receipt, backfilling a real lead-time
/// distribution from history already in the database. Populated by a
/// listener on GoodsReceived (never new data entry). Bare scalars, no
/// `@relation`: an observation stands on its own even if the PurchaseOrder
/// or Supplier it cites is later deleted, the same "erasure the ledger
/// cannot obey" shape this document set already applies elsewhere.
model SupplierLeadTimeObservation {
  id              String   @id @default(cuid())
  supplierId      String
  purchaseOrderId String
  observedDays    Int
  createdAt       DateTime @default(now())

  @@index([supplierId, createdAt])
}

// WO-35 (docs/implementation/ai-layer/35-scalable-rag-document-retrieval.md).
// Retrieval-augmented generation over a document corpus — one more
// `AiProvider` consumer (09-ai-layer.md), never a second AI subsystem:
// ingestion calls `AiService.embed()` (and, for a scanned page with no text
// layer, `AiService.describeImage()`), generation calls `AiService.complete()`,
// through the exact same budget/timeout/absent-provider-is-invisible contract
// every other WO-9.x feature already uses.
//
// --- Scoping column: a deliberate departure from the doc's own literal sketch ---
//
// The doc's own illustrative Prisma snippet writes `organizationId String`
// (required) on both tables below. This file instead uses `organizationId
// String?` (nullable), matching this codebase's own REAL, already-established
// convention for an org-wide scope column that is present from the first
// migration but unused outside the Organization tier — `WalletAccount`
// (wallet.prisma) states that convention in its own words: "present in the
// first migration and never rendering at Solo/Chain. Nullable there on
// purpose: `organizationId` is unset outside the Organization-tier[...]
// deployment." `JournalLine` (accounting.prisma) dimensions every one of its
// own org/brand/branch/cost-centre columns the same nullable way. Per
// CLAUDE.md's own "Scale: the three axes" — "One deployment serves one
// brand, resolved at build time... do not build toward multi-brand
// speculatively" — this deployment's own database never holds two different
// organizations' documents under ordinary operation; the column exists so a
// future Organization-tier context (or the doc's own named-but-explicitly-
// NOT-built "Platform" cross-tenant tier, see the doc's "Scoping the claim"
// section) is a data population, never a migration.
//
// A `null` here means exactly what a `null` `WalletAccount.organizationId`
// means: "this deployment's own single, implicit brand," never "unscoped" —
// `RagRetrievalService.retrieve()`'s WHERE clause names `organizationId`
// explicitly on every call, including matching `IS NULL`, so the isolation
// guarantee (WO-35.4) holds identically whether the column is populated or
// not.
//
// `corpus` is ALSO denormalized onto `DocumentChunk`, which the doc's own
// sketch does not show explicitly (its sketch keeps `corpus` only on
// `DocumentSource`) even though its own `retrieve()`/`VectorStore.query()`
// signatures filter by `corpus` too. This file makes that filter reachable
// without a join, for exactly the reason the doc gives for denormalizing
// `organizationId` in the first place: "the isolation filter... must be a
// column on the table being searched, not a join a future query can
// forget" — and `corpus` is the isolation axis that is actually live TODAY
// (an HR assistant must never surface `SUPPLIER_CATALOG` even in a
// deployment with no `Organization` row at all), where `organizationId`
// mostly is not yet.

enum DocumentCorpus {
  /// doc 28's vault (docs/implementation/hr-people-org/28-recruitment-onboarding-document-vault.md)
  /// — unbuilt in this codebase today (no `EmployeeDocument` model exists),
  /// so nothing feeds this corpus automatically yet; a source can still be
  /// uploaded into it directly through this module's own admin screen. See
  /// `RagCorpusService`'s own header for why that absence is not this work
  /// order's to fix.
  EMPLOYEE_DOCUMENTS
  /// Spec sheets, product manuals from trading partners (trading-partners.prisma).
  SUPPLIER_CATALOG
  /// Generated invoices, contracts, statements.
  BUSINESS_DOCUMENTS
  /// Policy docs, help content — curated for customer-facing answers (WO-9.7).
  KNOWLEDGE_BASE
}

enum IngestStatus {
  QUEUED
  EXTRACTING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

/// A source document — one row per uploaded file. Ingested once; never
/// re-parsed per query (the doc's own §1 title) — `DocumentChunk` below is
/// what retrieval actually reads.
model DocumentSource {
  id             String         @id @default(cuid())
  /// See this file's header comment — nullable, always null at Solo/Chain.
  organizationId String?
  /// Where the file actually lives — `StorageService`'s own key, never
  /// re-stored here (doc 28's `EmployeeDocument` would point the same way,
  /// the day it exists).
  storageKey     String
  originalName   String
  corpus         DocumentCorpus
  status         IngestStatus   @default(QUEUED)
  pageCount      Int?
  ingestedAt     DateTime?
  /// Set only while FAILED — the ingestion-queue screen's own message, and
  /// what a retry clears. Never left to be inferred from a log line the
  /// operator cannot reach without shell access.
  failureReason  String?
  /// Plain scalar, no relation — same "reference by id, join in application
  /// code" idiom as `ProductAiSuggestion.reviewedById` (ai_layer migration):
  /// this row is never joined against `User` in a query, only displayed.
  uploadedById   String?
  /// Security review M7 — set the instant `RagIngestionService.ingestOne()`
  /// atomically claims this row (QUEUED -> EXTRACTING), cleared on every exit
  /// (READY, FAILED, or requeued). A claim older than
  /// `STALE_CLAIM_MINUTES` with the row still EXTRACTING/CHUNKING/EMBEDDING
  /// means the worker that claimed it crashed — the cron's own reaper (or a
  /// manual retry) resets it to QUEUED with this column cleared.
  claimedAt      DateTime?
  /// Security review M8 — consecutive embedding failures for this source.
  /// Reset to 0 on a successful READY transition or a manual retry; past
  /// `MAX_EMBED_ATTEMPTS` the source moves to FAILED instead of requeueing,
  /// so a deterministically-broken document (a vendor 4xx on malformed
  /// input, not a transient outage) stops occupying every ingestion batch
  /// forever.
  attempts       Int            @default(0)
  /// Security review M8 — exponential backoff: `processQueued()` never
  /// selects a QUEUED source before this time. `null` means eligible
  /// immediately (never backed off, or just reset by a retry).
  nextAttemptAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  chunks DocumentChunk[]

  @@index([organizationId, corpus, status])
  @@index([status])
}

/// One row per chunk, not per document — chunking is what makes retrieval
/// precise instead of "here's a 40-page PDF, good luck." `organizationId`
/// and `corpus` are both denormalized from `DocumentSource` — see this
/// file's header comment for why `corpus` joins `organizationId` here even
/// though the doc's own sketch only denormalizes the latter.
model DocumentChunk {
  id             String                      @id @default(cuid())
  sourceId       String
  organizationId String?
  corpus         DocumentCorpus
  pageFrom       Int
  pageTo         Int
  text           String
  /// pgvector column, the same 1536-dim space `ProductTranslation.embedding`
  /// already uses (WO-9.5) — one embedding-dimensionality constant for the
  /// whole codebase (both go through the same `AiService.embed()`), not a
  /// second one invented here. Written and read only via raw SQL —
  /// `PgVectorStore` — never through Prisma's normal query API, the same
  /// constraint `search.service.ts` already documents for
  /// `ProductTranslation.embedding`.
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now())

  source DocumentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Supports the ingestion-queue/management queries (list a source's own
  // chunks, delete-then-insert on re-ingest). The vector index itself
  // (HNSW, cosine ops) is created by hand in this migration's own .sql —
  // Prisma has no schema syntax for an index method or operator class.
  @@index([organizationId, corpus, sourceId])
  /// L18 (security review) — the admin sources list's own chunk-count query
  /// (`RagCorpusService`) reads by `sourceId` alone; the composite index
  /// above requires `organizationId`/`corpus` too and does not serve it.
  @@index([sourceId])
}

// Receivables: CreditNote/DebitNote, customer credit limits, and dunning —
// RETAIL-ERP.md R18's own named gap for the `invoicing` module
// (docs/implementation/finance-accounting/145-receivables-credit-limits-dunning.md).
//
// DEVIATION from that doc's own literal sketch, documented in full in the
// doc's own shipped-status note: R18 pairs `CreditNote` with `Invoice`, but
// this codebase's actual `Invoice` model (invoicing.prisma) is a bounded,
// tradingpartners-scoped MVP that is never posted to the general ledger and
// carries no `organizationId`/`retailBrandId` of its own. The real, already-
// working AR ledger (`accounting/aging.ts`, `gl-reports.service.ts`'s
// `agedReceivables()`) keys off `Contact`/`Order`, not `Invoice`. So every
// model below keys `customerId` to `Contact.id` and the document it credits
// to `Order.id` (`orderId`, not `invoiceId`) — the only choice that makes
// this doc's own Acceptance criterion #1 ("reconciling against
// accounting/aging.ts's own bucket totals") true rather than aspirational.
// `DebitNote` needed no such change: `supplierId`/`supplierBillId` already
// match `SupplierBill`/`agedPayables()` exactly as the doc sketched them.
//
// Every FK below is a bare scalar, never a Prisma `@relation` — mirroring
// `Invoice.tradingPartnerId`'s own established convention (invoicing.prisma's
// file header: "so this file adds no coupling to any other module"). This
// file can be read, tested or dropped independently of `orders`, `crm`,
// `purchasing` or `accounting`.
//
// No `organizationId`/`retailBrandId`/`branchNodeId`/`costCentreId` column
// here either — a further deviation from the doc's own sketch, for the same
// reason: `Order`, `Invoice`, `PurchaseOrder` and `SupplierBill` (the sibling
// documents these two correct) carry none of those columns themselves; only
// `JournalLine` does (accounting.prisma), set once, at post time, by
// `PostingRulesSubscriber` — exactly where every other document's posting
// already sets them. Declaring `CreditNote`/`DebitNote` undimensioned here,
// like their siblings, is CLAUDE.md's "Every column or none" lens answered
// honestly rather than a column added for a dimension nothing else sets.

enum CreditDebitNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

/// Reduces what a customer owes — a return, a pricing correction, a
/// goodwill credit. `amountMinor` is snapshotted at creation and never
/// recomputed later, the same "a record keeps the meaning it had when
/// created" discipline every other financial document in this repository
/// already follows.
model CreditNote {
  id               String                @id @default(cuid())
  /// Gapless per fiscal year within this node — documentNumber()'s own
  /// convention (document-number.ts), collapsing to the identical
  /// PREFIX-YEAR-SEQ a Solo deployment has always seen.
  number           String                @unique
  customerId       String // Contact.id — bare scalar, see file header
  /// The Order this credits, if any — nullable: a goodwill credit may cite
  /// none. Renamed from the doc's own `invoiceId`; see file header.
  orderId          String?
  /// Set only once APPLIED against an Order OTHER than `orderId` — e.g. a
  /// return credited against invoice A later applied to invoice B.
  appliedToOrderId String?
  amountMinor      Int
  reason           String
  status           CreditDebitNoteStatus @default(DRAFT)
  /// The "threshold nobody approves alone" lens: who created this note —
  /// never its own approver (CreditNotesService.approve()).
  createdById      String
  approvedById     String?
  issuedAt         DateTime?
  voidedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([customerId, status])
  @@index([orderId])
}

/// The mirror on the supplier side of the ledger — reduces what this
/// organization owes a supplier (a return, an overcharge correction). Never
/// conflated with CreditNote: the two sit on opposite sides of the same
/// double-entry system (R15).
model DebitNote {
  id             String                @id @default(cuid())
  number         String                @unique
  supplierId     String // Supplier.id — bare scalar
  supplierBillId String? // SupplierBill.id — bare scalar, nullable
  amountMinor    Int
  reason         String
  status         CreditDebitNoteStatus @default(DRAFT)
  createdById    String
  issuedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([supplierId, status])
}

/// A policy row, checked at the one place a sale can be refused for it —
/// never inferred, always a deliberate manual value.
model CustomerCreditTerm {
  id               String   @id @default(cuid())
  customerId       String   @unique // Contact.id
  creditLimitMinor Int
  paymentTermDays  Int      @default(30)
  /// A manual override — never auto-set by a missed payment without a human
  /// decision, per "the threshold nobody approves alone" applied to a hold
  /// instead of a spend.
  isOnHold         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isOnHold])
}

/// Days-overdue thresholds and which template fires at each — a
/// client-editable policy row, the identical "rows over enums" discipline
/// every other policy in this repository already follows. One row per
/// deployment today (enforced at the service layer, not a unique
/// constraint, so a future per-brand policy needs no schema change — see
/// this doc's own "second legal entity" lens).
model DunningPolicy {
  id        String   @id @default(cuid())
  /// [{ daysOverdue: 7, templateKey: "gentle-reminder" }, ...] — ascending
  /// by daysOverdue, validated by DunningService.
  stepsJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per (order, step) a dunning notice has actually gone out for —
/// the idempotency guard that stops the nightly sweep from re-sending a
/// step already sent, the same discipline every other registered source
/// against a nightly watcher already requires.
model DunningEvent {
  id        String   @id @default(cuid())
  orderId   String // Order.id — bare scalar
  stepIndex Int
  sentAt    DateTime @default(now())

  @@unique([orderId, stepIndex])
  @@index([orderId])
}

// The replication engine (RETAIL-ERP.md Part 6, WO-20.1: "log, cursors,
// registry, quarantine") — core platform, not a module, the same standing
// as core/events/. A chain deployment (BRANCH/BRAND/ORG) is one schema at
// every tier (R1); a row is byte-identical wherever it lands, so
// replication is a copy, not a transform.
//
// R2 is the whole conflict-resolution policy and the reason no distributed
// transaction is ever needed: a FACT (a sale, a journal entry — something
// that happened) flows UP only, and the originating node always wins,
// append-only, never edited from above. A POLICY (a product, a price, a
// chart of accounts — something someone with authority decided) flows DOWN
// only, and the owning tier always wins. A LEDGER (stock on hand, an
// account balance) never replicates as a total — only its deltas
// (StockMovement, JournalLine) do, and every tier recomputes its own
// aggregate locally. `ReplicationRecord` carries FACT/POLICY rows only;
// nothing here ever stores or ships a running balance.
//
// This is dormant machinery under `NODE_ROLE=STANDALONE` (every deployment
// today) by design (R14 — "every tier concept must be invisible in Solo"):
// `ReplicationLogService.append()` is a deliberate no-op there, so these
// tables exist (an empty table costs a row in the system catalogue and
// nothing else — MULTI-SECTOR.md) but stay empty until a deployment
// actually joins a chain. WO-20.1 builds this foundation only — the actual
// HTTPS pull/push agent that moves rows between nodes is WO-20.2, and
// wiring specific entities (orders, journal lines, products…) to call
// `append()` is WO-20.4/`20.3`. Nothing calls this yet.

enum ReplicationClass {
  FACT
  POLICY
}

enum ReplicationDirection {
  UP
  DOWN
}

enum ReplicationOp {
  UPSERT
  DELETE
}

/// The log. One row per fact/policy change this node originated, in the
/// order it happened here. `sequence` is monotonic per `originNodeId` (see
/// `ReplicationSequenceCounter`) — a peer's `ReplicationCursor` is just "the
/// highest sequence from this origin I've already applied", which is what
/// makes a gap safe to buffer-and-flag rather than something that must
/// block: the peer can tell exactly what it is missing.
model ReplicationRecord {
  id            String               @id @default(cuid())
  originNodeId  String
  sequence      BigInt
  /// "Order", "JournalLine", "Product" — must be registered with
  /// `ReplicationRegistry` before anything can log or apply it.
  entity        String
  /// The cuid — identical at every tier (R6), so this is never translated
  /// in transit the way a per-node autoincrement id would have to be.
  entityId      String
  dataClass     ReplicationClass
  direction     ReplicationDirection
  op            ReplicationOp
  payload       Json
  /// Lets a receiving node that hasn't yet deployed a payload-shape change
  /// tell "old shape, still valid" apart from "genuinely broken" — carried
  /// on every record rather than inferred from `entity` alone.
  schemaVersion Int
  /// The fact's own original time — never rewritten by a late apply,
  /// mirroring how a late-posted JournalEntry keeps its own date (R15).
  occurredAt    DateTime
  createdAt     DateTime             @default(now())

  @@unique([originNodeId, sequence])
  @@index([entity, entityId])
}

/// This node's own per-origin sequence counter — `originNodeId` is always
/// this node's own `NODE_ID` when appending locally, so in practice there
/// is exactly one row. A dedicated counter, not a MAX-scan over
/// `ReplicationRecord` (purchasing.prisma's `nextPONumber` pattern): that
/// table grows without bound over a chain's lifetime, and this stays O(1).
model ReplicationSequenceCounter {
  nodeId String @id
  value  BigInt @default(0)
}

/// "The highest sequence I've already synced with this peer, in this
/// direction" — read and advanced by `ReplicationSyncAgent` (WO-20.2).
/// Keyed by `(peerNodeId, direction)`, not `peerNodeId` alone: a BRANCH or
/// BRAND has exactly one parent but two independent progress counters
/// against it — how far it has PUSHed its own facts UP, and how far it has
/// PULLed policy DOWN — and a single row per peer cannot hold both without
/// conflating them. On this node's own side (pushing/pulling against its
/// one parent) `peerNodeId` is the literal `'parent'`, since there is only
/// ever one; on the parent's side (tracking many children) it is each
/// child's real `nodeId`. Unexercised under `STANDALONE`, which has no
/// peers to hold a cursor for.
model ReplicationCursor {
  peerNodeId   String
  direction    ReplicationDirection
  lastSequence BigInt
  lastSyncAt   DateTime

  @@id([peerNodeId, direction])
}

enum ReplicationQuarantineStatus {
  OPEN
  RESOLVED
}

/// Where an incoming record lands when it fails to apply — never dropped,
/// never retried forever (that would silently corrupt a peer's own
/// convergence guarantee the same way an infinite-retry webhook corrupts an
/// integration). An operator resolves it by hand once the cause — a schema
/// mismatch, a missing parent row — is fixed, which is a manual, audited
/// step on purpose: nothing here auto-retries into a database that has
/// already moved on.
model ReplicationQuarantine {
  id            String                      @id @default(cuid())
  originNodeId  String
  sequence      BigInt
  entity        String
  entityId      String
  op            ReplicationOp
  payload       Json
  schemaVersion Int
  reason        String
  status        ReplicationQuarantineStatus @default(OPEN)
  createdAt     DateTime                    @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

/// R9's OTHER quarantine — "a fact arriving in violation is accepted and
/// quarantined for review — never silently dropped, never silently
/// honoured." Deliberately a SEPARATE table from `ReplicationQuarantine`
/// above (ADR-021/ADR-023): that one is for a record that failed to
/// apply at all — a bug, a schema mismatch, nothing registered — a
/// technical fault with no relation to what the fact itself says. This one
/// is for a fact that is technically fine but whose own `scopeLevel`
/// disagrees with the `BrandPolicy` switch that was supposed to govern the
/// node that raised it — a governance exception, never a failure, and
/// R5/R2 both forbid rejecting it outright: the fact already happened.
/// `sequence`/`op`/`schemaVersion` are deliberately absent — those describe
/// the REPLICATION mechanics `ReplicationApplyService` already handled
/// successfully by the time a policy check runs; this row is about the
/// fact's own content, not its transport.
model PolicyQuarantine {
  id            String                      @id @default(cuid())
  /// The branch (or other node) whose own fact triggered this — always the
  /// authenticated node from the inbound push, never taken from the payload
  /// itself (`ReplicationController.push()`'s own convention).
  originNodeId  String
  entity        String
  entityId      String
  /// The `BrandPolicy` column violated — e.g. "allowBranchLocalPurchasing".
  /// A string, not an enum: R9 names four switches total and only one has a
  /// real receiving-tier check today (WO-23.3b) — an enum would have to
  /// grow every time a new switch gains enforcement, for a column nothing
  /// queries by value alone.
  policyKey     String
  /// Resolved from `Node.retailBrandId` — null when that node carries no
  /// brand at all, which `reason` says explicitly rather than leaving the
  /// column to explain itself.
  retailBrandId String?
  /// The fact's own payload, unmodified — the same one `ReplicationRecord`
  /// carried, so a reviewer sees exactly what arrived.
  payload       Json
  reason        String
  status        ReplicationQuarantineStatus @default(OPEN)
  createdAt     DateTime                    @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  /// The reviewer's own note. "Quarantined for review" with no record of
  /// what the review concluded is not a review.
  resolvedNote  String?

  resolvedBy User? @relation("PolicyQuarantineResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([entity, entityId])
  @@index([retailBrandId])
}

// Resilience engineering (resilience-scalability/38-resilience-engineering.md,
// WO-38.3). Additive only; no existing table altered.
//
// A durable record of success/failure/latency for the three named critical
// paths (checkout, POS sale completion, till -> parent sync), so the error
// budget for "99.9% success over the trailing 30 days" survives a process
// restart — an in-memory counter cannot answer "over the trailing 30 days"
// once the process that was counting is gone.
//
/// SloRecorderService.record() is the one writer (core/slo/) — never a raw
/// `prisma.requestOutcome` write from a controller or another service, the
/// same "one writer per invariant" discipline CLAUDE.md already states for
/// stock. Writes are fire-and-forget/best-effort from the caller's own
/// point of view: a failure to record an outcome never fails or slows the
/// checkout/POS-sale/sync path it is observing (doc 38's own "never let
/// observability become a new failure mode" implicit rule).
///
/// This is an operational log, not a business record — the "hundred-
/// thousandth row" lens applies directly: it grows with request volume, so
/// `RequestOutcomePruneCron` (nightly) deletes rows past the 30-day window
/// this table exists to serve plus a few days' buffer, and every read goes
/// through `(path, occurredAt)`, the one index this table has.
model RequestOutcome {
  id String @id @default(cuid())

  /// One of core/slo/slo-paths.ts's SLO_PATHS keys ('checkout', 'pos.sale',
  /// 'replication.sync') — a plain string, not a Prisma enum, so adding a
  /// fourth critical path later is an entry in that one TypeScript file,
  /// never a migration.
  path String

  /// For 'checkout'/'pos.sale': whether the request completed without
  /// throwing. For 'replication.sync': whether the tick's own backlog age
  /// was within the 4-hour bound stated in doc 38 §3 — there is no
  /// separate percentage SLO stated for that path, only the hard bound, so
  /// "succeeded" IS that bound-check, not "the tick ran without error."
  succeeded Boolean

  /// For 'checkout'/'pos.sale': the request's own wall-clock latency, for
  /// the p95 figure doc 38 §3 names. For 'replication.sync': the backlog
  /// age (now minus the oldest still-unpushed record's occurredAt) at the
  /// moment of this tick, in milliseconds — the number the 4-hour bound is
  /// actually measured against.
  latencyMs Int

  /// The event's own time — always `new Date()` at record time here
  /// (unlike a replicated business FACT, this is observability data with
  /// no earlier "true" time to preserve).
  occurredAt DateTime @default(now())

  @@index([path, occurredAt])
}

// Phase 7 WO-7.5 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// A review is moderated by default (PENDING) — an unmoderated review form is
// a spam target within days. `orderItemId` is set only when the reviewer
// actually bought this exact line, which is what lets the storefront show
// "Verified purchase" instead of trusting a self-reported claim.
//
// `fitFeedback` is the apparel-pack hook: cheap to collect now, and it is
// what makes Phase 9's size recommendation possible later — collected here,
// in core (every sector's products can be reviewed), read only by the
// apparel pack's own future size-recommendation code, never the other way
// round.

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  userId    String?

  /// Set when the reviewer actually bought it — display "Verified purchase".
  /// Unique: one review per purchased line, not one review per product per
  /// order (a multi-line order could otherwise review the same product
  /// twice by picking a different line each time).
  orderItemId String? @unique

  rating Int // 1-5
  title  String?
  body   String?

  photoUrls String[]     @default([])
  status    ReviewStatus @default(PENDING)

  /// "too_small" | "true_to_size" | "too_large" — free text, not an enum, so
  /// a future sector's own vocabulary never needs a migration to add a value.
  fitFeedback String?

  helpfulCount Int     @default(0)
  staffReply   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([userId])
}

/// WO-9.9 (09-ai-layer.md). One row per product, regenerated by
/// ReviewSummaryService when PUBLISHED review count crosses the next
/// multiple of a threshold Setting — a `VariantSalesStat`-style cache, never
/// computed at read time. `fitSignal` feeds WO-9.2's size recommendation as
/// a corroborating input alongside the raw fitFeedback aggregation.
model ProductReviewSummary {
  productId               String   @id
  summaryText             String
  /// House Rule 1 — this line is shown on the storefront to any visitor,
  /// same as every other customer-facing string, so it is generated in both
  /// languages in the one AI call rather than shipped English-only. Null
  /// only if that generation failed while `summaryText` itself succeeded;
  /// the storefront falls back to English rather than showing nothing.
  summaryTextUr           String?
  fitSignal               String?
  qualitySignal           String?
  commonComplaints        Json?
  reviewCountAtGeneration Int
  generatedAt             DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Datasource and generator only. Models live in one file per module —
// see core.prisma, catalog.prisma, measurements.prisma, and so on.
//
// Adding a module means adding a .prisma file in this folder; nothing here
// needs to change.

generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/prisma"
  // "native" covers local dev on whatever OS you're on; the musl target is
  // for the Alpine-based Docker image — listing both means `prisma generate`
  // produces an engine that runs correctly in both places from one schema.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // WO-9.5 (09-ai-layer.md) — lets `extensions = [vector]` below register the
  // pgvector extension declaratively, and is what makes
  // ProductTranslation.embedding's `Unsupported("vector(1536)")` column
  // possible at all.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // `vector` ships as a normal Postgres extension (pgvector), no separate
  // service — WO-9.5's own "no extra service" requirement. Declared here so
  // `prisma migrate` tracks it the same way it tracks everything else, even
  // though pgvector's actual CREATE EXTENSION statement lives in the hand-
  // written migration.sql (this repo's own migration discipline), not in
  // Prisma-generated DDL.
  extensions = [vector]
}

// Search. WO-8.3,
// docs/implementation/content-marketing-search/08-content-marketing-search.md.
//
// The full-text infrastructure itself — ProductTranslation.searchVector, its
// GIN index, and the pg_trgm trigram index for fuzzy matching — lives on
// catalog.prisma's ProductTranslation, since it is product data recomputed
// by product writes. This file holds the two tables that are genuinely
// search's own: the synonym table staff edit, and the query log a
// merchandiser reads as the zero-result report.

model SearchSynonym {
  id        String   @id @default(cuid())
  locale    String
  /// The term a customer types.
  term      String
  /// What it should also match, e.g. term "kameez", synonym "shirt". Applied
  /// both ways at query time (SearchService expands a query into its
  /// synonym set before building the tsquery).
  synonym   String
  createdAt DateTime @default(now())

  @@unique([locale, term, synonym])
  @@index([locale, term])
}

/// No FK to User: most rows are anonymous storefront visitors, and a search
/// log at this volume must never be constrained by, or block on, account
/// lifecycle — same reasoning that kept Order.guestPhone a bare scalar.
model SearchQueryLog {
  id          String   @id @default(cuid())
  locale      String
  term        String
  resultCount Int
  userId      String?
  createdAt   DateTime @default(now())

  @@index([resultCount, createdAt])
  @@index([term])
}

// Financial institution settlement partnerships
// (finance-accounting/49-financial-institution-settlement-partnerships.md).
// `PaymentProvider` (payments.prisma) already answers "how does a customer
// pay"; this is the merchant-settlement mirror — "how does the money that
// left the customer actually arrive, reconciled, in the merchant's own bank
// account." A SettlementBatch is a reconciliation target, not a payment
// record: Payment already records what the business believes it is owed,
// this records what a bank or gateway says it actually paid out.

model SettlementProvider {
  id       String  @id @default(cuid())
  /// "easypaisa-settlement", "jazzcash-settlement", "hbl-merchant-account" —
  /// matches whichever FinancialInstitutionConnector.institution key is
  /// registered for it (settlement-connector.ts).
  key      String  @unique
  label    String
  isActive Boolean @default(true)

  batches SettlementBatch[]
}

enum SettlementBatchStatus {
  EXPECTED
  CONFIRMED
  SHORT
  DISPUTED
}

model SettlementBatch {
  id                    String                @id @default(cuid())
  settlementProviderId  String
  /// The institution's own batch/reference id — external, opaque, never
  /// reused as this repository's own key. Unique per provider so a
  /// redelivered confirmation resolves to the same batch, never a duplicate.
  externalBatchRef      String
  /// Sum of the Payment rows this batch is meant to cover.
  expectedAmountMinor   Int
  /// What the institution actually confirmed — null until reconciled.
  settledAmountMinor    Int?
  status                SettlementBatchStatus @default(EXPECTED)
  settledAt             DateTime?
  /// Set only when a SHORT batch's shortfall has been accepted and posted
  /// as a write-off (SettlementService.writeOffShortfall()) — a SHORT batch
  /// with this null is still an open, unresolved variance.
  writtenOffAt          DateTime?
  /// The maker-checker pair CreditNotesService.issue() already establishes
  /// (145-receivables-credit-limits-dunning.md), applied here: above the
  /// configured value threshold, writeOffShortfall() refuses unless
  /// writeoffApprovedById is set and differs from writeoffRequestedById.
  /// Below the threshold, a single actor's own request is enough — neither
  /// field is required.
  writeoffRequestedById String?
  writeoffApprovedById  String?
  writeoffNote          String?
  createdAt             DateTime              @default(now())

  provider SettlementProvider    @relation(fields: [settlementProviderId], references: [id])
  lines    SettlementBatchLine[]

  @@unique([settlementProviderId, externalBatchRef])
  @@index([status])
}

/// Which of our own Payment rows this settlement batch is meant to cover —
/// the join a reconciliation report walks.
model SettlementBatchLine {
  id          String @id @default(cuid())
  batchId     String
  paymentId   String
  amountMinor Int

  batch   SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payment Payment         @relation(fields: [paymentId], references: [id])

  @@unique([batchId, paymentId])
}

// SSO / identity federation
// (access-control-identity/161-sso-identity-federation.md, WO-161.1).
//
// One row per identity provider this deployment's own staff may sign in
// through — more than one is allowed (say, a Google Workspace and an Entra
// ID tenant for the same shop). No organizationId, deliberately: this
// codebase's tenant boundary is the deployment itself (DECISIONS.md
// ADR-040, receivables.prisma's own header), and `Organization` is the
// optional multi-brand grouping inside ONE deployment, not a tenant. An SSO
// connection belongs to the deployment, like every other sign-in setting.
//
// Always admin-authored (`settings.sso.manage`), never self-service — which
// is what keeps `allowedEmailDomains` a trustworthy gate (doc 161 §2).

/// OIDC only. SAML is WO-161.2b, added once a real client names a SAML-only
/// identity provider — never pre-built for a protocol nobody has asked for.
enum SsoProtocol {
  OIDC
}

/// SUSPENDED stops new sign-ins through the connection at once, and touches
/// no already-provisioned or linked `User` — "revoke the method, not the
/// account" (doc 161, "The grant that ends itself").
enum SsoConnectionStatus {
  ACTIVE
  SUSPENDED
}

model SsoConnection {
  id                  String              @id @default(cuid())
  protocol            SsoProtocol
  /// Shown on the sign-in screen as "Sign in with <label>".
  label               String
  /// The issuer identifier; its /.well-known/openid-configuration is read at
  /// sign-in. https, or http on a loopback host only (SsoService refuses
  /// anything else — a discovery document fetched in clear text names the
  /// keys every ID token is checked against).
  issuerUrl           String
  clientId            String
  /// The OIDC client secret, AES-256-GCM via @newax/shared's secret-crypto
  /// under APP_ENCRYPTION_KEY — the discipline
  /// TradingPartner.outboundApiKeyEncrypted already follows. Write-only:
  /// never selected by a read that leaves SsoService.
  credentialEncrypted String
  /// The hard gate (doc 161 §2): an ID token for an email at any other
  /// domain is refused before any `User` lookup. Stored lowercased and
  /// matched exactly — a subdomain is not the domain.
  allowedEmailDomains String[]
  /// The `Role` a brand-new sign-in is provisioned into. It must exist and
  /// hold no NON_DELEGATABLE_PERMISSIONS entry — checked on every write and
  /// again at provisioning, so least privilege survives a later role edit.
  defaultRoleName     String
  status              SsoConnectionStatus @default(ACTIVE)
  /// WO-165.6 (165-cross-tenant-marketplace-directory.md §3, piece one):
  /// "login should remain with SSO only". When true, `AuthController`'s
  /// password route refuses sign-in for every STAFF/TAILOR/ADMIN account
  /// (`User.role !== 'CUSTOMER'` — a plain customer is never affected) with
  /// a message pointing at the SSO button — except `createdByUserId` below,
  /// so the admin who turned enforcement on can never lock themselves out of
  /// undoing it. Additive, default false: with every connection at the
  /// default, erp-1's login screen is byte-identical to today's (doc 161's
  /// own acceptance, restated in doc 165's own Acceptance section).
  enforceSso          Boolean             @default(false)
  /// A plain id, not a relation — the audit rows carry the actor of every
  /// later change, and this survives that person's own erasure as an id.
  createdByUserId     String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  /// The sign-in screen's list of ACTIVE connections.
  @@index([status])
}

// Stitching: the style options a customer picks, standalone stitching orders
// (customer's own fabric), and the tailor production queue.
//
// A StitchingJob attaches to EITHER an OrderItem (stitching bought with fabric)
// OR a StitchingOrder (customer sent their own cloth). One model, one queue,
// two entry points — the tailor screen does not care which door a job came in.

enum StitchingSelectionType {
  SINGLE
  MULTI
}

model StitchingOptionGroup {
  id            String                 @id @default(cuid())
  key           String                 @unique // "neckline", "sleeve_style"
  labelEn       String
  labelUr       String
  garmentTypeId String?
  /// Body region the group styles: "neck", "sleeves", "upper_front",
  /// "lower_front", "back", "trouser", "finishing". The storefront groups the
  /// picker by this; null lands under "other".
  area          String?
  selectionType StitchingSelectionType @default(SINGLE)
  required      Boolean                @default(false)
  order         Int                    @default(0)
  isActive      Boolean                @default(true)

  /// Some styles cannot be enumerated — let the customer describe theirs.
  allowCustomText Boolean @default(false)
  helpEn          String?
  helpUr          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garmentType GarmentType?      @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)
  options     StitchingOption[]

  @@index([garmentTypeId, order])
  @@index([area, order])
}

model StitchingOption {
  id         String  @id @default(cuid())
  groupId    String
  key        String
  labelEn    String
  labelUr    String
  /// Added to the stitching fee, in paisa. May be negative for a cheaper style.
  priceDelta Int     @default(0)
  imageUrl   String?
  order      Int     @default(0)
  isActive   Boolean @default(true)

  group          StitchingOptionGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartSelections CartItemStitchingOption[]

  @@unique([groupId, key])
  @@index([groupId, order])
}

enum StitchingOrderStatus {
  DRAFT
  AWAITING_FABRIC
  FABRIC_RECEIVED
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

/// A tailoring booking where the customer supplies the cloth.
model StitchingOrder {
  id        String               @id @default(cuid())
  number    String               @unique // "STO-2026-0001"
  userId    String?
  contactId String?
  status    StitchingOrderStatus @default(DRAFT)

  guestName  String?
  guestPhone String?
  guestEmail String?

  /// Snapshot; the customer may edit their address book afterwards.
  pickupAddress    Json?
  deliveryAddress  Json?
  fabricNotes      String?
  staffNotes       String?
  quotedFee        Int? // paisa
  fabricReceivedAt DateTime?
  promisedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  // `contactId` is a plain scalar, not a Prisma relation to Contact (core) —
  // B7, MULTI-SECTOR.md. A pack referencing core is allowed, but Prisma
  // requires a typed relation to be declared on BOTH models, which would put
  // a `StitchingOrder` field back on core's Contact. Losing the relation
  // means losing onDelete: SetNull here; nothing in this codebase deletes a
  // Contact today. Look it up with `prisma.contact.findUnique()` if needed.
  jobs             StitchingJob[]

  @@index([status])
  @@index([userId])
  @@index([contactId])
}

enum StitchingStage {
  RECEIVED
  CUTTING
  STITCHING
  QC
  READY
  DISPATCHED
}

model StitchingJob {
  id               String  @id @default(cuid())
  number           String  @unique // "JOB-2026-0001"
  /// Exactly one of these two is set. Enforced in the stitching service.
  orderItemId      String? @unique
  stitchingOrderId String?

  garmentTypeId       String
  /// Measurements as they were when the order was placed. Profiles change;
  /// a job in production must not.
  measurementSnapshot Json
  /// The chosen style options, denormalised for the tailor's worksheet.
  optionsSnapshot     Json?
  instructions        String?

  stage            StitchingStage @default(RECEIVED)
  assignedTailorId String?
  priority         Int            @default(0)
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // `orderItemId` is a plain scalar, not a Prisma relation to OrderItem
  // (core) — see the note on StitchingOrder.contactId above; same reason,
  // same trade-off (no onDelete: Cascade at the DB level any more). Order
  // items are snapshots that are never hard-deleted (House Rule 7), so this
  // costs nothing in practice. Joined manually where needed — see
  // StitchingJobsService.attachOrderContext() and
  // EntityEnrichmentRegistry's "orderItem.stitchingJob" point.
  stitchingOrder StitchingOrder?     @relation(fields: [stitchingOrderId], references: [id], onDelete: Cascade)
  garmentType    GarmentType         @relation(fields: [garmentTypeId], references: [id], onDelete: Restrict)
  events         StitchingJobEvent[]

  @@index([stage, dueAt])
  @@index([assignedTailorId, stage])
  @@index([stitchingOrderId])
}

/// Every stage transition, appended and never updated. The customer's progress
/// timeline and the admin queue both read this.
model StitchingJobEvent {
  id        String          @id @default(cuid())
  jobId     String
  fromStage StitchingStage?
  toStage   StitchingStage
  note      String?
  photoUrl  String?
  actorId   String?
  createdAt DateTime        @default(now())

  job StitchingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model TailorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  phone           String?
  specialties     String[] @default([])
  capacityPerWeek Int      @default(20)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Backing store for sequential per-year STO-2026-0001 numbers. Same shape
/// and same reason as OrderNumberCounter (orders.prisma): one row per year,
/// incremented via a single atomic INSERT ... ON CONFLICT DO UPDATE ...
/// RETURNING rather than a MAX(StitchingOrder.number) read, which is a
/// read-then-write race between two concurrent bookings.
model StitchingOrderNumberCounter {
  year    Int @id
  counter Int @default(0)
}

/// Same as StitchingOrderNumberCounter, for JOB-2026-0001 numbers. Shared by
/// both places a job is born — see nextJobNumber() in
/// stitching/jobs.service.ts.
model StitchingJobNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// In-app help desk (internal) — tasks-notifications-support/64-help-desk-
// support-ticketing.md, DECISIONS.md ADR-064. A standalone module: nothing
// else in this repository depends on it, and it depends on no other
// optional module (MOD-1).
//
// No organizationId anywhere (ADR-040/044/046/049/060/062): this
// deployment IS the tenant boundary. raisedByUserId/assignedToUserId/
// TicketMessage.authorId are bare scalars, no `@relation` — the same
// "erasure the ledger cannot obey" shape MeetingInvitation.userId and
// EscalationFire.taskId already use, so a deleted User never forces a
// cascade decision onto this module.
//
// External (customer-facing) support ticketing is doc 148's own,
// separately-scoped work — a distinct actor model (Contact/Party, not
// User) — never conflated with this internal help desk.

model SupportTicket {
  id       String @id @default(cuid())
  raisedByUserId String

  subject  String
  /// Free text, not a closed enum — a client's own support taxonomy
  /// varies, the same reasoning `LeaveType`/`DeductionType` already rest
  /// on (rows, not an enum, for anything that varies per deployment).
  category String

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  assignedToUserId String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  messages TicketMessage[]

  @@index([status, assignedToUserId])
  @@index([raisedByUserId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// An append-only reply thread — a correction is a new message, never an
/// edit in place, the same immutable-thread discipline this repository
/// already applies everywhere else a conversation is recorded.
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  authorId String
  body     String

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// External (customer-facing) support ticketing —
// tasks-notifications-support/148-external-customer-support-portal.md,
// DECISIONS.md ADR-065. A genuinely different actor model from
// SupportTicket above: the requester is Contact (doc 20's three-table
// framework applied to a customer), never User — the document's own
// central answer, restated in its own words: "the actor model,
// visibility rule, and audience are genuinely different, so this is its
// own model." Only the staff/handler side reuses doc 64's own
// permissions and action-hub registration unchanged.

/// TicketPriority above is reused unchanged — "identical shape, no reason
/// to diverge" (the document's own words). AWAITING_CUSTOMER is the one
/// status doc 64's own internal ticket never needed: an internal
/// requester and handler are both staff on the same side of the trust
/// boundary, but a customer ticket genuinely needs its own "waiting to
/// hear back from the customer" SLA clock, distinct from "we're working
/// on it."
model CustomerSupportTicket {
  id        String  @id @default(cuid())
  contactId String
  /// Optional — many tickets are order-specific ("where is my parcel").
  orderId   String?

  subject  String
  category String
  status   CustomerTicketStatus @default(OPEN)
  priority TicketPriority       @default(NORMAL)

  assignedToUserId String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  messages CustomerSupportMessage[]

  @@index([status, assignedToUserId])
  @@index([contactId])
}

enum CustomerTicketStatus {
  OPEN
  AWAITING_CUSTOMER
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// authorType makes which side of the trust boundary a message came from
/// explicit, rather than inferring it from which id column is non-null —
/// the document's own reasoning, quoted directly. Append-only, same
/// immutable-thread discipline as TicketMessage above.
model CustomerSupportMessage {
  id         String                   @id @default(cuid())
  ticketId   String
  authorType SupportMessageAuthorType
  /// Set when authorType = CUSTOMER.
  contactId  String?
  /// Set when authorType = STAFF.
  userId     String?
  body       String

  createdAt DateTime @default(now())

  ticket CustomerSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum SupportMessageAuthorType {
  CUSTOMER
  STAFF
}

// Task allotment, status and tracking
// (tasks-notifications-support/23-tasks-allotment-tracking.md, DECISIONS.md
// ADR-049).
//
// Three decisions, per the doc's own text:
//   1. Work is assigned to a post (Position, required), and OPTIONALLY to a
//      person (assigneeUserId, nullable). The post is the durable address;
//      the person is who currently holds it. A leaver's open tasks are left
//      at the post, marked unclaimed — see hr's PostingEnded event and this
//      module's own task-leaver.listener.ts. No automatic reassignment.
//   2. Status is a small, fixed enum (TaskState) plus a per-deployment
//      workflow stage (TaskStageDefinition) inside IN_PROGRESS.
//   3. A transition is an event (TaskTransition), never an overwrite of
//      Task.state — cycle time in each state must be computable from
//      TaskTransition alone.
//
// ADR-049's three deviations from the doc's own literal text, applied here:
//   - `assigneeUserId`, not `assigneeEmployeeId` — ADR-044 already resolved
//     docs 19/20 with no Employee model; every actor is a User.
//   - `TaskStageDefinition.organizationId` dropped, `key` unique alone — the
//     same correction ADR-040/ADR-044/ADR-046 already make three times: this
//     deployment IS the tenant boundary, and `organization` is off by
//     default everywhere today (modules.registry.ts).
//   - The tasks.assign/tasks.close toxic pair is a per-instance check inside
//     TaskService.close(), not a TOXIC_PERMISSION_PAIRS entry — see that
//     file's own header comment and ADR-049.

enum TaskState {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model Task {
  id String @id @default(cuid())

  /// Human reference, per deployment. Gapless is NOT required here — a task
  /// number is not a legal document (doc 25 is where gapless matters) — so
  /// it is derived straight from `id` (TaskService.reference()) rather than
  /// a shared counter. This is deliberate: a shared max()+1 counter is
  /// exactly the "adoption test" trap CLAUDE.md names — two branch nodes
  /// creating tasks offline (this module's own "Four hours down" answer:
  /// tasks are branch-authoritative and replicate up) would collide on the
  /// same next number. Deriving from `id` needs no counter and cannot
  /// collide across any number of nodes.
  reference String
  title     String
  detail    String?

  /// The durable address. Required — see this file's header, decision 1.
  positionId String
  /// The current holder, when there is one. NULL means unclaimed at that
  /// post. Never a hard relation to User (no `@relation` here) — the same
  /// "erasure the ledger cannot obey" reasoning as `createdByUserId` and
  /// `TaskTransition.byUserId` below: this column must survive the User row
  /// being gone, so it is a bare scalar, not an FK a cascade could follow.
  assigneeUserId String?
  /// Where the work belongs, copied at write time (from the Position's own
  /// orgUnitId, at creation) so a re-parent of the position later does not
  /// move this task's history. Bare scalar, not a relation — see
  /// TaskService.create()'s own comment for exactly how it is derived; there
  /// is no default() path that invents one.
  orgUnitId String

  state    TaskState @default(OPEN)
  stageId  String?
  priority Int       @default(0)
  dueAt    DateTime?

  /// Ecosystem audit 2026-10-29 (merged from @newaxhq/tasks's CpmSolver):
  /// days, used by TaskDependencyService.computeCriticalPath(). Null means
  /// "not estimated" — such a task defaults to 1 day in a CPM run rather
  /// than silently excluding it from the schedule.
  estimatedDurationDays Int?

  /// What this task is about, when it came from somewhere else — an order,
  /// a stock count, a requisition. Polymorphic by (type, id) rather than a
  /// foreign key per module, because `tasks` must stay droppable and must
  /// never import the module it serves (module independence, CLAUDE.md) —
  /// see core/extension-points/task-source.registry.ts (WO-23.3).
  sourceType String?
  sourceId   String?
  /// Idempotency for machine-created tasks: a redelivered domain event must
  /// not raise a second task. NULL for hand-created tasks, which are not
  /// idempotent and should not be (same NULL exemption as every composite
  /// unique elsewhere in this schema).
  sourceRef String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  closedAt        DateTime?

  position     Position         @relation(fields: [positionId], references: [id])
  transitions  TaskTransition[]
  dependsOn    TaskDependency[] @relation("TaskDependencySuccessor")
  blocks       TaskDependency[] @relation("TaskDependencyPredecessor")

  @@unique([sourceType, sourceRef])
  @@index([positionId, state])
  @@index([assigneeUserId, state])
  @@index([orgUnitId, state])
  @@index([dueAt])
}

/// Ecosystem audit 2026-10-29 (merged from @newaxhq/tasks's CpmSolver and
/// DependencyCascadeEngine): one directed edge, predecessor -> successor.
/// Cycle detection is the CPM solve's own job (it already throws on one),
/// not an insert-time check here — the same division of labour the
/// original package already drew between building the graph and solving
/// it.
model TaskDependency {
  id                 String @id @default(cuid())
  predecessorTaskId  String
  successorTaskId    String
  createdAt          DateTime @default(now())

  predecessor Task @relation("TaskDependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskDependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

/// The history TaskService.transition() writes on every state change — see
/// this file's header, decision 3. Not written for an assignment change
/// (TaskService.assign()): this table's columns are about Task.state and
/// Task.stageId only, never about who holds the task — see task.service.ts's
/// own comment on assign() for where an assignment IS recorded (AuditLog,
/// action 'task.assigned'), and why that is exactly what TaskService.close()
/// reads for its own toxic-pair check.
model TaskTransition {
  id          String     @id @default(cuid())
  taskId      String
  fromState   TaskState?
  toState     TaskState
  fromStageId String?
  toStageId   String?
  /// Who moved it. NULL when the mover was the system (e.g. a machine-
  /// created task's own initial OPEN transition, sourceType/sourceRef set).
  byUserId  String?
  reason    String?
  occurredAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, occurredAt])
}

/// A client's own workflow stages inside IN_PROGRESS — rows, not an enum,
/// exactly as OrgUnitType and Rank are rows (this file's header, decision 2).
/// No organizationId (ADR-049's own dropped-column correction, above):
/// `key` is unique alone.
model TaskStageDefinition {
  id    String @id @default(cuid())
  key   String @unique
  label String
  order Int
}

// Tax: rate/class definitions and the pricing-mode setting. Universal
// capability, pack `core` (MULTI-SECTOR.md) -- every shop, every sector,
// every business model needs a tax answer, not just B2B's "tax exemption."
// See docs/implementation/tax-compliance/15-tax-module.md for the full design and the
// reasoning behind the inclusive/exclusive split.

model TaxClass {
  id        String   @id @default(cuid())
  key       String   @unique // "standard", "zero_rated", "exempt"
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates    TaxRate[]
  variants ProductVariant[]

  @@index([isDefault])
}

/// One row per rate that has ever applied to a class. Effective-dated so a
/// GST rate change doesn't rewrite history -- an order snapshots the rate it
/// was charged (House Rule 7) and never looks this table up again after
/// placement.
model TaxRate {
  id          String    @id @default(cuid())
  taxClassId  String
  /// Basis points, not a float -- 1700 = 17%. Never a percentage as a Float.
  rateBps     Int
  effectiveAt DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  taxClass TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@index([taxClassId, effectiveAt])
}

// The trading-partner network (18-trading-partner-network.md, WO-18) — lets
// a supplier, distributor or wholesaler that also runs this software (or
// exposes any HTTP+JSON API) exchange documents with this deployment
// without either side re-typing them. A `Supplier` with no linked
// `TradingPartner` behaves exactly as it always has: nothing here is
// required for purchasing to keep working.

enum TradingPartnerKind {
  /// We buy from them — their invoice becomes our SupplierBill (WO-18.2).
  SUPPLIER
  /// They buy from us — not wired to anything yet; reserved so `kind`
  /// doesn't need a breaking change when the sell-side direction is built.
  CUSTOMER
  BOTH
}

enum TradingPartnerStatus {
  /// Registered, no working inbound key yet — cannot authenticate.
  PENDING
  ACTIVE
  /// Manually disabled; `verifyInboundKey` (WO-18.2) refuses a SUSPENDED
  /// partner's key even if it still hashes correctly.
  SUSPENDED
}

/// The business on the other end of a document exchange. Two independent
/// credentials, because the two directions are independent capabilities:
/// `outboundApiKeyEncrypted` is what WE present calling THEM
/// (`outboundBaseUrl`, WO-18.3); `inboundApiKeyHash` is what THEY must
/// present calling US (WO-18.2). Either, both, or neither may be set — a
/// partner who only ever pushes to us never needs an outbound key, and vice
/// versa.
model TradingPartner {
  id   String             @id @default(cuid())
  name String
  kind TradingPartnerKind

  outboundBaseUrl         String?
  /// AES-256-GCM via @newax/shared's secret-crypto.ts — never stored plain,
  /// same as an email account's SMTP password.
  outboundApiKeyEncrypted String?

  /// SHA-256 of the raw key (core/security/api-token.ts) — the raw key
  /// itself is shown to the operator exactly once, at issue/rotate time,
  /// and never persisted. Unique so a presented key resolves its partner in
  /// one indexed lookup rather than a hash comparison per row.
  inboundApiKeyHash String? @unique

  /// The role they confirmed at acceptance — SUPPLIER, MANUFACTURER,
  /// DISTRIBUTOR or RETAILER (parties.prisma's own `PartyRoleName`, reused
  /// rather than duplicated). Recorded verbatim for display/audit; `kind`
  /// is derived from it at accept time and stays the field push-routing
  /// (WO-18.3) reads, so nothing downstream needs to know this exists.
  acceptedRole PartyRoleName?

  /// First-connection handshake — "send a request, they accept to start the
  /// relation." A partner created with no credentials at all gets one of
  /// these. Same shape as `inboundApiKeyHash`: a single-use secret shown to
  /// the operator once, never persisted raw, and cleared the moment
  /// `acceptConnection()` succeeds so a stale link cannot be replayed.
  inviteTokenHash String?   @unique
  invitedAt       DateTime?
  acceptedAt      DateTime?
  /// Where the invite link is emailed, if we have one on file. Optional —
  /// an invite with no address still works, the operator just shares the
  /// link by hand.
  contactEmail    String?

  /// WO-213.1 (213-partner-fact-exchange.md). When `inboundApiKeyHash` stops
  /// working. Null means it never expires: a key issued before this column
  /// existed, or issued while the `partners.key_ttl_days` setting was 0.
  /// Enforced in `verifyInboundKey()`, never left to a caller.
  inboundKeyExpiresAt       DateTime?
  /// WO-213.1. The staff user who last issued the inbound key. A bare scalar
  /// (no `@relation` to core's `User`), read by the toxic-pair guard so that
  /// whoever minted a partner's key cannot also clear that partner's review
  /// queue (WO-213.5). Null for a key issued before this column existed.
  inboundKeyRotatedByUserId String?

  status    TradingPartnerStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  suppliers Supplier[]
  facts     PartnerFactInbox[]

  @@index([status])
}

enum PartnerFactStatus {
  /// Stored and acknowledged; nothing has acted on it yet.
  RECEIVED
  /// The subscribing module applied it (for `sale.dispatched`: a purchase
  /// order now exists).
  APPLIED
  /// Stored, but something needs a person: an unknown barcode, a price far
  /// from the supplier's last. Never dropped, never guessed — it waits in a
  /// named queue (WO-213.5).
  NEEDS_REVIEW
  /// A person decided this fact must not be applied.
  REJECTED
}

/// One fact a connected partner sent us (WO-213.1, 213-partner-fact-exchange.md
/// and ADR-087). "Store first, apply second": the inbound endpoint writes this
/// row and answers 202, so acknowledging means "stored", never "applied", and
/// a slow or absent `purchasing` module cannot make a partner's delivery fail.
///
/// `(tradingPartnerId, factId)` is unique, which makes the second copy of the
/// same fact a no-op by constraint: the sender retries for up to 72 hours, so
/// the same factId WILL arrive twice. `factId` is a UUID the SENDING node
/// generated, so two nodes never collide offline.
///
/// `type` is a string, not an enum, on purpose: adding a fact type must never
/// need a migration. The accepted values live in `partner-fact.dto.ts`.
model PartnerFactInbox {
  id                     String            @id @default(cuid())
  tradingPartnerId       String
  /// Generated by the sender (UUID v4). Half of the idempotency key.
  factId                 String
  /// "sale.dispatched" | "receipt.confirmed" — see `type`'s note above.
  type                   String
  /// The fact's own shape version. The applier for version n is kept forever
  /// so an old fact replays exactly as it was decided.
  schemaVersion          Int
  /// The sender's own document number, when the fact carries one (a
  /// `sale.dispatched` fact's invoice number). Display and reconciliation
  /// only — the buyer never reuses it as one of its own numbers.
  documentRef            String?
  /// When it happened at the sender — not when we received it.
  occurredAt             DateTime
  /// sha256 of the canonical (key-sorted) payload. Lets a repeat of the same
  /// factId with a DIFFERENT payload be refused rather than silently replayed.
  payloadHash            String
  /// The validated fact. Set to null, row kept, after 400 days (the
  /// retention cron, sequenced with WO-213.4): metadata stays for audit.
  payload                Json?
  status                 PartnerFactStatus @default(RECEIVED)
  /// Why it is NEEDS_REVIEW or REJECTED, in words an operator can act on.
  statusReason           String?
  /// Set when status is APPLIED and the fact produced a purchase order. A
  /// bare scalar, no `@relation`: purchasing is decoupled from this module
  /// (ADR-012). Null means "not applied".
  appliedPurchaseOrderId String?
  receivedAt             DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  /// Restrict, not Cascade: a received fact is an audit record, and deleting
  /// a partner must never silently delete what it sent. Suspend it instead.
  partner TradingPartner @relation(fields: [tradingPartnerId], references: [id], onDelete: Restrict)
  // A partial index on `receivedAt WHERE status IN ('RECEIVED','NEEDS_REVIEW')`
  // serves the queue screen; Prisma cannot express one, so it lives in the
  // migration only (20260930100000_wo213_1_partner_fact_inbox).

  @@unique([tradingPartnerId, factId])
  @@index([tradingPartnerId, receivedAt])
}

/// A marketing push to the retail end of the chain (WO-18.3's third "forth"
/// document, alongside the product-alerts push) — never targeted, never a
/// coupon engine: one broadcast row, fanned out to every ACTIVE
/// CUSTOMER/BOTH partner the same way a new product is. `discountLabel` is
/// display text a partner's own system shows; nothing here is redeemed or
/// enforced by this deployment.
model Offer {
  id            String    @id @default(cuid())
  title         String
  description   String
  discountLabel String?
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
}

// Inter-branch stock transfers (RETAIL-ERP.md R4, Tranche 5). Off by default
// — see modules.registry.ts. Inter-brand transfers via the org tier (R4's
// own "for an inter-brand transfer the in-transit location belongs to the
// organization tier", WO-22.2) and settlement modes + InterBranchInvoice
// (R12/R17, WO-22.3) are both built below now.
//
// R4 is the whole design: in-transit is a Location, not a flag or a status
// string. `sourceLocationId`/`destinationLocationId`/`inTransitLocationId`
// are bare scalars (inventory.prisma is a different module's schema file,
// same "no cross-module Prisma coupling" choice PosTerminal.locationId and
// Order.locationId already made) — TransfersService checks they exist at
// write time and owns the in-transit Location's whole lifecycle, creating
// it on dispatch and never touching it again after receipt/cancel empties it.

enum StockTransferStatus {
  /// Dispatched: stock has left the source and sits in the transfer's own
  /// IN_TRANSIT location. The only status a transfer can be received or
  /// cancelled from.
  IN_TRANSIT
  RECEIVED
  /// Ecosystem audit 2026-10-29: receive() reached here with a short
  /// receipt (quantityReceived < quantityDispatched on at least one line).
  /// The write-off and any INVOICED invoicing already happened — same as
  /// before this status existed — but the transfer itself now waits for a
  /// human-acknowledged reconcile() before it is considered closed, instead
  /// of silently finishing as a plain RECEIVED with no record that anything
  /// was short.
  DISCREPANCY
  /// Reached only from DISCREPANCY via reconcile() — the short receipt has
  /// been reviewed and explained.
  RECONCILED
  CANCELLED
}

/// R12 — "money between branches and brands is a setting, not a fork."
/// Resolved automatically by TransfersService.resolveTransferSettlement(),
/// never client-supplied: NONE for owned-to-owned inside one brand
/// (including today's default, every Location's retailBrandId null); INVOICED
/// by construction the moment a transfer genuinely crosses a RetailBrand
/// (R17 — two brands are two businesses). INTERNAL_PL is a real value in
/// R12's own list but WO-22.3 does not derive it anywhere: R12 states a
/// concrete trigger for the other two only, and no other ruling names one for
/// this — inventing a trigger nothing specified would be exactly the
/// speculative functionality this codebase's operating protocol forbids.
/// Left buildable, not built.
enum SettlementMode {
  NONE
  INTERNAL_PL
  INVOICED
}

model StockTransfer {
  id             String              @id @default(cuid())
  /// Node-prefixed per R6 — see nextTransferNumber() in transfers.service.ts,
  /// the same TransferNumberCounter pattern orders.service.ts's
  /// nextOrderNumber() already uses.
  number         String              @unique
  status         StockTransferStatus @default(IN_TRANSIT)
  /// Resolved once at dispatch() and never changed — see SettlementMode.
  settlementMode SettlementMode      @default(NONE)

  sourceLocationId      String
  destinationLocationId String
  /// The Location this transfer's own dispatch created — one in-transit
  /// bucket per transfer, never shared. Cleared to net zero by receive() or
  /// cancel(); the row itself is never deleted (it is the transfer's own
  /// ledger anchor — every TRANSFER_OUT/TRANSFER_IN movement for this
  /// transfer references it).
  inTransitLocationId   String

  createdByUserId    String
  receivedByUserId   String?
  reconciledByUserId String?

  note String?
  /// Set only by reconcile(), moving a DISCREPANCY transfer to RECONCILED.
  discrepancyReason String?

  dispatchedAt  DateTime  @default(now())
  receivedAt    DateTime?
  reconciledAt  DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines              StockTransferLine[]
  /// Set only when settlementMode is INVOICED, and only once receive()
  /// values what actually arrived (R12/R17, WO-22.3) — see
  /// InterBranchInvoice's own comment for why receive(), not dispatch().
  interBranchInvoice InterBranchInvoice?

  @@index([status])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  /// Bare scalar — catalog is a different module's schema file, same
  /// convention OrderItem.productId/variantId already use for cross-module
  /// snapshot fields.
  variantId  String

  quantityDispatched Int
  /// Null until received. Less than quantityDispatched means a short
  /// receipt — receive() write-offs the difference from the in-transit
  /// location rather than silently letting it vanish from the ledger.
  quantityReceived   Int?
  /// ProductVariant.costPrice (the running weighted-average) snapshotted at
  /// dispatch() — House Rule 7, a line is a snapshot, so a cost change
  /// between dispatch and receive never retroactively reprices an invoice
  /// already promised. Null unless settlementMode is INVOICED: NONE and
  /// INTERNAL_PL transfers need no valuation, so none is computed.
  unitCost           Int?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([variantId])
}

/// R12/R17's settlement document for an INVOICED transfer (WO-22.3) — the
/// `transfers` module's own, distinct from the general-purpose `Invoice` R18
/// gives the future `invoicing` module (WO-23.4): different lifecycle,
/// different numbering, and RETAIL-ERP.md's own module-ownership table lists
/// them apart. One per transfer (transferId is unique), created by receive()
/// rather than dispatch() — billing what actually ARRIVED, valued at each
/// line's dispatch-time unitCost, so a short receipt never invoices the
/// buying brand for stock that never reached it (the shortfall is already
/// written off separately, on the physical stock ledger). No payment/
/// settlement workflow yet — the AR/AP balance the posting rule books is the
/// open claim; collecting it is real future work, not fabricated here.
model InterBranchInvoice {
  id     String @id @default(cuid())
  /// Node-prefixed per R6, same counter-row pattern as TransferNumberCounter.
  number String @unique

  transferId String @unique

  /// Bare scalars — RetailBrand lives in organization.prisma, a different
  /// module's schema file (same cross-module convention Location.retailBrandId
  /// already uses). The seller and the buyer in this trade.
  sourceRetailBrandId      String
  destinationRetailBrandId String

  /// Sum of each line's (unitCost * quantityReceived) — the transfer price,
  /// which R12 fixes at weighted-average cost, so this invoice never carries
  /// a markup and the posting rule's Revenue/COGS pair always nets to zero
  /// group-wide (no unrealized intercompany profit to defer — R17's own
  /// harder case simply cannot arise while transfer pricing has no markup
  /// lever, which nothing in this codebase gives it yet).
  amountMinor Int

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([sourceRetailBrandId])
  @@index([destinationRetailBrandId])
}

/// Same shape as OrderNumberCounter (orders.prisma) — an
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` counter row sidesteps
/// the read-then-write race a MAX(number)+1 read would have under
/// concurrent dispatches, for the same reason nextOrderNumber()'s own
/// doc comment gives in full.
model TransferNumberCounter {
  year    Int @id
  counter Int @default(0)
}

/// Same shape as TransferNumberCounter, one counter per InterBranchInvoice
/// rather than sharing the transfer's own sequence — a different document,
/// a different legal/audit trail, R6's own reasoning for keeping numbering
/// series apart per document kind.
model InterBranchInvoiceNumberCounter {
  year    Int @id
  counter Int @default(0)
}

// 155-wallet-stored-value-merchant-escrow.md
//
// Newax-issued store credit, settling merchants as an ordinary trade
// payable — never third-party fund custody. Read the doc's own "Read this
// section first" before touching this file: the structure exists
// specifically so neither leg of the money movement is "holding a third
// party's funds in trust for disbursement" (the PSO/PSP question). A
// customer's PURCHASE is an ordinary sale of a Newax-issued product; a
// merchant's MerchantPayable is an ordinary trade payable, the same legal
// shape as doc 145's own SupplierBill.
//
// Shipped module-off (WO-155.0 is unresolved — see DECISIONS.md): this file
// exists, compiles and is fully tested, but WalletModule is registered in
// modules.registry.ts with no deployment enabling it in MODULES today.
//
// Two deliberate departures from the doc's own literal Prisma snippet,
// each with its own reason recorded where it matters:
//   1. WalletAccount.customerId names `User`, not `Party`/`Contact` — see
//      the model's own comment.
//   2. `@@unique([customerId])` alone, not `@@unique([organizationId,
//      customerId])` — see WalletAccount's own comment.

enum WalletEntryType {
  PURCHASE // customer buys credit — real money into Newax's own bank account, booked as deferred revenue
  RESERVE // credit earmarked against a specific order at checkout — not yet spent
  REDEEM // the earmark converts to an actual spend, exactly when the merchant confirms the order
  RELEASE_RESERVATION // the merchant does not confirm (rejects, expires) — the earmark returns to available, unspent
  REFUND // reverses a PURCHASE or a REDEEM
  ADJUSTMENT // a manual, always-approved-above-threshold, always-reasoned correction
}

enum WalletAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

/// One wallet per customer — the ONLY owner type (§1: no merchant-side
/// wallet exists; a merchant's own money position is `MerchantPayable`
/// below, an ordinary payable, never a balance).
///
/// `customerId` names `User`, not the doc's own literal `Party`/`Contact`
/// (the "actor with three tables" lens allows any of the three named
/// tables — this repo's own closest sibling feature, `StoreCreditService`
/// / `StoreCreditTransaction` (giftcards.prisma), already keys an
/// identical customer balance ledger to `User.id`, as does
/// `WishlistItem`/`LoyaltyTransaction`. Keying `WalletAccount` to `Contact`
/// instead would be the one inconsistent ledger in this codebase's own
/// "customer balance" family, and would need a `Contact`-from-`User`
/// resolution step this codebase does not otherwise need — House Rule
/// "follow existing conventions" wins over the doc's own abstract phrasing
/// here.
model WalletAccount {
  id String @id @default(cuid())

  /// Newax's own Organization tier (RETAIL-ERP.md R14) — the "second legal
  /// entity"/"three silhouettes" scope column, present in the first
  /// migration and never rendering at Solo/Chain. Nullable there on
  /// purpose: `organizationId` is unset outside the Organization-tier
  /// shared-hosting deployment this document itself names as "the real
  /// case this document exists for" (§5's own answer). NOT part of the
  /// uniqueness key below — see that field's own comment.
  organizationId String?
  customerId     String              @unique
  currency       String              @default("PKR")
  status         WalletAccountStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  customer           User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries            WalletEntry[]
  adjustmentRequests WalletAdjustmentRequest[]

  @@index([organizationId])
}

/// Append-only, exactly as the doc requires — a correction is a new,
/// opposite entry, never an edit. `orderId` is a plain scalar (no Prisma
/// relation to `Order`) — the same "reference by id, join in application
/// code" idiom `StitchingJob.orderItemId`'s own comment documents, so
/// `orders` never has to declare a typed back-reference to a module it may
/// never enable.
model WalletEntry {
  id          String          @id @default(cuid())
  accountId   String
  type        WalletEntryType
  amountMinor Int // always positive; direction implied by `type`
  orderId     String?
  /// Idempotency key — a Payment.id, an Order.id, a WalletAdjustmentRequest.id.
  /// Never a re-derived string (House Rule 11).
  sourceRef   String
  /// Set only for ADJUSTMENT — who is recorded as having caused the write:
  /// the requester for a below-threshold self-serve adjustment, or the
  /// approver's own decision for an above-threshold one (WalletAdjustmentRequest
  /// carries the requester in that case).
  actorId     String?
  /// Required, human-readable, for ADJUSTMENT only — "a manual, always-
  /// reasoned correction" (§1's own words).
  reason      String?
  createdAt   DateTime        @default(now())

  account WalletAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, type, sourceRef])
  @@index([accountId, createdAt])
}

enum WalletAdjustmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The "threshold nobody approves alone" lens's own artifact: an
/// ADJUSTMENT above `SettingKey.WalletAdjustmentApprovalThresholdMinor`
/// is a REQUEST (refusable) until a *different* holder of
/// `finance.wallets.adjust.approve` decides it — only then does a
/// `WalletEntry` get written. Below the threshold, `WalletService
/// .adjustment()` writes the `WalletEntry` directly and this table is
/// never touched — "Request or record" applies per-call, not per-type.
///
/// Reuses the existing generic `ApprovalChain`/`ApprovalStep` engine
/// (`core/approvals`, doc 63's own shape) via `ApprovalSubjectType
/// .WALLET_ADJUSTMENT` — never a bespoke chain, House Rule "no duplicate
/// implementation."
model WalletAdjustmentRequest {
  id                String                        @id @default(cuid())
  accountId         String
  /// Signed: positive credits the account, negative debits it.
  amountMinor       Int
  reason            String
  requestedByUserId String
  status            WalletAdjustmentRequestStatus @default(PENDING)
  /// Set once APPROVED and the resulting WalletEntry is written —
  /// `@unique` is this table's own half of "the second copy of the write":
  /// a retried approve() call finds this already set and no-ops.
  walletEntryId     String?                       @unique
  createdAt         DateTime                      @default(now())
  decidedAt         DateTime?

  account WalletAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
}

enum MerchantPayableStatus {
  OPEN
  SCHEDULED
  PAID
  DISPUTED
}

/// The exact mirror of doc 145's own AP side (`SupplierBill`) — a merchant
/// selling through this platform is, for settlement purposes, a vendor
/// Newax owes money to, never a party whose own money Newax was ever
/// holding (§3). `organizationId` here is NOT this codebase's own
/// `organization.prisma` `Organization` (Newax's own chain/brand tier) —
/// it is the external merchant tenant's own id under doc 39's shared-
/// hosting control plane, hence a plain scalar with no `@relation`,
/// exactly as the doc's own Prisma snippet declares it.
model MerchantPayable {
  id                String                @id @default(cuid())
  organizationId    String
  orderId           String                @unique
  grossMinor        Int
  platformFeeMinor  Int
  netPayableMinor   Int
  status            MerchantPayableStatus @default(OPEN)
  scheduledPayoutAt DateTime?
  paidAt            DateTime?

  /// Set only while DISPUTED — the toxic-pair partner `resolve()` checks
  /// against, the same "never its own approver" shape
  /// `StockVarianceService.resolve()` already uses.
  disputedByUserId String?
  disputeReason    String?
  resolvedByUserId String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

// WO-9.7, docs/implementation/ai-layer/09-ai-layer.md.
//
// The assistant's own conversation log, kept separately from crm.prisma's
// generic Interaction — a WhatsApp exchange is a back-and-forth of
// individually AI-or-human-attributed messages, not a single logged event,
// and `WhatsAppMessage.aiGenerated` is exactly the fact an incident review
// needs first ("did the bot say that, or did a person?"). Every
// conversation still resolves to a Contact (crm.prisma) — see that model's
// own `whatsAppConversations` relation — so it shows up on the customer's
// own timeline alongside everything else, never as an island.

/// Set once identity is verified (the inbound phone number matches this
/// Contact's own phoneE164 — WhatsAppAssistantService's own non-negotiable,
/// never relaxed) and cleared to true the moment any message in it needs a
/// human: a complaint, a refund amount, a payment problem, or the customer
/// asking outright. The assistant never replies again in a handed-off
/// conversation; only a staff reply (through the existing CRM inbox
/// pattern) does.
model WhatsAppConversation {
  id               String    @id @default(cuid())
  contactId        String
  phoneE164        String
  startedAt        DateTime  @default(now())
  lastMessageAt    DateTime  @default(now())
  handedOffToHuman Boolean   @default(false)
  handoffReason    String?
  handedOffAt      DateTime?

  contact  Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@index([contactId, lastMessageAt])
  @@index([phoneE164])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  conversationId    String
  direction         WhatsAppMessageDirection
  body              String
  /// True only for an OUTBOUND message the AiProvider actually generated —
  /// false for the handoff notice, an AUTO_CONFIRM/CONFIRMATION_CALL system
  /// reply, or anything a staff member typed.
  aiGenerated       Boolean                  @default(false)
  /// The gateway's own id for this INBOUND message (WhatsApp Cloud API's
  /// `messages[].id`, or whichever id the configured gateway assigns) —
  /// makes a redelivered webhook a no-op instead of a duplicate log entry,
  /// same idiom as InboundEmail's own (emailAccountId, messageId) key. Null
  /// for every OUTBOUND message this shop sends, which has no such id.
  externalMessageId String?                  @unique
  createdAt         DateTime                 @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Phase 7 WO-7.6 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// Replaces the browser-only `localStorage` wishlist
// (`apps/web/src/lib/wishlist.ts`), which was tied to one browser, invisible
// to staff, and could not drive a back-in-stock alert. The API migrates
// whatever is in the browser on first sign-in (`POST /wishlist/migrate`) so a
// customer never silently loses what they saved.

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  /// Set when the customer saved a specific size/colour, not just the product.
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId, createdAt])
  @@index([productId])
}

/// One row per customer waiting on one variant. A subscriber on
/// `DomainEvent.StockReplenished` (Phase 1's stock ledger) checks whether the
/// variant's total stock just crossed 0 → positive, notifies everyone
/// waiting, and deletes the requests — deleting on send is what makes a
/// flapping stock level (0 → 1 → 0 → 1) notify once per request rather than
/// repeatedly, since a re-request after the first alert creates a fresh row.
model BackInStockRequest {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
}

